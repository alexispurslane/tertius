#!/usr/bin/env bash
# Runs before every push that pushes code (see tools/README.md, "Git hooks"):
#   1. tools/cleanup.sh fixes and formats the C# files that the pushed commits change: Roslyn's fixes, then CSharpier. If
#      it changes a file, the hook builds the solution, commits the result as one cleanup commit and stops the push,
#      because git already chose the commits to push. Cleaned code that does not build stops the push, and the changes
#      stay uncommitted. Push again to send the cleanup commit too.
#   2. tools/docs.sh builds the docs site. A DocFX error stops the push, and a link warning does not.
#   3. The slop history (tools/Tertius.Slop): it notes each pushed commit that changes C# code under src and has no
#      note, and the pushed tip, prints the metrics at the last push against now, and pushes refs/notes/slop to the
#      same remote after a merge with the remote's notes. It never stops the push.
# To skip the hook once, run: git push --no-verify
set -euo pipefail

root=$(git rev-parse --show-toplevel)
cd "$root"

# Git sends one line per pushed ref on stdin: <local ref> <local sha> <remote ref> <remote sha>. The dev shell does not
# keep stdin, so the hook passes the lines on in a variable.
zero=0000000000000000000000000000000000000000
if [[ -z "${TERTIUS_PUSH_REFS+set}" ]]; then
    TERTIUS_PUSH_REFS=$(cat)
    export TERTIUS_PUSH_REFS
fi
pushes_code=false
while read -r _ local_sha _ _; do
    [[ -n "$local_sha" && "$local_sha" != "$zero" ]] && pushes_code=true
done <<< "$TERTIUS_PUSH_REFS"
$pushes_code || exit 0

if [[ -z "${IN_NIX_SHELL:-}" ]]; then
    exec nix develop --command bash "$0" "$@" < /dev/null
fi

head=$(git rev-parse HEAD)
files=()
while read -r local_ref local_sha _ remote_sha; do
    [[ -z "$local_sha" || "$local_sha" == "$zero" ]] && continue
    # The hook can add a cleanup commit only to the branch that is checked out.
    if [[ "$local_sha" != "$head" ]]; then
        echo "pre-push: $local_ref is not checked out, so the cleanup skips it." >&2
        continue
    fi
    # The pushed commits are the ones after the remote's commit, or after main for a new branch.
    if [[ "$remote_sha" != "$zero" ]] && git cat-file -e "$remote_sha^{commit}" 2> /dev/null; then
        base=$remote_sha
    else
        base=$(git merge-base "$local_sha" main)
    fi
    while IFS= read -r f; do files+=("$f"); done < <(git diff --name-only --diff-filter=ACMR "$base" "$local_sha" -- '*.cs')
done <<< "$TERTIUS_PUSH_REFS"

if [[ ${#files[@]} -gt 0 ]]; then
    dirty=$(git status --porcelain -- "${files[@]}")
    if [[ -n "$dirty" ]]; then
        echo "pre-push: these files have uncommitted changes, and the cleanup would mix them into its commit:" >&2
        echo "$dirty" | sed 's/^/  /' >&2
        echo "pre-push: commit or stash them, then push again." >&2
        exit 1
    fi
    echo "pre-push: cleaning up ${#files[@]} C# file(s)..." >&2
    if ! bash tools/cleanup.sh "${files[@]}"; then
        echo "pre-push: the cleanup failed, so the push stopped." >&2
        exit 1
    fi
    if ! git diff --quiet -- "${files[@]}"; then
        log="${TMPDIR:-/tmp}/tertius-pre-push-build.log"
        if ! dotnet build Tertius.slnx -c Checked -v quiet -nologo -clp:ErrorsOnly > "$log" 2>&1; then
            grep -E ': error ' "$log" | sort -u | head -40 >&2
            echo "pre-push: the cleaned code does not build, so the push stopped. The changes stay uncommitted." >&2
            exit 1
        fi
        git add -- "${files[@]}"
        git commit --no-verify --quiet -m "Clean up code before push" \
            -m "tools/cleanup.sh (Roslyn fixes, then CSharpier) ran in the pre-push hook."
        count=$(git diff --name-only HEAD~1 HEAD | wc -l | tr -d ' ')
        echo "pre-push: the cleanup changed $count file(s) and committed them as $(git rev-parse --short HEAD)." >&2
        echo "pre-push: the push stopped, because it does not hold that commit. Push again." >&2
        exit 1
    fi
fi

echo "pre-push: building the docs site..." >&2
log="${TMPDIR:-/tmp}/tertius-pre-push-docs.log"
if ! bash tools/docs.sh > "$log" 2>&1; then
    tail -40 "$log" >&2
    echo "pre-push: the docs build failed, so the push stopped. The full log: $log" >&2
    exit 1
fi

# The slop history. The commits of a branch since its last push are the ones after the remote's commit, or after main
# for a new branch. The docs build above built the solution in Release, so the tool is current.
slop_history() {
    local remote=$1 slop=tools/Tertius.Slop/bin/Release/net11.0/Tertius.Slop.dll
    [[ -f "$slop" ]] || dotnet build tools/Tertius.Slop -c Release -v quiet -nologo > /dev/null || return 1
    local local_ref local_sha remote_sha from
    while read -r local_ref local_sha _ remote_sha; do
        [[ "$local_ref" == refs/heads/* && -n "$local_sha" && "$local_sha" != "$zero" ]] || continue
        if [[ "$remote_sha" != "$zero" ]] && git cat-file -e "$remote_sha^{commit}" 2> /dev/null; then
            from=$remote_sha
        else
            from=$(git merge-base "$local_sha" main)
        fi
        [[ "$from" == "$local_sha" ]] && continue
        echo "pre-push: measuring the pushed commits of ${local_ref#refs/heads/} that have no slop note..." >&2
        dotnet "$slop" note "$from" "$local_sha" --branch "${local_ref#refs/heads/}" --source pre-push > /dev/null \
            || echo "pre-push: the slop notes of ${local_ref#refs/heads/} failed." >&2
        dotnet "$slop" summary "$from" "$local_sha" | sed 's/^/pre-push: /' >&2
    done <<< "$TERTIUS_PUSH_REFS"

    # Another clone can have pushed notes that this one lacks. Their union keeps both: a commit with two notes gets
    # their lines in sorted order, and a reader takes the first line.
    if git fetch -q "$remote" "+refs/notes/slop:refs/notes/slop-remote" 2> /dev/null; then
        git notes --ref=refs/notes/slop merge -q -s cat_sort_uniq refs/notes/slop-remote ||
            echo "pre-push: the merge of the remote's slop notes failed." >&2
    fi
    if git rev-parse -q --verify refs/notes/slop > /dev/null; then
        git push -q --no-verify "$remote" refs/notes/slop ||
            echo "pre-push: the push of refs/notes/slop failed, so the next push tries again." >&2
    fi
}
slop_history "${1:-origin}" || echo "pre-push: the slop history failed. The push goes on." >&2
