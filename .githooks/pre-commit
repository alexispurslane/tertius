#!/usr/bin/env bash
# Runs on every commit that stages C# files or projects (see tools/README.md, "Git hooks"):
#   1. An incremental build of the projects that the commit changes and of the test projects that test them. The
#      build runs every analyzer, and an error stops the commit. The hook leaves out a project whose last successful
#      Checked build was of exactly the staged code, as the stamp next to its output says (tools/code-tree.sh).
#   2. The tests of the changed code, in Checked (Debug's contracts with Release's optimized code): every test of a
#      changed module, and the test classes of a changed test file. A failed test stops the commit. The hook skips the
#      tests of a test project when a full Checked run of that project passed on exactly the staged code, as the test
#      record in the git folder says (tools/code-tree.sh, tools/Tertius.TestRecord).
#   3. The slop metrics of the staged tree (tools/Tertius.Slop measure), in parallel with the tests. After the tests
#      pass, it leaves the note in the pending file slop-pending of the worktree's git folder, and the post-commit hook
#      attaches it to the new commit under refs/notes/slop. The metrics never stop the commit.
#   4. After the metrics end, a report of what the staged changes touch (tools/commit_report.py): the long methods, and
#      the erosion and the verbosity, each with its change against the nearest noted commit up to HEAD and the touched
#      code that raises it. A failed measure leaves the erosion and the verbosity out, and a failed test prints the
#      report of the long methods only, before the commit stops. The report never stops the commit.
# The pre-push hook formats and modernizes the code, so this hook changes no file in the working tree.
# To skip the hook once, run: git commit --no-verify
set -euo pipefail

root=$(git rev-parse --show-toplevel)
cd "$root"

files=()
while IFS= read -r f; do files+=("$f"); done < <(git diff --cached --name-only --diff-filter=ACMR -- '*.cs' '*.csproj')
if [[ ${#files[@]} -eq 0 ]]; then
    exit 0
fi

# The hook needs the dev shell's SDK, jscpd and native libraries. Outside the dev shell, it runs itself again inside it.
if [[ -z "${IN_NIX_SHELL:-}" ]]; then
    exec nix develop --command bash "$0" "$@"
fi

partial=$(git diff --name-only -- "${files[@]}")
if [[ -n "$partial" ]]; then
    echo "pre-commit: these files also have unstaged changes, and the build and the tests see them too:" >&2
    echo "$partial" | sed 's/^/  /' >&2
fi

project_of() {
    local dir
    dir=$(dirname "$1")
    while [[ "$dir" != "." && "$dir" != "/" ]]; do
        for p in "$dir"/*.csproj; do
            [[ -f "$p" ]] && { echo "$p"; return; }
        done
        dir=$(dirname "$dir")
    done
}

# What to build and what to test. A change in src/Tertius.X runs every test in tests/Tertius.X.Tests. The tests of
# src/Tertius.Demo live in tests/Tertius.Host.Tests, the tests of analyzers/Tertius.X in tests/Tertius.X.Tests,
# and the tests of tools/Tertius.Slop in tests/Tertius.Slop.Tests. A change in a test file runs only the test classes in that file,
# unless its module already runs whole. tests/Tertius.Testing and the benchmarks only build: every module uses the
# shared helpers, so a change there waits for the full run of tools/test-all.sh before the merge.
declare -A build=() whole=() classes=() run_seen=()
for f in "${files[@]}"; do
    p=$(project_of "$f")
    [[ -z "$p" ]] && continue
    build["$p"]=1
    name=$(basename "$p" .csproj)
    case "$p" in
        src/* | analyzers/* | tools/*)
            module=${name#Tertius.}
            [[ "$module" == Demo ]] && module=Host
            tests="tests/Tertius.$module.Tests/Tertius.$module.Tests.csproj"
            if [[ -f "$tests" ]]; then
                whole["$tests"]=1
                build["$tests"]=1
            fi
            ;;
        tests/*.Tests/*)
            [[ "$f" == *.cs ]] || { whole["$p"]=1; continue; }
            namespace=$(sed -nE 's/^namespace ([A-Za-z0-9_.]+);.*/\1/p' "$f" | head -1)
            while IFS= read -r class; do
                classes["$p"]+=" ${namespace:+$namespace.}$class"
            done < <(sed -nE 's/^(public |internal )?(sealed |static |abstract |partial )*class ([A-Za-z0-9_]+).*/\3/p' "$f")
            ;;
    esac
done

# The slop tool measures the staged tree after the build, so the build always holds it. An up-to-date project costs
# the build almost nothing.
build["tools/Tertius.Slop/Tertius.Slop.csproj"]=1

# The code hash of the staged tree, which the build stamps and the test records hold. The script prints the hash, then
# the git folder. A pipe to head would stop the script early, and pipefail would stop the hook, so the hook splits the
# whole output.
code_tree=$(bash tools/code-tree.sh --staged)
staged_code=${code_tree%%$'\n'*}
git_dir=${code_tree#*$'\n'}

# A project whose last successful Checked build was of the staged code needs no build: its binaries, and the analyzer
# results that the report reads, already describe the commit.
built() {
    local stamp
    for stamp in "$(dirname "$1")"/bin/Checked/*/code-tree.txt; do
        [[ -f "$stamp" && "$(head -c 40 "$stamp")" == "$staged_code" ]] && return 0
    done
    return 1
}
unbuilt=()
for p in "${!build[@]}"; do built "$p" || unbuilt+=("$p"); done

solution=.pre-commit.slnx
slop_pid=
slop_details=$(mktemp "${TMPDIR:-/tmp}/tertius-pre-commit-slop-details.XXXXXX")
trap 'rm -f "$root/$solution" "$slop_details"; [[ -n "$slop_pid" ]] && kill "$slop_pid" 2> /dev/null; true' EXIT
if [[ ${#unbuilt[@]} -eq 0 ]]; then
    echo "pre-commit: skipping the build: all ${#build[@]} project(s) were built from the staged code" >&2
else
    {
        echo "<Solution>"
        echo "  <Configurations><BuildType Name=\"Checked\" /></Configurations>"
        for p in "${unbuilt[@]}"; do echo "  <Project Path=\"$p\" />"; done
        echo "</Solution>"
    } > "$solution"
    echo "pre-commit: building ${#unbuilt[@]} of ${#build[@]} project(s)..." >&2
    log="${TMPDIR:-/tmp}/tertius-pre-commit-build.log"
    if ! dotnet build "$solution" -c Checked -v quiet -nologo -clp:ErrorsOnly > "$log" 2>&1; then
        grep -E ': error ' "$log" | sort -u | head -40 >&2
        echo "pre-commit: the build failed, so the commit stopped. The full log: $log" >&2
        exit 1
    fi
fi

# The slop metrics of the staged tree, which the commit will hold, measured from a copy of the tree. A pending file from
# a commit that stopped after this hook is stale, so it goes first.
slop_pending="$(git rev-parse --absolute-git-dir)/slop-pending"
rm -f "$slop_pending"
slop_tree=$(git write-tree)
slop_out=$(mktemp "${TMPDIR:-/tmp}/tertius-pre-commit-slop.XXXXXX")
# The report compares the metrics with the nearest noted commit up to HEAD. A first commit has no HEAD to compare with.
slop_parent=()
if git rev-parse --verify --quiet HEAD > /dev/null; then slop_parent=(--parent HEAD); fi
dotnet tools/Tertius.Slop/bin/Checked/net11.0/Tertius.Slop.dll measure "$slop_tree" \
    --branch "$(git branch --show-current)" --source pre-commit --details "$slop_details" \
    ${slop_parent[@]+"${slop_parent[@]}"} > "$slop_out" 2>&1 &
slop_pid=$!

# Leaves the measured note for the post-commit hook: the tree on the first line, the note on the second. Then prints
# the commit report, with the erosion and the verbosity when the measure succeeded.
finish_slop() {
    local code=0 slop=()
    wait "$slop_pid" || code=$?
    slop_pid=
    if [[ $code -eq 0 ]]; then
        printf '%s\n%s\n' "$slop_tree" "$(tail -1 "$slop_out")" > "$slop_pending.tmp"
        mv "$slop_pending.tmp" "$slop_pending"
        slop=(--slop "$slop_details")
    else
        echo "pre-commit: the slop metrics failed, so this commit gets its note at the next push:" >&2
        tail -5 "$slop_out" | sed 's/^/  /' >&2
    fi
    rm -f "$slop_out"
    python3 tools/commit_report.py ${slop[@]+"${slop[@]}"} >&2 || true
}

# A test project whose full Checked run passed on the staged code needs no run here. Its record holds the code hash
# of the build that the run tested.
tested() {
    local record="$git_dir/tertius-tested/Checked/$(basename "$1" .csproj)"
    [[ -f "$record" && "$(cat "$record")" == "$staged_code" ]]
}

# The test runs go in parallel, one process per test project, each with its own log.
runs=()
# A project can be in both lists. The whole run comes first and covers its classes.
for p in "${!whole[@]}" "${!classes[@]}"; do
    [[ -n "${run_seen[$p]:-}" ]] && continue
    run_seen[$p]=1
    if tested "$p"; then
        echo "pre-commit: skipping $(basename "$p" .csproj): a full Checked run passed on the staged code" >&2
        continue
    fi
    if [[ -n "${whole[$p]:-}" ]]; then runs+=("$p|"); else runs+=("$p|${classes[$p]}"); fi
done
if [[ ${#runs[@]} -eq 0 ]]; then
    finish_slop
    exit 0
fi

logs=$(mktemp -d "${TMPDIR:-/tmp}/tertius-pre-commit-tests.XXXXXX")
pids=()
for run in "${runs[@]}"; do
    p=${run%%|*}
    filter=()
    for class in ${run#*|}; do filter+=(--filter-class "$class"); done
    name=$(basename "$p" .csproj)
    if [[ ${#filter[@]} -gt 0 ]]; then
        echo "pre-commit: testing $((${#filter[@]} / 2)) class(es) in $name..." >&2
    else
        echo "pre-commit: testing all of $name..." >&2
    fi
    dotnet test --project "$p" -c Checked --no-build ${filter[@]+"${filter[@]}"} > "$logs/$name.log" 2>&1 &
    pids+=("$!:$name")
done
status=0
for entry in "${pids[@]}"; do
    pid=${entry%%:*} name=${entry#*:}
    code=0
    wait "$pid" || code=$?
    summary=$(grep -E '^  (total|failed|succeeded|skipped): ' "$logs/$name.log" | tr -s ' ' | tr '\n' ',' | sed 's/,$//')
    # Exit code 8 means that no test matched the filter, for example a file with only helper classes.
    if [[ $code -eq 0 || $code -eq 8 ]]; then
        echo "pre-commit: $name:${summary:- no tests ran}" >&2
    else
        status=1
        echo "pre-commit: $name FAILED (exit code $code):$summary" >&2
        grep -E '^(failed|error) ' "$logs/$name.log" | head -20 >&2 || true
        echo "  full log: $logs/$name.log" >&2
    fi
done
if [[ $status -ne 0 ]]; then
    # The report of the long methods needs only the build, so it prints without waiting for the metrics.
    python3 tools/commit_report.py >&2 || true
    echo "pre-commit: a test failed, so the commit stopped." >&2
    exit 1
fi
rm -rf "$logs"
finish_slop
