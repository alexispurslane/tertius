<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The step laps of the sync point (SyncProfile) compile in only when a build sets the property SyncProfile=true, for
    example dotnet run -c Release -p:SyncProfile=true in benchmarks/Tertius.Benchmarks. A normal build compiles them away.
  -->
  <PropertyGroup Condition="'$(SyncProfile)' == 'true'">
    <DefineConstants>$(DefineConstants);SYNC_PROFILE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Tertius.Core/Tertius.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Tertius.Simulation.Tests" />
    <InternalsVisibleTo Include="Tertius.Benchmarks" />
    <!-- The tests of numeric frames make and move them through the World's internal operations. -->
    <InternalsVisibleTo Include="Tertius.Physics.Tests" />
    <InternalsVisibleTo Include="Tertius.Host.Tests" />
  </ItemGroup>
</Project>
