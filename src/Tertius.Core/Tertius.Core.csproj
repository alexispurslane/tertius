<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Tertius</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Tertius.Core.Tests" />
    <!-- The setters of FrameTree, such as SetHullMotion, are for the simulation alone, which keeps a frame's owner in step
         with the frame. The physics tests stand in for the simulation. -->
    <InternalsVisibleTo Include="Tertius.Simulation" />
    <InternalsVisibleTo Include="Tertius.Physics.Tests" />
    <!-- The tree-level members of FrameTree (dense order, counts) are internal, because they show numeric frames. -->
    <InternalsVisibleTo Include="Tertius.Simulation.Tests" />
    <!-- Numeric frames are hidden from the public tree. Physics reads the tree as it is stored (FrameTree.TreeParent). -->
    <InternalsVisibleTo Include="Tertius.Physics" />
    <!-- The state dump tests make a numeric frame, whose mode is internal. -->
    <InternalsVisibleTo Include="Tertius.Host.Tests" />
    <!-- The fault-injecting backend copies every PhysicsChanges batch that it applies, the internal lists included. -->
    <InternalsVisibleTo Include="Tertius.Testing" />
    <!-- The benchmark of the numeric update drives FrameTree.UpdateNumericFrames directly, without physics. -->
    <InternalsVisibleTo Include="Tertius.Benchmarks" />
  </ItemGroup>
</Project>
