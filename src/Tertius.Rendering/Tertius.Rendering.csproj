<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- glslc comes from shaderc in the Nix dev shell. Override with -p:Glslc=/path/to/glslc. -->
    <Glslc Condition="'$(Glslc)' == ''">glslc</Glslc>
    <!-- glslang and spirv-val come from the dev shell too. They build AMD's FSR 3.1 passes (ThirdParty/Fsr3/README.md). -->
    <Glslang Condition="'$(Glslang)' == ''">glslangValidator</Glslang>
    <SpirvVal Condition="'$(SpirvVal)' == ''">spirv-val</SpirvVal>
    <Fsr3Root>$(MSBuildProjectDirectory)/ThirdParty/Fsr3/sdk/include/FidelityFX/gpu</Fsr3Root>
    <!-- The portable build: 32-bit floats, SPD without wave operations, the reference Lanczos, and the engine's inputs
         (HDR color, render-size motion vectors without jitter, reversed depth), without sharpening. -->
    <Fsr3Defines>-DFFX_GPU=1 -DFFX_GLSL=1 -DFFX_HALF=0 -DFFX_SPD_NO_WAVE_OPERATIONS=1 -DFFX_FSR3UPSCALER_OPTION_UPSAMPLE_SAMPLERS_USE_DATA_HALF=0 -DFFX_FSR3UPSCALER_OPTION_ACCUMULATE_SAMPLERS_USE_DATA_HALF=0 -DFFX_FSR3UPSCALER_OPTION_REPROJECT_SAMPLERS_USE_DATA_HALF=1 -DFFX_FSR3UPSCALER_OPTION_POSTPROCESSLOCKSTATUS_SAMPLERS_USE_DATA_HALF=0 -DFFX_FSR3UPSCALER_OPTION_UPSAMPLE_USE_LANCZOS_TYPE=2 -DFFX_FSR3UPSCALER_OPTION_REPROJECT_USE_LANCZOS_TYPE=0 -DFFX_FSR3UPSCALER_OPTION_HDR_COLOR_INPUT=1 -DFFX_FSR3UPSCALER_OPTION_LOW_RESOLUTION_MOTION_VECTORS=1 -DFFX_FSR3UPSCALER_OPTION_JITTERED_MOTION_VECTORS=0 -DFFX_FSR3UPSCALER_OPTION_INVERTED_DEPTH=1 -DFFX_FSR3UPSCALER_OPTION_APPLY_SHARPENING=0</Fsr3Defines>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Tertius.Core/Tertius.Core.csproj" />
    <PackageReference Include="Silk.NET.Vulkan" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.KHR" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.EXT" />
    <PackageReference Include="Silk.NET.Windowing" />
    <PackageReference Include="StbImageWriteSharp" />
    <PackageReference Include="StbImageSharp" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Tertius.Rendering.Tests" />
    <InternalsVisibleTo Include="Tertius.ReflectionReference" />
    <InternalsVisibleTo Include="Tertius.Benchmarks" />
    <InternalsVisibleTo Include="Tertius.Host.Tests" />
    <InternalsVisibleTo Include="Tertius.LtcFit" />
  </ItemGroup>
  <!-- The LTC table of the rectangle lights, which tools/Tertius.LtcFit fits to our GGX lobe (tools/README.md, "The LTC
       table"). -->
  <ItemGroup>
    <EmbeddedResource Include="Shading/LtcTable.bin" LogicalName="Tertius.Rendering.LtcTable.bin" WithCulture="false" />
  </ItemGroup>
  <!-- The reflection rays' blue-noise mask, a build output of native/stbn.c that the dev shell names
       (native/stbn-mask.nix). -->
  <ItemGroup>
    <EmbeddedResource Include="$(TERTIUS_STBN_MASK)" LogicalName="Tertius.Rendering.BlueNoiseMask.bin" WithCulture="false" />
  </ItemGroup>
  <Target Name="RequireBlueNoiseMask" BeforeTargets="BeforeBuild">
    <Error Condition="'$(TERTIUS_STBN_MASK)' == '' Or !Exists('$(TERTIUS_STBN_MASK)')"
           Text="TERTIUS_STBN_MASK names no file. Build in the dev shell, which builds the mask (native/stbn-mask.nix)." />
  </Target>

  <!-- GLSL 4.60 shaders. Each stage file becomes one SPIR-V module, embedded as Tertius.Rendering.Shaders.<file>.spv.
       Files ending in .glsl are includes. A change to any include recompiles every stage. -->
  <ItemGroup>
    <GlslShader Include="Shaders/*.vert;Shaders/*.frag;Shaders/*.comp" />
    <PreciseHistoryShader Include="Shaders/accumulate_temporal.comp;Shaders/accumulate_spatial.comp;Shaders/screen_trace_*.comp;Shaders/composite.frag;Shaders/composite_scatter.frag" />
    <LightAgeDiagnosticShader Include="Shaders/accumulate_temporal.comp;Shaders/screen_trace_*.comp" />
    <AccumulationTraceShader Include="Shaders/accumulate_temporal.comp;Shaders/accumulate_spatial.comp" />
    <!-- HistoryInstrumentationSelection lists the shaders of the two items above, and ShaderVariantTests checks the
         list against the embedded shaders. -->
    <!-- The light-age variant (ticket ter-wkvw): the diffuse signal's spatial dispatch beside a precise specular history,
         which keeps its half-precision history and acts on its blocks' evidence. The temporal dispatch reads no light
         age. ShaderVariant.LightAge lists it. TERTIUS_LIGHT_AGE marks every build whose dispatches read the light age:
         this variant and every variant of a precise history. -->
    <LightAgeShader Include="Shaders/accumulate_spatial.comp" />
    <GlslInclude Include="Shaders/*.glsl" />
    <None Include="@(GlslShader);@(GlslInclude)" />
  </ItemGroup>


  <!-- AMD's FSR 3.1.4 passes that the engine dispatches, compiled by glslang with the portable defines and checked by
       spirv-val, embedded as Tertius.Rendering.Shaders.<file>.spv. The sharpening and debug passes stay out. -->
  <ItemGroup>
    <Fsr3Shader Include="ThirdParty/Fsr3/sdk/src/backends/vk/shaders/fsr3upscaler/*.glsl"
                Exclude="ThirdParty/Fsr3/sdk/src/backends/vk/shaders/fsr3upscaler/ffx_fsr3upscaler_rcas_pass.glsl;ThirdParty/Fsr3/sdk/src/backends/vk/shaders/fsr3upscaler/ffx_fsr3upscaler_debug_view_pass.glsl" />
    <Fsr3Shader Include="Shaders/fsr_rcas.glsl" />
    <Fsr3Include Include="ThirdParty/Fsr3/sdk/include/FidelityFX/gpu/**/*.h" />
    <None Include="@(Fsr3Shader);@(Fsr3Include)" />
  </ItemGroup>

  <Target Name="CompileFsr3Shaders" BeforeTargets="BeforeBuild"
          Inputs="@(Fsr3Shader);@(Fsr3Include);$(MSBuildProjectFullPath)"
          Outputs="@(Fsr3Shader->'$(IntermediateOutputPath)shaders/%(Filename)%(Extension).spv')">
    <MakeDir Directories="$(IntermediateOutputPath)shaders" />
    <Exec Command="&quot;$(Glslang)&quot; -V --target-env vulkan1.3 -S comp -Os $(Fsr3Defines) -I&quot;$(Fsr3Root)&quot; -I&quot;$(Fsr3Root)/fsr3upscaler&quot; -o &quot;$(IntermediateOutputPath)shaders/%(Fsr3Shader.Filename)%(Fsr3Shader.Extension).spv&quot; &quot;%(Fsr3Shader.FullPath)&quot;" />
    <Exec Command="&quot;$(SpirvVal)&quot; --target-env vulkan1.3 &quot;$(IntermediateOutputPath)shaders/%(Fsr3Shader.Filename)%(Fsr3Shader.Extension).spv&quot;" />
  </Target>

  <Target Name="EmbedFsr3Shaders" DependsOnTargets="CompileFsr3Shaders" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <_Fsr3Spirv Include="@(Fsr3Shader->'$(IntermediateOutputPath)shaders/%(Filename)%(Extension).spv')" />
      <EmbeddedResource Include="@(_Fsr3Spirv)" LogicalName="Tertius.Rendering.Shaders.%(_Fsr3Spirv.Filename)%(_Fsr3Spirv.Extension)" WithCulture="false" />
    </ItemGroup>
  </Target>

  <Target Name="CompileGlslShaders" BeforeTargets="BeforeBuild"
          Inputs="@(GlslShader);@(GlslInclude);$(MSBuildProjectFullPath)"
          Outputs="@(GlslShader->'$(IntermediateOutputPath)shaders/%(Filename)%(Extension).spv')">
    <MakeDir Directories="$(IntermediateOutputPath)shaders" />
    <Exec Command="&quot;$(Glslc)&quot; --target-env=vulkan1.3 -O -Werror -I &quot;$(MSBuildProjectDirectory)/Shaders&quot; -o &quot;$(IntermediateOutputPath)shaders/%(GlslShader.Filename)%(GlslShader.Extension).spv&quot; &quot;%(GlslShader.FullPath)&quot;" />
  </Target>

  <Target Name="EmbedGlslShaders" DependsOnTargets="CompileGlslShaders" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <_GlslSpirv Include="@(GlslShader->'$(IntermediateOutputPath)shaders/%(Filename)%(Extension).spv')" />
      <EmbeddedResource Include="@(_GlslSpirv)" LogicalName="Tertius.Rendering.Shaders.%(_GlslSpirv.Filename)%(_GlslSpirv.Extension)" WithCulture="false" />
    </ItemGroup>
  </Target>

  <Target Name="CompilePreciseHistoryShaders" BeforeTargets="BeforeBuild"
          Inputs="@(PreciseHistoryShader);@(GlslInclude);$(MSBuildProjectFullPath)"
          Outputs="@(PreciseHistoryShader->'$(IntermediateOutputPath)shaders/%(Filename)_precise%(Extension).spv')">
    <MakeDir Directories="$(IntermediateOutputPath)shaders" />
    <Exec Command="&quot;$(Glslc)&quot; --target-env=vulkan1.3 -O -Werror -DTERTIUS_PRECISE_SPECULAR_HISTORY -DTERTIUS_LIGHT_AGE -I &quot;$(MSBuildProjectDirectory)/Shaders&quot; -o &quot;$(IntermediateOutputPath)shaders/%(PreciseHistoryShader.Filename)_precise%(PreciseHistoryShader.Extension).spv&quot; &quot;%(PreciseHistoryShader.FullPath)&quot;" />
  </Target>

  <Target Name="EmbedPreciseHistoryShaders" DependsOnTargets="CompilePreciseHistoryShaders" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <_PreciseHistorySpirv Include="@(PreciseHistoryShader->'$(IntermediateOutputPath)shaders/%(Filename)_precise%(Extension).spv')" />
      <EmbeddedResource Include="@(_PreciseHistorySpirv)" LogicalName="Tertius.Rendering.Shaders.%(_PreciseHistorySpirv.Filename)%(_PreciseHistorySpirv.Extension)" WithCulture="false" />
    </ItemGroup>
  </Target>
  <!-- The precise variants of the tracer and of the temporal dispatch with the diagnostic of uncovered surfaces, which
       only the capture tool and the tests read. They render exactly as the precise variants, which always keep the
       light-change age (ticket tiunr-7haj). -->
  <Target Name="CompileLightAgeDiagnosticShaders" BeforeTargets="BeforeBuild"
          Inputs="@(LightAgeDiagnosticShader);@(GlslInclude);$(MSBuildProjectFullPath)"
          Outputs="@(LightAgeDiagnosticShader->'$(IntermediateOutputPath)shaders/%(Filename)_lightagediag_precise%(Extension).spv')">
    <MakeDir Directories="$(IntermediateOutputPath)shaders" />
    <Exec Command="&quot;$(Glslc)&quot; --target-env=vulkan1.3 -O -Werror -DTERTIUS_PRECISE_SPECULAR_HISTORY -DTERTIUS_LIGHT_AGE -DTERTIUS_LIGHT_AGE_DIAGNOSTIC -I &quot;$(MSBuildProjectDirectory)/Shaders&quot; -o &quot;$(IntermediateOutputPath)shaders/%(LightAgeDiagnosticShader.Filename)_lightagediag_precise%(LightAgeDiagnosticShader.Extension).spv&quot; &quot;%(LightAgeDiagnosticShader.FullPath)&quot;" />
  </Target>

  <Target Name="EmbedLightAgeDiagnosticShaders" DependsOnTargets="CompileLightAgeDiagnosticShaders" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <_LightAgeDiagnosticSpirv Include="@(LightAgeDiagnosticShader->'$(IntermediateOutputPath)shaders/%(Filename)_lightagediag_precise%(Extension).spv')" />
      <EmbeddedResource Include="@(_LightAgeDiagnosticSpirv)" LogicalName="Tertius.Rendering.Shaders.%(_LightAgeDiagnosticSpirv.Filename)%(_LightAgeDiagnosticSpirv.Extension)" WithCulture="false" />
    </ItemGroup>
  </Target>
  <!-- The accumulation trace (ticket tiunr-4b2g): the precise variants of both dispatches that also write what each
       stage did to the specular history, which only the capture tool and the tests read. It renders exactly as the
       precise variants, the light-change age included. -->
  <Target Name="CompileAccumulationTraceShaders" BeforeTargets="BeforeBuild"
          Inputs="@(AccumulationTraceShader);@(GlslInclude);$(MSBuildProjectFullPath)"
          Outputs="@(AccumulationTraceShader->'$(IntermediateOutputPath)shaders/%(Filename)_trace_precise%(Extension).spv')">
    <MakeDir Directories="$(IntermediateOutputPath)shaders" />
    <Exec Command="&quot;$(Glslc)&quot; --target-env=vulkan1.3 -O -Werror -DTERTIUS_PRECISE_SPECULAR_HISTORY -DTERTIUS_LIGHT_AGE -DTERTIUS_ACCUMULATION_TRACE -I &quot;$(MSBuildProjectDirectory)/Shaders&quot; -o &quot;$(IntermediateOutputPath)shaders/%(AccumulationTraceShader.Filename)_trace_precise%(AccumulationTraceShader.Extension).spv&quot; &quot;%(AccumulationTraceShader.FullPath)&quot;" />
  </Target>

  <Target Name="EmbedAccumulationTraceShaders" DependsOnTargets="CompileAccumulationTraceShaders" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <_AccumulationTraceSpirv Include="@(AccumulationTraceShader->'$(IntermediateOutputPath)shaders/%(Filename)_trace_precise%(Extension).spv')" />
      <EmbeddedResource Include="@(_AccumulationTraceSpirv)" LogicalName="Tertius.Rendering.Shaders.%(_AccumulationTraceSpirv.Filename)%(_AccumulationTraceSpirv.Extension)" WithCulture="false" />
    </ItemGroup>
  </Target>
  <Target Name="CompileLightAgeShaders" BeforeTargets="BeforeBuild"
          Inputs="@(LightAgeShader);@(GlslInclude);$(MSBuildProjectFullPath)"
          Outputs="@(LightAgeShader->'$(IntermediateOutputPath)shaders/%(Filename)_lightage%(Extension).spv')">
    <MakeDir Directories="$(IntermediateOutputPath)shaders" />
    <Exec Command="&quot;$(Glslc)&quot; --target-env=vulkan1.3 -O -Werror -DTERTIUS_LIGHT_AGE -I &quot;$(MSBuildProjectDirectory)/Shaders&quot; -o &quot;$(IntermediateOutputPath)shaders/%(LightAgeShader.Filename)_lightage%(LightAgeShader.Extension).spv&quot; &quot;%(LightAgeShader.FullPath)&quot;" />
  </Target>

  <Target Name="EmbedLightAgeShaders" DependsOnTargets="CompileLightAgeShaders" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <_LightAgeSpirv Include="@(LightAgeShader->'$(IntermediateOutputPath)shaders/%(Filename)_lightage%(Extension).spv')" />
      <EmbeddedResource Include="@(_LightAgeSpirv)" LogicalName="Tertius.Rendering.Shaders.%(_LightAgeSpirv.Filename)%(_LightAgeSpirv.Extension)" WithCulture="false" />
    </ItemGroup>
  </Target>
  <Target Name="EmbedHistorySourceIdentity" BeforeTargets="BeforeBuild">
    <GetFileHash Files="@(Compile);@(GlslShader);@(GlslInclude);$(MSBuildProjectFullPath)">
      <Output TaskParameter="Items" ItemName="_HistorySources" />
    </GetFileHash>
    <WriteLinesToFile File="$(IntermediateOutputPath)history-sources.sha256" Lines="@(_HistorySources->'%(FullPath)|%(FileHash)')" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <EmbeddedResource Include="$(IntermediateOutputPath)history-sources.sha256" LogicalName="Tertius.HistorySources.sha256" WithCulture="false" />
    </ItemGroup>
  </Target>
</Project>
