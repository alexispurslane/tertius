#version 460
#extension GL_EXT_samplerless_texture_functions : require
#extension GL_GOOGLE_include_directive : require
#include "meter.glsl"

// The exposure's meter (docs/plans/auto-exposure.md, "The shaders of the exposure pass"): reads the top-left pixel of
// each 2 x 2 block of the HDR image, and counts it in the bin of its pre-exposed luminance when it is a surface pixel.
// An odd image's last column or row is a block of its own. One invocation per block, dispatched over
// ceil(ceil(width / 2) / 16) x ceil(ceil(height / 2) / 16) workgroups.

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) uniform texture2D hdrImage;        // pre-exposed radiance
layout(set = 0, binding = 1) uniform texture2D distanceImage;   // the G-buffer distance: 0 is sky
layout(set = 1, binding = 0, std430) buffer HistogramBlock { uint bins[HistogramBins]; };

shared uint localBins[HistogramBins];
layout(push_constant, std430) uniform MeterPush { uvec2 activeSize; } meter;

void main()
{
    uint i = gl_LocalInvocationIndex;
    localBins[i] = 0u;
    barrier();
    // The block's top-left pixel: it lies inside the image exactly when the block does, so the test below keeps every
    // fetch in range.
    ivec2 pixel = 2 * ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = ivec2(meter.activeSize);
    if (pixel.x < size.x && pixel.y < size.y && texelFetch(distanceImage, pixel, 0).r > 0.0)
        atomicAdd(localBins[binOf(luminance(texelFetch(hdrImage, pixel, 0).rgb))], 1u);
    barrier();
    uint count = localBins[i];
    if (count > 0u)
        atomicAdd(bins[i], count);
}
