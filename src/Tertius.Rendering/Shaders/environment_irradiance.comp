#version 460
#extension GL_GOOGLE_include_directive : require
#include "cube_faces.glsl"
#include "spherical_harmonics.glsl"

// The partial sums of the environment map's irradiance (EnvironmentPrefilterPass.cs, docs/plans/environment-map.md, "The
// irradiance"): the projection of one block of level 0 of one map onto the nine Y_lm, in the map's own axes. A block is BlockRows rows
// of one face, and workgroup b sums block b, so the blocks run on many GPU cores at once. Invocation j sums the block's
// texels j, j + 64, ... in row and column order, and a tree in shared memory adds the 64 partial sums in a fixed order,
// so one map always gives the same bits on one GPU. environment_irradiance_sum.comp adds the blocks.

const uint Invocations = 64u;
const uint BlockRows = 8u;   // Irradiance.BlockRows
const uint Sums = 27u;       // nine coefficients of three colors, Irradiance.PartialFloats

layout(local_size_x = 64) in;

layout(set = 0, binding = 0) uniform textureCubeArray radianceMap;
layout(set = 0, binding = 1) uniform sampler environmentSampler;
// Sums floats per block, coefficient-major: block b holds red, green and blue of E_00 first.
layout(set = 0, binding = 3, std430) writeonly buffer IrradiancePartialsBlock { float partialSums[]; };

// EnvironmentPrefilterPushConstants in GpuTypes.cs, of which this shader reads only the map.
layout(push_constant, std430) uniform PrefilterPush
{
    layout(offset = 76) uint map;  // m: the dispatch reads cube m
} prefilter;

// 27 floats per invocation, 6,912 B, under the specification's least limit of 16,384 B.
shared float partials[Sums * Invocations];

void main()
{
    uint j = gl_LocalInvocationIndex;
    uint size = uint(textureSize(samplerCubeArray(radianceMap, environmentSampler), 0).x);
    uint blockTexels = BlockRows * size;
    uint first = gl_WorkGroupID.x * blockTexels;
    float sums[Sums];
    for (uint c = 0u; c < Sums; c++)
        sums[c] = 0.0;
    for (uint t = first + j; t < first + blockTexels; t += Invocations)
    {
        uint layer = t / (size * size);
        uint inLayer = t - layer * size * size;
        uvec2 texel = uvec2(inLayer % size, inLayer / size);
        vec3 ray = faceRay(layer, (vec2(texel) + 0.5) / float(size));
        // The exact ray through a texel center reads that texel alone.
        vec3 radiance = textureLod(
            samplerCubeArray(radianceMap, environmentSampler), vec4(ray, float(prefilter.map)), 0.0).rgb;
        radiance *= texelSolidAngle(texel, size);
        float y[9];
        shBasis(normalize(ray), y);
        for (uint i = 0u; i < 9u; i++)
        {
            sums[3u * i] += radiance.r * y[i];
            sums[3u * i + 1u] += radiance.g * y[i];
            sums[3u * i + 2u] += radiance.b * y[i];
        }
    }
    for (uint c = 0u; c < Sums; c++)
        partials[c * Invocations + j] = sums[c];

    for (uint stride = Invocations / 2u; stride > 0u; stride /= 2u)
    {
        memoryBarrierShared();
        barrier();
        if (j < stride)
            for (uint c = 0u; c < Sums; c++)
                partials[c * Invocations + j] += partials[c * Invocations + j + stride];
    }
    memoryBarrierShared();
    barrier();

    if (j < Sums)
        partialSums[gl_WorkGroupID.x * Sums + j] = partials[j * Invocations];
}
