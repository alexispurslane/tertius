#version 460
#extension GL_GOOGLE_include_directive : require
#include "cube_faces.glsl"

// Level 0 of one map's irradiance cube (EnvironmentPrefilterPass.cs, docs/plans/environment-map.md, "The irradiance"):
// D(n) at the center of each texel, the mean of the radiance map's level of SourceFaceSize texels over the hemisphere of n,
// each source texel weighted by its solid angle times max(n·ω, 0), in all four channels. IrradianceCube.Convolve is the C#
// copy. The dispatch convolves the run of faces from firstFace of map m: it reads cube m of the radiance map and writes
// layers 6m + firstFace on of the cube, one face per WorkgroupsPerFace workgroups.
//
// Lanes invocations share a texel of the cube, so a workgroup holds 64 / Lanes texels that follow each other in layer, row
// and column order. The workgroup walks the source in rounds of 64 texels: each invocation puts one source texel into
// shared memory, its direction, its solid angle and its light, and lane j of each cube texel then sums the round's texels
// j, j + Lanes, ... in order. The texel adds its lanes' sums in lane order, so one map always gives the same bits on one
// GPU.

const uint Invocations = 64u;
const uint Lanes = 8u;             // IrradianceCube.Lanes
const uint SourceFaceSize = 32u;    // IrradianceCube.SourceFaceSize

layout(local_size_x = 64) in;

layout(set = 0, binding = 0) uniform textureCubeArray radianceMap;
layout(set = 0, binding = 1) uniform sampler environmentSampler;
// Level 0 of the irradiance cubes, six layers per map, in binding 0 of the cube's levels set
// (DescriptorLayouts.EnvironmentLevelsSet). The downsample writes the other levels from it.
layout(set = 1, binding = 0, rgba16f) uniform writeonly image2DArray irradianceLevel0;

// EnvironmentPrefilterPushConstants in GpuTypes.cs, of which this shader reads only the map.
layout(push_constant, std430) uniform PrefilterPush
{
    layout(offset = 76) uint map;  // m: the dispatch reads cube m and writes layers of map m
    uint firstFace;                // the first of the faces that the dispatch writes, whose workgroups cover them exactly
} prefilter;

// One round of the source: xyz the unit direction ω of a texel's center, w its solid angle, and its light.
shared vec4 sourceDirections[Invocations];
shared vec4 sourceLight[Invocations];
// Each invocation's weighted sum of its lane's source texels, and the sum of those weights.
shared vec4 laneSums[Invocations];
shared float laneWeights[Invocations];

void main()
{
    uint index = gl_LocalInvocationIndex;
    uint lane = index % Lanes;
    uint size = uint(imageSize(irradianceLevel0).x);
    uint texel = gl_WorkGroupID.x * (Invocations / Lanes) + index / Lanes;
    // The texels run face by face, from the dispatch's first face.
    uint faceIndex = texel / (size * size);
    uint inLayer = texel - faceIndex * size * size;
    uint layer = prefilter.firstFace + faceIndex;
    uvec2 xy = uvec2(inLayer % size, inLayer / size);
    vec3 n = normalize(faceRay(layer, (vec2(xy) + 0.5) / float(size)));

    // The source: the level of SourceFaceSize texels, or level 0 of a smaller map. Both are powers of two, so the level
    // is the difference of their logarithms, and each face holds a multiple of 64 texels.
    uint mapSize = uint(textureSize(samplerCubeArray(radianceMap, environmentSampler), 0).x);
    uint sourceSize = min(mapSize, SourceFaceSize);
    float sourceLevel = float(findMSB(mapSize) - findMSB(sourceSize));
    uint faceTexels = sourceSize * sourceSize;

    vec4 sum = vec4(0.0);
    float weight = 0.0;
    for (uint first = 0u; first < 6u * faceTexels; first += Invocations)
    {
        uint source = first + index;
        uint sourceLayer = source / faceTexels;
        uint inSourceLayer = source - sourceLayer * faceTexels;
        uvec2 sourceXy = uvec2(inSourceLayer % sourceSize, inSourceLayer / sourceSize);
        vec3 ray = faceRay(sourceLayer, (vec2(sourceXy) + 0.5) / float(sourceSize));
        sourceDirections[index] = vec4(normalize(ray), texelSolidAngle(sourceXy, sourceSize));
        // The exact ray through a texel center at an integer level reads that texel alone. The layer coordinate float(m)
        // is an integer, which Vulkan rounds to itself.
        sourceLight[index] = textureLod(
            samplerCubeArray(radianceMap, environmentSampler), vec4(ray, float(prefilter.map)), sourceLevel);
        memoryBarrierShared();
        barrier();
        for (uint i = lane; i < Invocations; i += Lanes)
        {
            vec4 direction = sourceDirections[i];
            float cosine = dot(n, direction.xyz);
            if (cosine > 0.0)
            {
                float w = cosine * direction.w;
                sum += sourceLight[i] * w;
                weight += w;
            }
        }
        // The next round overwrites the table only after every lane has read it.
        memoryBarrierShared();
        barrier();
    }
    laneSums[index] = sum;
    laneWeights[index] = weight;
    memoryBarrierShared();
    barrier();

    if (lane == 0u)
    {
        vec4 total = vec4(0.0);
        float totalWeight = 0.0;
        for (uint j = 0u; j < Lanes; j++)
        {
            total += laneSums[index + j];
            totalWeight += laneWeights[index + j];
        }
        // The source texel whose center lies nearest n has n·ω > 0, so the total weight is positive.
        imageStore(irradianceLevel0, ivec3(xy, 6u * prefilter.map + layer), total / totalWeight);
    }
}
