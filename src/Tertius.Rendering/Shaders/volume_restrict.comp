#version 460
#extension GL_GOOGLE_include_directive : require
#define VOLUME_SET 0
#define VOLUME_ACCESS
#include "volume.glsl"
layout(local_size_x = 64) in;
layout(push_constant) uniform RestrictSurface
{
    uint level;
}
pass;
void main()
{
    int level = int(pass.level);
    int cell = int(gl_GlobalInvocationID.x);
    int side = int(gl_WorkGroupID.y);
    // The last work group runs past the parent's last cell.
    if (cell >= cellsOf(level))
        return;
    vec4 parent = volume.grids[level], child = volume.grids[level - 1];
    ivec3 first = 2 * coordinates(level, cell) + ivec3(round((parent.xyz - child.xyz) / child.w));
    if (any(lessThan(first, ivec3(-1))) || any(greaterThanEqual(first, ivec3(sideOf(level - 1)))))
        return;
    vec4 areaNormal = vec4(0);
    vec4 color = vec4(0);
    vec3 source = vec3(0);
    for (int i = 0; i < 8; ++i)
    {
        ivec3 c = first + ivec3(i & 1, (i >> 1) & 1, i >> 2);
        if (!withinGrid(level - 1, c))
            continue;
        SurfaceBucket sampleBucket = volume.surfaces[bucketIndex(level - 1, c, side)];
        areaNormal += vec4(sampleBucket.areaNormal);
        color += vec4(sampleBucket.color);
        source += uintBitsToFloat(sampleBucket.source.rgb);
    }
    // One parent face covers four child faces. Preserve shell geometry already in this cell.
    int target = bucketIndex(level, coordinates(level, cell), side);
    volume.surfaces[target].areaNormal += ivec4(round(areaNormal * 0.25));
    volume.surfaces[target].color += uvec4(round(color * 0.25));
    volume.surfaces[target].source.rgb = floatBitsToUint(uintBitsToFloat(volume.surfaces[target].source.rgb) + source * 0.25);
}
