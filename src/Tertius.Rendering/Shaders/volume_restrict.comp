#version 460
#extension GL_GOOGLE_include_directive : require
#define VOLUME_SET 0
#define VOLUME_ACCESS
#include "volume.glsl"
layout(local_size_x = 64) in;
layout(push_constant) uniform RestrictSurface
{
    uint level;
}
pass;
void main()
{
    int level = int(pass.level);
    int cell = int(gl_GlobalInvocationID.x);
    int side = int(gl_WorkGroupID.y);
    vec4 parent = volume.grids[level], child = volume.grids[level - 1];
    // Prototype (issue #21): a parent cell spans `ratio` child cells per axis, 2 or 4.
    int ratio = int(round(parent.w / child.w));
    ivec3 first = ratio * coordinates(cell) + ivec3(round((parent.xyz - child.xyz) / child.w));
    if (any(lessThan(first, ivec3(1 - ratio))) || any(greaterThanEqual(first, ivec3(GridSide))))
        return;
    vec4 areaNormal = vec4(0);
    vec3 color = vec3(0), emission = vec3(0);
    for (int i = 0; i < ratio * ratio * ratio; ++i)
    {
        ivec3 c = first + ivec3(i % ratio, (i / ratio) % ratio, i / (ratio * ratio));
        if (!withinGrid(c))
            continue;
        SurfaceBucket sampleBucket = volume.surfaces[((level - 1) * Cells + cellIndex(c)) * 6 + side];
        areaNormal += vec4(sampleBucket.areaNormal);
        color += vec3(sampleBucket.color.rgb);
        emission += vec3(sampleBucket.emission.rgb);
    }
    // One parent face covers ratio² child faces. Preserve shell geometry already in this cell.
    int target = (level * Cells + cell) * 6 + side;
    float faceShare = 1.0 / float(ratio * ratio);
    volume.surfaces[target].areaNormal += ivec4(round(areaNormal * faceShare));
    volume.surfaces[target].color.rgb += uvec3(round(color * faceShare));
    volume.surfaces[target].emission.rgb += uvec3(round(emission * faceShare));
}
