#version 460
// The block rays of one kind of the screen tracer (https://github.com/alexispurslane/tertius/wiki/temporal-renderer, section 6): each 2 × 2 block's ray from
// its chosen pixel, with the ray's setup, its walk and its light in one invocation (decision 40), into the block's record,
// and while the rays are guided each reflection ray's guide (ScreenTraceImages.BlockGuide).
// screen_trace_own_rays.comp traces the listed pixels' own rays. The two stay separate shaders, so that neither pipeline
// binds the other's records and the own dispatch needs no barrier after the block dispatch.
#extension GL_GOOGLE_include_directive : require
#include "screen_trace.glsl"

// 8 × 8 blocks per workgroup.
layout(local_size_x = 8, local_size_y = 8) in;

void main()
{
    ivec2 block = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(block, ivec2(ceil(frame.viewport.xy * 0.5)))))
        return;
    ivec2 chosen;
    TracingPixel p;
    RayRecord record = noRay();
    // The ray's guided density, its evidence for its tile's share and the share that drew it: 0 for a block that no pixel
    // starts.
    vec4 guide = vec4(0.0);
    if (chosenPixelOf(block, chosen, p))
    {
        TracedRay ray = traceFrom(chosen, block, p);
        record = recordOf(ray);
        guide = vec4(ray.guidedDensity, shareEvidenceOf(p, ray), ray.share);
    }
    if (trace.reflectionCeiling > 0.0)
        imageStore(blockGuide, block, guide);
    imageStore(blockLight, block, record.light);
    imageStore(blockRay, block, record.ray);
}
