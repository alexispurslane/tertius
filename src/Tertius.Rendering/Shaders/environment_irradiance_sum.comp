#version 460
#extension GL_GOOGLE_include_directive : require
#include "spherical_harmonics.glsl"

// The irradiance of the environment map (EnvironmentPrefilterPass.cs, docs/plans/environment-map.md, "The irradiance"):
// the sum of the blocks' partial sums that environment_irradiance.comp wrote, times the clamped cosine's coefficients.
// One workgroup of 128 invocations, the most that the Vulkan specification guarantees. Invocation j sums the blocks j,
// j + 128, ... in order, and a tree in shared memory adds the 128 sums in a fixed order, so one map always gives the same
// bits on one GPU.

const uint Invocations = 128u;
const uint BlockRows = 8u;   // Irradiance.BlockRows
const uint Sums = 27u;       // nine coefficients of three colors

layout(local_size_x = 128) in;

layout(set = 0, binding = 0) uniform textureCube radianceMap;
layout(set = 0, binding = 1) uniform sampler environmentSampler;
// Coefficient i in vec4 i: xyz E_lm, w 0 (Irradiance.cs).
layout(set = 0, binding = 2, std430) writeonly buffer IrradianceBlock { vec4 irradiance[9]; };
layout(set = 0, binding = 3, std430) readonly buffer IrradiancePartialsBlock { float partialSums[]; };

// 27 floats per invocation, 13,824 B, under the specification's least limit of 16,384 B.
shared float partials[Sums * Invocations];

void main()
{
    uint j = gl_LocalInvocationIndex;
    // Irradiance.Blocks: BlockRows rows of each of the six faces.
    uint blocks = 6u * uint(textureSize(samplerCube(radianceMap, environmentSampler), 0).x) / BlockRows;
    float sums[Sums];
    for (uint c = 0u; c < Sums; c++)
        sums[c] = 0.0;
    for (uint b = j; b < blocks; b += Invocations)
        for (uint c = 0u; c < Sums; c++)
            sums[c] += partialSums[b * Sums + c];
    for (uint c = 0u; c < Sums; c++)
        partials[c * Invocations + j] = sums[c];

    for (uint stride = Invocations / 2u; stride > 0u; stride /= 2u)
    {
        memoryBarrierShared();
        barrier();
        if (j < stride)
            for (uint c = 0u; c < Sums; c++)
                partials[c * Invocations + j] += partials[c * Invocations + j + stride];
    }
    memoryBarrierShared();
    barrier();

    if (j < 9u)
    {
        float cosine = ShClampedCosine[shBand(j)];
        uint c = 3u * j;
        irradiance[j] = vec4(
            cosine * partials[c * Invocations],
            cosine * partials[(c + 1u) * Invocations],
            cosine * partials[(c + 2u) * Invocations],
            0.0
        );
    }
}
