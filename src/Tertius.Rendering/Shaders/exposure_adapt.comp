#version 460
#extension GL_GOOGLE_include_directive : require
#include "meter.glsl"

layout(local_size_x = 256) in;
layout(set = 1, binding = 0, std430) readonly buffer HistogramBlock { uint bins[HistogramBins]; };
layout(set = 1, binding = 1, std430) buffer ExposureBlock
{
    float exposureStops;
    float previousStops;
    float historyStops;
};
layout(push_constant, std430) uniform AdaptPush
{
    float darkShare;
    float brightShare;
    float minStops;
    float maxStops;
    float compensationStops;
    float intoDarkFactor;
    float intoLightFactor;
    uint phase; // 0: next ordinary exposure; 1: cut exposure before display; 2: finish a displayed cut
} adapt;

// 11,268 bytes, below Vulkan's 16 KiB minimum. The weighted reduction has one entry per invocation.
shared uint cumulative[HistogramBins];
shared float weighted[256];
shared float weights[256];
shared float brightEdge;

void main()
{
    uint i = gl_LocalInvocationIndex;
    if (adapt.phase == 2u)
    {
        if (i == 0u)
            previousStops = exposureStops;
        return;
    }
    for (uint bin = i; bin < HistogramBins; bin += 256u)
        cumulative[bin] = bins[bin];
    barrier();
    for (uint offset = 1u; offset < HistogramBins; offset <<= 1u)
    {
        uint before[9];
        for (uint part = 0u; part < 9u; part++)
        {
            uint bin = i + 256u * part;
            before[part] = bin >= offset ? cumulative[bin - offset] : 0u;
        }
        barrier();
        for (uint part = 0u; part < 9u; part++)
            cumulative[i + 256u * part] += before[part];
        barrier();
    }
    float total = float(cumulative[HistogramBins - 1u]);
    float low = adapt.darkShare * total;
    float high = (1.0 - adapt.brightShare) * total;
    weighted[i] = 0.0;
    weights[i] = 0.0;
    for (uint bin = i; bin < HistogramBins; bin += 256u)
    {
        uint count = bins[bin];
        float end = float(cumulative[bin]);
        float start = end - float(count);
        float inside = max(min(end, high) - max(start, low), 0.0);
        weighted[i] += inside * binCenterStops(bin);
        weights[i] += inside;
        if (start < high && high <= end)
            brightEdge = LowestStops + (float(bin) + (high - start) / float(count)) / BinsPerStop;
    }
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1u)
    {
        if (i < stride)
        {
            weighted[i] += weighted[i + stride];
            weights[i] += weights[i + stride];
        }
        barrier();
    }
    if (i == 0u)
    {
        float used = exposureStops;
        float target = used;
        if (total > 0.0)
        {
            float mean = weighted[0] / weights[0];
            target = clamp(min(log2(MiddleGray) - mean, -brightEdge) + adapt.compensationStops,
                adapt.minStops, adapt.maxStops);
        }
        else if (adapt.phase == 1u)
            target = clamp(0.0, adapt.minStops, adapt.maxStops);
        if (adapt.phase == 1u)
        {
            historyStops = used;
            exposureStops = target;
        }
        else
        {
            float factor = target > used ? adapt.intoDarkFactor : adapt.intoLightFactor;
            historyStops = used;
            previousStops = used;
            exposureStops = used + (target - used) * factor;
        }
    }
}
