#version 460
// The tail of the depth pyramid (docs/plans/screen-space-reflections.md, "The depth pyramid"): pyramid_tail.glsl over
// the bounds of depth_pyramid_down.comp, whose merges are exact.
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_samplerless_texture_functions : require
#include "depth_pyramid.glsl"

#define TailCell vec2
#define TAIL_FORMAT rg32f

vec2 emptyCell()
{
    return vec2(0.0, EmptyFar);
}

vec2 mergedCells(vec2 a, vec2 b)
{
    return mergedBounds(a, b);
}

vec2 cellOfTexel(vec4 texel)
{
    return texel.rg;
}

vec4 texelOfCell(vec2 bounds)
{
    return vec4(bounds, 0.0, 0.0);
}

#include "pyramid_tail.glsl"
