#version 460
// The finest level of the depth pyramid, level 0 of the two-depth walk (docs/plans/back-face-depth-layer.md, "The
// model"). Each texel holds the slab of its pixel (pixelSlab), from the pixel's front surface and its back share: R its
// center w (inverseDepthAlong) and G its back w (slabBack), or (0, 0) for sky. One invocation per pixel. The levels
// above it merge the slab bounds of the pixels' surfaces. Their front w is at least the center's w, and their back w at
// most the pixel's. So each cell's slab holds the slab of every pixel under it. DepthPyramid.PixelSlab is the C# copy.
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_samplerless_texture_functions : require
#include "depth_pyramid.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 3, binding = 0) uniform texture2D backShare;                      // the back share, the screen's size
layout(set = 3, binding = 1, rg32f) uniform writeonly image2D destination;   // the finest level, the screen's size

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, imageSize(destination))))
        return;
    imageStore(destination, pixel, vec4(pixelSlab(pixel, texelFetch(backShare, pixel, 0).r), 0.0, 0.0));
}
