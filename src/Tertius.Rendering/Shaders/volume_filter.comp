#version 460
#extension GL_GOOGLE_include_directive : require
#define VOLUME_SET 0
#define VOLUME_ACCESS
#include "volume.glsl"
layout(local_size_x = 64) in;
layout(push_constant) uniform Filter
{
    uint finalPass;
}
pass;
// The sweep interpolates four upwind cells, some in the same layer as the receiver.
// At a surface those grazing taps can bring radiance from the far side of its own
// wall. The strictly upwind corner of the same stencil lies across each crossed
// face. Use that corner for the last step of a bounce onto occupied geometry.
vec4 incidentAtSurface(int level, int local, int direction, vec3 step)
{
    ivec3 q = coordinates(level, local) - ivec3(sign(step));
    if (!withinGrid(level, q))
        return parentOutgoing(q, level, direction);
    return outgoingOf(volume.field[fieldIndex(level, direction, cellIndex(level, q))]);
}

void main()
{
    int cell = int(gl_GlobalInvocationID.x), side = int(gl_WorkGroupID.y);
    // The last work group runs past the last cell.
    if (cell >= CellCount)
        return;
    int k = cell * 6 + side;
    if (pass.finalPass == 0u && volume.surfaces[k].areaNormal.w == 0)
        return;
    int level = levelOfCell(cell);
    int local = cell - firstCellOf(level);
    vec3 n = axisNormal(side);
    if (pass.finalPass == 0u)
    {
        vec3 areaNormal = vec3(volume.surfaces[k].areaNormal.xyz);
        if (any(notEqual(areaNormal, vec3(0))))
            n = normalize(areaNormal);
    }
    vec4 diffuse = vec4(0), specular = vec4(0);
    vec2 total = vec2(0);
    for (int d = 0; d < Directions; ++d)
    {
        vec3 step = vec3(directionStep(d));
        float cosine = dot(-normalize(step), n);
        if (cosine <= 0.0)
            continue;
        // All octants use the same four angular samples.
        float weight = cosine;
        float glossy = weight * cosine * cosine * cosine;
        int index = fieldIndex(level, d, local);
#if FILTER_UPWIND_AT_SURFACE
        bool upwind = pass.finalPass == 0u || volume.surfaces[k].areaNormal.w != 0;
#else
        bool upwind = pass.finalPass == 0u;
#endif
        vec4 light = upwind ? incidentAtSurface(level, local, d, step) : incomingOf(volume.field[index]);
        diffuse += weight * light;
        specular += glossy * light;
        total += vec2(weight, glossy);
    }
    if (pass.finalPass == 0u)
        volume.bounce[k] = diffuse / total.x;
    else
    {
        volume.filtered[cell * 12 + side] = diffuse / total.x;
        volume.filtered[cell * 12 + 6 + side] = specular / total.y;
    }
}
