#version 460
// Level k ≥ 1 of the radiance pyramid (docs/plans/screen-space-reflections.md, "The radiance pyramid"): Jimenez's 13-tap
// downsample of level k − 1, in all four channels, at the center of each texel of level k.
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_samplerless_texture_functions : require
#include "frame.glsl"
#include "brdf.glsl"   // the linear clamp sampler
#include "downsample.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 3, binding = 0) uniform texture2D source;                         // level k − 1, one mip
layout(set = 3, binding = 1, rgba16f) uniform writeonly image2D destination;   // level k

vec4 tap(vec2 center, vec2 texel, vec2 offset)
{
    return textureLod(sampler2D(source, linearClamp), center + offset * texel, 0.0);
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(destination);
    if (any(greaterThanEqual(pixel, size)))
        return;
    vec2 texel = 1.0 / vec2(textureSize(source, 0));
    // The texel's center, which the trace's trilinear reads take for its position. Where the source has an even size, it
    // lies on the source texel corner 2p + 1, as in bloom_down.frag.
    vec2 center = (vec2(pixel) + 0.5) / vec2(size);
    imageStore(destination, pixel, jimenez13(
        tap(center, texel, vec2(-2, -2)), tap(center, texel, vec2(0, -2)), tap(center, texel, vec2(2, -2)),
        tap(center, texel, vec2(-1, -1)), tap(center, texel, vec2(1, -1)),
        tap(center, texel, vec2(-2, 0)), tap(center, texel, vec2(0, 0)), tap(center, texel, vec2(2, 0)),
        tap(center, texel, vec2(-1, 1)), tap(center, texel, vec2(1, 1)),
        tap(center, texel, vec2(-2, 2)), tap(center, texel, vec2(0, 2)), tap(center, texel, vec2(2, 2))));
}
