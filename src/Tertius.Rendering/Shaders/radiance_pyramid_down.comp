#version 460
// Level k ≥ 1 of the radiance pyramid (docs/plans/screen-space-reflections.md, "The radiance pyramid"): Jimenez's 13-tap
// downsample of level k − 1, in all four channels, at the center of each texel of level k.
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_samplerless_texture_functions : require
#include "frame.glsl"
#include "brdf.glsl"   // the linear clamp sampler
#include "downsample.glsl"

const int GroupSide = 8;                    // the local size, 8 × 8
// Where the source has an even size on both axes, every tap of texel p lies on a source texel corner, 2p − 1 to 2p + 3
// on each axis (corner c lies between source texels c − 1 and c), so the workgroup's 8 × 8 texels read 19 × 19 corners.
const int CornerSide = 2 * GroupSide + 3;

layout(local_size_x = GroupSide, local_size_y = GroupSide) in;

layout(set = 3, binding = 0) uniform texture2D source;                         // level k − 1, one mip
layout(set = 3, binding = 1, rgba16f) uniform writeonly image2D destination;   // level k

// The bilinear taps at the corners that the workgroup's texels read, row by row: 5,776 B.
shared vec4 corners[CornerSide * CornerSide];

vec4 tap(vec2 center, vec2 texel, vec2 offset)
{
    return textureLod(sampler2D(source, linearClamp), center + offset * texel, 0.0);
}

vec4 corner(ivec2 local, ivec2 offset)
{
    // Texel p's center lies on corner 2p + 1, which is the workgroup's corner 2 · local + 2.
    ivec2 c = 2 * local + 2 + offset;
    return corners[c.y * CornerSide + c.x];
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(destination);
    ivec2 sourceSize = textureSize(source, 0);
    vec2 texel = 1.0 / vec2(sourceSize);
    // The same in the whole dispatch, so the barrier lies in uniform control flow.
    if (all(equal(sourceSize & 1, ivec2(0))))
    {
        // Each corner's tap is the bilinear read that tap() makes there, once for the workgroup instead of once for each
        // of the up to four texels that read it: a quarter of each of the four texels around the corner, and the
        // sampler's clamp beside the image's edge.
        ivec2 origin = 2 * GroupSide * ivec2(gl_WorkGroupID.xy) - 1;
        for (int i = int(gl_LocalInvocationIndex); i < CornerSide * CornerSide; i += GroupSide * GroupSide)
        {
            vec2 c = vec2(origin + ivec2(i % CornerSide, i / CornerSide));
            corners[i] = textureLod(sampler2D(source, linearClamp), c / vec2(sourceSize), 0.0);
        }
        // Every invocation has read its corners before any invocation reads them.
        barrier();
        if (any(greaterThanEqual(pixel, size)))
            return;
        ivec2 local = ivec2(gl_LocalInvocationID.xy);
        imageStore(destination, pixel, jimenez13(
            corner(local, ivec2(-2, -2)), corner(local, ivec2(0, -2)), corner(local, ivec2(2, -2)),
            corner(local, ivec2(-1, -1)), corner(local, ivec2(1, -1)),
            corner(local, ivec2(-2, 0)), corner(local, ivec2(0, 0)), corner(local, ivec2(2, 0)),
            corner(local, ivec2(-1, 1)), corner(local, ivec2(1, 1)),
            corner(local, ivec2(-2, 2)), corner(local, ivec2(0, 2)), corner(local, ivec2(2, 2))));
        return;
    }
    if (any(greaterThanEqual(pixel, size)))
        return;
    // The texel's center, which the trace's trilinear reads take for its position. Where the source has an even size, it
    // lies on the source texel corner 2p + 1, as in bloom_down.frag.
    vec2 center = (vec2(pixel) + 0.5) / vec2(size);
    imageStore(destination, pixel, jimenez13(
        tap(center, texel, vec2(-2, -2)), tap(center, texel, vec2(0, -2)), tap(center, texel, vec2(2, -2)),
        tap(center, texel, vec2(-1, -1)), tap(center, texel, vec2(1, -1)),
        tap(center, texel, vec2(-2, 0)), tap(center, texel, vec2(0, 0)), tap(center, texel, vec2(2, 0)),
        tap(center, texel, vec2(-1, 1)), tap(center, texel, vec2(1, 1)),
        tap(center, texel, vec2(-2, 2)), tap(center, texel, vec2(0, 2)), tap(center, texel, vec2(2, 2))));
}
