#version 460
#extension GL_GOOGLE_include_directive : require

// brdf.glsl's ggxDistribution needs PI, and this shader binds no frame set, so it does not include frame.glsl.
const float PI = 3.14159265358979323846;

#include "brdf.glsl"
#include "cube_faces.glsl"

// One level of the environment map's specular map (EnvironmentPrefilterPass.cs, docs/plans/environment-map.md, "The
// specular levels"). Level 0 is the radiance map's level 0, texel for texel. Level k ≥ 1 is the prefilter of Karis 2013
// with n = v = r, over 64 Hammersley samples with filtered importance sampling (Křivánek and Colbert 2008), in all four
// channels, so the alpha is the open-sky share along the lobe. One invocation per texel, over (W_k, W_k, 6).

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform textureCube radianceMap;
layout(set = 0, binding = 1) uniform sampler environmentSampler;
// Level k of the specular map, six layers.
layout(set = 2, binding = 0, rgba16f) uniform writeonly image2DArray specularLevel;

// EnvironmentPrefilterPushConstants in GpuTypes.cs.
layout(push_constant, std430) uniform PrefilterPush
{
    uint levelSize;   // W_k
    float roughness;  // r_k = k / (L − 1)
    uint samples;     // N
} prefilter;

// The base-2 radical inverse of i: its bits mirrored about the binary point (Hammersley.cs).
float radicalInverse(uint i)
{
    return float(bitfieldReverse(i)) * 2.3283064365386963e-10;
}

// The unit GGX half vector of width alpha that the point (u1, u2) of the unit square maps to, around the unit n, with
// density D (n·h) (GgxLobe.SampleHalfVector).
vec3 ggxHalfVector(vec2 u, float alpha, vec3 n)
{
    float azimuth = 2.0 * PI * u.x;
    float cosTheta = sqrt((1.0 - u.y) / (1.0 + (alpha * alpha - 1.0) * u.y));
    float sinTheta = sqrt(max(1.0 - cosTheta * cosTheta, 0.0));
    vec3 helper = abs(n.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
    vec3 tangent = normalize(cross(helper, n));
    vec3 bitangent = cross(n, tangent);
    return (tangent * cos(azimuth) + bitangent * sin(azimuth)) * sinTheta + n * cosTheta;
}

// The lobe of roughness r_k around n, as the radiance map shows it.
vec4 prefiltered(vec3 n)
{
    float alpha = prefilter.roughness * prefilter.roughness;
    float faceSize = float(textureSize(samplerCube(radianceMap, environmentSampler), 0).x);
    // Ω_p: the solid angle of one texel of level 0.
    float texelAngle = 4.0 * PI / (6.0 * faceSize * faceSize);
    vec4 sum = vec4(0.0);
    float weight = 0.0;
    // The first point, (0, 0), gives h = n and l = n, so the weight is at least 1.
    for (uint i = 0u; i < prefilter.samples; i++)
    {
        vec2 u = vec2(float(i) / float(prefilter.samples), radicalInverse(i));
        vec3 h = ggxHalfVector(u, alpha, n);
        float NdotH = dot(n, h);
        vec3 l = 2.0 * NdotH * h - n;
        float NdotL = dot(n, l);
        if (NdotL > 0.0)
        {
            float pdf = ggxDistribution(NdotH, alpha) * 0.25;
            float sampleSolidAngle = 1.0 / (float(prefilter.samples) * pdf);
            float lod = max(0.5 * log2(sampleSolidAngle / texelAngle) + 1.0, 0.0);
            sum += textureLod(samplerCube(radianceMap, environmentSampler), l, lod) * NdotL;
            weight += NdotL;
        }
    }
    return sum / weight;
}

void main()
{
    uvec3 id = gl_GlobalInvocationID;
    if (id.x >= prefilter.levelSize || id.y >= prefilter.levelSize)
        return;
    vec2 st = (vec2(id.xy) + 0.5) / float(prefilter.levelSize);
    vec3 ray = faceRay(id.z, st);
    // The exact ray through a texel center reads that texel of level 0 alone, so the mirror level copies it.
    vec4 value = prefilter.roughness == 0.0
        ? textureLod(samplerCube(radianceMap, environmentSampler), ray, 0.0)
        : prefiltered(normalize(ray));
    imageStore(specularLevel, ivec3(id), value);
}
