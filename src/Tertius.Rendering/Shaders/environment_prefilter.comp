#version 460
#extension GL_GOOGLE_include_directive : require

// brdf.glsl's ggxDistribution needs PI, and this shader binds no frame set, so it does not include frame.glsl.
const float PI = 3.14159265358979323846;

#include "brdf.glsl"
#include "cube_faces.glsl"

// A run of up to four levels of the environment map's specular map (EnvironmentPrefilterPass.cs,
// docs/plans/environment-map.md, "The specular levels"). Level 0 is the radiance map's level 0, texel for texel. Level k ≥ 1 is the prefilter of Karis 2013
// with n = v = r, over N Hammersley samples with filtered importance sampling (Křivánek and Colbert 2008), in all four
// channels, so the alpha is the open-sky share along the lobe. The dispatch prefilters one map m: it reads cube m of the
// radiance map and writes layers 6m to 6m + 5. A map lies in its own axes, and so do its texels' rays, so the prefilter
// needs no turn.
//
// The workgroups of each level of the dispatch follow those of the level before, so a workgroup prefilters one level,
// and all its invocations take the same branches. A workgroup prefilters 64 / lanes texels that follow each other in layer, row and column order, with lanes invocations
// per texel (PrefilterLevels.Lanes). With n = v, a sample's direction around n, its weight n·l and the level of the
// radiance map that it reads depend only on the sample and the level, not on the texel. So the workgroup first builds
// the level's table of samples in shared memory, one sample per invocation. Lane j of a texel then sums the samples j, j + lanes, ... in its own axes,
// and the texel adds its lanes' sums in lane order, so one map always gives the same bits on one GPU. The lanes make a
// small level's chain of dependent texture reads shorter, and fill the GPU with as many invocations as level 1.

const uint Invocations = 64u;    // EnvironmentPrefilterPass.GroupInvocations
const uint MaxSamples = 64u;     // the table's rows, one per invocation: PrefilterLevels.SamplesPerTexel at most
const uint MaxLevels = 4u;       // PrefilterLevels.LevelsPerDispatch

layout(local_size_x = 64) in;

layout(set = 0, binding = 0) uniform textureCubeArray radianceMap;
layout(set = 0, binding = 1) uniform sampler environmentSampler;
// The levels of the dispatch in order, six layers per map (DescriptorLayouts.EnvironmentLevelsSet). A binding past the
// last level holds that level again, and nothing writes it.
layout(set = 1, binding = 0, rgba16f) uniform writeonly image2DArray specularLevel0;
layout(set = 1, binding = 1, rgba16f) uniform writeonly image2DArray specularLevel1;
layout(set = 1, binding = 2, rgba16f) uniform writeonly image2DArray specularLevel2;
layout(set = 1, binding = 3, rgba16f) uniform writeonly image2DArray specularLevel3;

// EnvironmentPrefilterLevel in GpuTypes.cs: level k of the dispatch.
struct Level
{
    uint firstGroup;  // its first workgroup
    uint levelSize;   // W_k
    float roughness;  // r_k = k / (L − 1)
    uint lanes;       // the invocations per texel, a power of two that divides Invocations and N
};

// EnvironmentPrefilterPushConstants in GpuTypes.cs.
layout(push_constant, std430) uniform PrefilterPush
{
    Level levels[MaxLevels];  // in binding order
    uint samples;             // N, at most MaxSamples
    uint levelCount;          // 1 to MaxLevels
    uint groupCount;          // the workgroups of the levels, which the grid's rows may pass by a few
    uint map;                 // m
} prefilter;

// Sample i of the level: xyz the direction l in the axes of n (tangent, bitangent, n), so z is n·l, and w the level of the
// radiance map that it reads. A sample with n·l ≤ 0 has z ≤ 0, and no texel reads it.
shared vec4 table[MaxSamples];
// Each invocation's sum of its lane's samples, weighted by n·l, and in w the sum of those weights.
shared vec4 laneSums[Invocations];
shared float laneWeights[Invocations];

// The radiance map's cube m at the direction v and level lod. The layer coordinate float(m) is an integer, which Vulkan
// rounds to itself.
vec4 radianceAt(vec3 v, float lod)
{
    return textureLod(samplerCubeArray(radianceMap, environmentSampler), vec4(v, float(prefilter.map)), lod);
}

// The base-2 radical inverse of i: its bits mirrored about the binary point (Hammersley.cs).
float radicalInverse(uint i)
{
    return float(bitfieldReverse(i)) * 2.3283064365386963e-10;
}

// Sample i of the level of width alpha, as the table holds it. Ω_p = texelAngle is the solid angle of one texel of
// level 0.
vec4 levelSample(uint i, float alpha, float texelAngle)
{
    // The unit GGX half vector of width alpha that Hammersley point i maps to, in the axes of n, with density D (n·h)
    // (GgxLobe.SampleHalfVector).
    vec2 u = vec2(float(i) / float(prefilter.samples), radicalInverse(i));
    float azimuth = 2.0 * PI * u.x;
    float cosTheta = sqrt((1.0 - u.y) / (1.0 + (alpha * alpha - 1.0) * u.y));
    float sinTheta = sqrt(max(1.0 - cosTheta * cosTheta, 0.0));
    vec3 h = vec3(cos(azimuth) * sinTheta, sin(azimuth) * sinTheta, cosTheta);
    // l = 2 (n·h) h − n, with n = (0, 0, 1).
    vec3 l = 2.0 * cosTheta * h - vec3(0.0, 0.0, 1.0);
    float pdf = ggxDistribution(vec3(0.0, 0.0, 1.0), h, alpha) * 0.25;
    float sampleSolidAngle = 1.0 / (float(prefilter.samples) * pdf);
    float lod = max(0.5 * log2(sampleSolidAngle / texelAngle) + 1.0, 0.0);
    return vec4(l, lod);
}

// Stores into the level in binding `binding`, whose index is the same in the whole workgroup.
void store(uint binding, ivec3 texel, vec4 value)
{
    switch (binding)
    {
        case 0u: imageStore(specularLevel0, texel, value); break;
        case 1u: imageStore(specularLevel1, texel, value); break;
        case 2u: imageStore(specularLevel2, texel, value); break;
        default: imageStore(specularLevel3, texel, value); break;
    }
}

void main()
{
    // The workgroup's place in the dispatch. The workgroups lie in rows of at most 65,535, the least
    // maxComputeWorkGroupCount of the specification (ComputeLimits.Grid), and those past the last row's end return
    // before any barrier, as a whole workgroup.
    uint group = gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x;
    if (group >= prefilter.groupCount)
        return;
    // The level of this workgroup: the last of the dispatch whose first workgroup is at most this one.
    uint binding = 0u;
    for (uint b = 1u; b < prefilter.levelCount; b++)
        if (group >= prefilter.levels[b].firstGroup)
            binding = b;
    Level level = prefilter.levels[binding];

    uint index = gl_LocalInvocationIndex;
    uint lane = index % level.lanes;
    uint slot = index / level.lanes;
    uint levelTexels = level.levelSize * level.levelSize;
    uint texel = (group - level.firstGroup) * (Invocations / level.lanes) + slot;
    bool inLevel = texel < 6u * levelTexels;
    uint layer = texel / max(levelTexels, 1u);
    uint inLayer = texel - layer * levelTexels;
    uvec2 xy = uvec2(inLayer % level.levelSize, inLayer / level.levelSize);
    uint mapLayer = 6u * prefilter.map + layer;
    vec3 ray = faceRay(layer, (vec2(xy) + 0.5) / float(level.levelSize));

    // The roughness is the same in the whole workgroup, so every invocation takes the same branch, and all reach the
    // barriers.
    if (level.roughness == 0.0)
    {
        // The exact ray through a texel center reads that texel of level 0 alone, so the mirror level copies it.
        if (inLevel && lane == 0u)
            store(binding, ivec3(xy, mapLayer), radianceAt(ray, 0.0));
        return;
    }

    float alpha = level.roughness * level.roughness;
    float faceSize = float(textureSize(samplerCubeArray(radianceMap, environmentSampler), 0).x);
    float texelAngle = 4.0 * PI / (6.0 * faceSize * faceSize);
    if (index < prefilter.samples)
        table[index] = levelSample(index, alpha, texelAngle);
    memoryBarrierShared();
    barrier();

    vec3 n = normalize(ray);
    vec3 helper = abs(n.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
    vec3 tangent = normalize(cross(helper, n));
    vec3 bitangent = cross(n, tangent);
    vec4 sum = vec4(0.0);
    float weight = 0.0;
    for (uint i = lane; i < prefilter.samples; i += level.lanes)
    {
        vec4 s = table[i];
        if (s.z > 0.0)
        {
            vec3 l = tangent * s.x + bitangent * s.y + n * s.z;
            sum += radianceAt(l, s.w) * s.z;
            weight += s.z;
        }
    }
    laneSums[index] = sum;
    laneWeights[index] = weight;
    memoryBarrierShared();
    barrier();

    if (inLevel && lane == 0u)
    {
        vec4 total = vec4(0.0);
        float totalWeight = 0.0;
        for (uint j = 0u; j < level.lanes; j++)
        {
            total += laneSums[index + j];
            totalWeight += laneWeights[index + j];
        }
        // Sample 0, the point (0, 0), gives h = n and l = n, so lane 0's weight and the total are at least 1.
        store(binding, ivec3(xy, mapLayer), total / totalWeight);
    }
}
