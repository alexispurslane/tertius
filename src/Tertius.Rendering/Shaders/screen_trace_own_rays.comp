#version 460
// The own rays of one kind of the screen tracer (docs/plans/temporal-renderer.md, section 6): an indirect dispatch of the
// kind's own-ray list, which traces each listed pixel's ray into the pixel's record, as screen_trace_block_rays.comp
// traces a block's.
#extension GL_GOOGLE_include_directive : require
#include "screen_trace.glsl"

// ShaderConstants.RayKind.
layout(constant_id = 5) const uint rayKind = 0u;

// OwnRayGroupSize listed pixels per workgroup.
layout(local_size_x = 8, local_size_y = 8) in;

void main()
{
    uint count = rayKind == KindReflection ? reflectionOwnRays.count : diffuseOwnRays.count;
    for (uint entry = gl_WorkGroupID.x * OwnRayGroupSize + gl_LocalInvocationIndex; entry < count;
        entry += MostOwnRayGroups * OwnRayGroupSize)
    {
        ivec2 pixel = unpackedPixel(rayKind == KindReflection ? reflectionOwnRays.pixels[entry] : diffuseOwnRays.pixels[entry]);
        // The plan listed only a pixel that starts the kind, from the same G-buffer.
        RayRecord record = recordOf(traceFrom(pixel, pixel, tracingPixelAt(pixel), rayKind));
        imageStore(ownLight, ivec3(pixel, rayKind), record.light);
        imageStore(ownRay, ivec3(pixel, rayKind), record.ray);
    }
}
