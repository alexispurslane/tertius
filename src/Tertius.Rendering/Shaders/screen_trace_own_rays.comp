#version 460
// The own rays of one kind of the screen tracer (https://github.com/alexispurslane/tertius/wiki/temporal-renderer, section 6): an indirect dispatch of the
// kind's own-ray list, which traces each listed pixel's ray into the pixel's record, as screen_trace_block_rays.comp
// traces a block's.
#extension GL_GOOGLE_include_directive : require
#include "screen_trace.glsl"

// OwnRayGroupSize listed pixels per workgroup.
layout(local_size_x = 8, local_size_y = 8) in;

void main()
{
    uint count = reflectionOwnRays.count;
    for (uint entry = gl_WorkGroupID.x * OwnRayGroupSize + gl_LocalInvocationIndex; entry < count;
        entry += MostOwnRayGroups * OwnRayGroupSize)
    {
        ivec2 pixel = unpackedPixel(reflectionOwnRays.pixels[entry]);
        // The plan listed only a pixel that starts the kind, from the same G-buffer.
        RayRecord record = recordOf(traceFrom(pixel, pixel, tracingPixelAt(pixel)));
        imageStore(ownLight, pixel, record.light);
        imageStore(ownRay, pixel, record.ray);
    }
}
