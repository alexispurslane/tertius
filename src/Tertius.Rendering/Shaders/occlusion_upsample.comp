#version 460
// The occlusion upsample pass (docs/plans/ambient-occlusion.md, "The upsample"): a joint bilateral upsample of term A
// to the full-resolution estimate target, whose range weight is the distance from the pixel's tangent plane. The bounce
// and the occlusion take the same weights (docs/plans/screen-space-illumination.md, "The denoise and the upsample").
// OcclusionUpsample in Shading/ is its C# copy. Engine glue: XeGTAO's README suggests the method but has no code for it.
#extension GL_GOOGLE_include_directive : require
#include "gtao.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 full = fullSize();
    if (any(greaterThanEqual(pixel, full)))
        return;
    float distanceToEye = texelFetch(gbufferDistance, pixel, 0).r;
    // Sky: the ambient pass reads no estimate there.
    if (distanceToEye == 0.0)
    {
        imageStore(estimateTarget, pixel, vec4(0.0, 0.0, 0.0, 1.0));
        return;
    }
    vec3 position = distanceToEye * normalize(gtaoViewPosition(pixelScreenPosition(pixel), 1.0));
    vec3 geometricNormal = geometricNormalAt(pixel);
    float footprint = texelWidth(position.z);
    ivec2 base = pixel / 2;
    // The bilinear weights of texels base and base + 1 along each axis: an even pixel is its texel's representative.
    vec2 weightsX = (pixel.x & 1) == 0 ? vec2(1.0, 0.0) : vec2(0.5);
    vec2 weightsY = (pixel.y & 1) == 0 ? vec2(1.0, 0.0) : vec2(0.5);
    vec4 sum = vec4(0.0);
    float weights = 0.0;
    float nearestOffPlane = 3.402823466e38;
    vec4 nearestEstimate = vec4(0.0, 0.0, 0.0, 1.0);
    for (int b = 0; b < 2; b++)
    {
        for (int a = 0; a < 2; a++)
        {
            float bilinear = weightsX[a] * weightsY[b];
            ivec2 texel = base + ivec2(a, b);
            // A texel beyond the edge of the half-resolution image gets no weight.
            if (bilinear == 0.0 || !insideHalf(texel))
                continue;
            float offPlane = abs(dot(geometricNormal, gtaoTexelPosition(texel) - position));
            float weight = bilinear * max(0.0, 1.0 - offPlane / footprint);
            vec4 term = imageLoad(occlusionTermA, texel);
            sum += weight * term;
            weights += weight;
            if (offPlane < nearestOffPlane)
            {
                nearestOffPlane = offPlane;
                nearestEstimate = term;
            }
        }
    }
    vec4 estimate = weights > 0.0 ? sum / weights : nearestEstimate;
    // The bounce needs no clamp: a mean of non-negative light with non-negative weights. The clamp of V removes the
    // rounding below 0 of the far rays' subtraction.
    imageStore(estimateTarget, pixel, vec4(estimate.rgb, clamp(estimate.a, 0.0, 1.0)));
}
