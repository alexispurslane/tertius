#version 460
// The occlusion upsample pass (docs/plans/ambient-occlusion.md, "The upsample"): a joint bilateral upsample of term A
// to the full-resolution estimate target, whose range weight is the distance from the pixel's tangent plane. Every
// channel of the estimate takes the same weights (docs/plans/screen-space-illumination.md, "The denoise and the
// upsample").
// OcclusionUpsample in Shading/ is its C# copy. Engine glue: XeGTAO's README suggests the method but has no code for it.
//
// One invocation writes the 2 × 2 block of pixels of one half-resolution texel, from (2i, 2j) to (2i + 1, 2j + 1).
// The block's pixels read only texels (i, j) to (i + 1, j + 1), so the compiler shares those reads and their positions
// among the four pixels, where an invocation per pixel read them up to nine times for the block. Each pixel's arithmetic
// is the one of an invocation per pixel, so the estimate keeps its bits: an earlier version that passed the four texels
// to each pixel as arrays let the compiler round some sums otherwise, and one capture changed at an SMAA edge
// (ter-pjza).
#extension GL_GOOGLE_include_directive : require
#include "gtao.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

// The estimate of one full-resolution pixel into the estimate target; a pixel beyond the image writes nothing.
void writePixel(ivec2 pixel)
{
    ivec2 full = fullSize();
    if (any(greaterThanEqual(pixel, full)))
        return;
    float distanceToEye = texelFetch(gbufferDistance, pixel, 0).r;
    // Sky: the ambient pass reads no estimate there.
    if (distanceToEye == 0.0)
    {
        imageStore(estimateTarget, pixel, packEstimate(openEstimate()));
        return;
    }
    vec3 position = distanceToEye * normalize(gtaoViewPosition(pixelScreenPosition(pixel), 1.0));
    vec3 geometricNormal = geometricNormalAt(pixel);
    float footprint = texelWidth(position.z);
    ivec2 base = pixel / 2;
    // The bilinear weights of texels base and base + 1 along each axis: an even pixel is its texel's representative.
    vec2 weightsX = (pixel.x & 1) == 0 ? vec2(1.0, 0.0) : vec2(0.5);
    vec2 weightsY = (pixel.y & 1) == 0 ? vec2(1.0, 0.0) : vec2(0.5);
    Estimate sum = Estimate(vec3(0.0), 0.0, vec3(0.0));
    float weights = 0.0;
    float nearestOffPlane = 3.402823466e38;
    Estimate nearestEstimate = openEstimate();
    for (int b = 0; b < 2; b++)
    {
        for (int a = 0; a < 2; a++)
        {
            float bilinear = weightsX[a] * weightsY[b];
            ivec2 texel = base + ivec2(a, b);
            // A texel beyond the edge of the half-resolution image gets no weight.
            if (bilinear == 0.0 || !insideHalf(texel))
                continue;
            float offPlane = abs(dot(geometricNormal, gtaoTexelPosition(texel) - position));
            float weight = bilinear * max(0.0, 1.0 - offPlane / footprint);
            Estimate term = unpackEstimate(imageLoad(occlusionTermA, texel));
            sum = addWeighted(sum, term, weight);
            weights += weight;
            if (offPlane < nearestOffPlane)
            {
                nearestOffPlane = offPlane;
                nearestEstimate = term;
            }
        }
    }
    Estimate estimate = weights > 0.0 ? dividedEstimate(sum, weights) : nearestEstimate;
    // The bounce needs no clamp: a mean with non-negative weights of values within [0, c]. The clamps of the shares keep
    // the rounding of the sectors pass's division and of the blurs' sums within [0, 1].
    estimate.occlusion = clamp(estimate.occlusion, 0.0, 1.0);
    estimate.blockedShare = clamp(estimate.blockedShare, 0.0, 1.0);
    imageStore(estimateTarget, pixel, packEstimate(estimate));
}

void main()
{
    ivec2 base = ivec2(gl_GlobalInvocationID.xy);
    if (!insideHalf(base))
        return;
    // An odd width or height leaves the last texel's block one pixel short, which writePixel skips.
    for (int k = 0; k < 4; k++)
        writePixel(2 * base + ivec2(k & 1, k >> 1));
}
