#version 460
#extension GL_GOOGLE_include_directive : require
#define VOLUME_SET 0
#define VOLUME_ACCESS
#include "volume.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
layout(push_constant) uniform Sweep
{
    uint level;
}
pass;
shared vec4 plane[2][256];

vec4 upstream(ivec3 c, int u, int v, int slice, int level, int direction)
{
    if (withinGrid(c))
        return plane[(slice + 1) % 2][c[u] + 16 * c[v]];
    return parentOutgoing(c, level, direction);
}

void main()
{
    int level = int(pass.level), direction = int(gl_WorkGroupID.x);
    ivec3 step = directionStep(direction);
    ivec3 magnitude = abs(step);
    int axis = magnitude.x >= max(magnitude.y, magnitude.z) ? 0 : magnitude.y >= magnitude.z ? 1 : 2;
    int u = (axis + 1) % 3, v = (axis + 2) % 3;
    vec2 shift = vec2(magnitude[u], magnitude[v]) / float(magnitude[axis]);
    for (int slice = 0; slice < 16; ++slice)
    {
        for (int j = 0; j < 4; ++j)
        {
            ivec2 xy = ivec2(gl_LocalInvocationID.xy) + 8 * ivec2(j % 2, j / 2);
            ivec3 c;
            c[axis] = step[axis] > 0 ? slice : 15 - slice;
            c[u] = xy.x;
            c[v] = xy.y;
            vec4 incoming = vec4(0);
            for (int i = 0; i < 4; ++i)
            {
                ivec2 corner = ivec2(i % 2, i / 2);
                vec2 weights = mix(1.0 - shift, shift, vec2(corner));
                float fraction = weights.x * weights.y;
                if (fraction == 0.0)
                    continue;
                ivec3 q = c;
                q[axis] -= sign(step[axis]);
                q[u] -= corner.x * sign(step[u]);
                q[v] -= corner.y * sign(step[v]);
                incoming += fraction * upstream(q, u, v, slice, level, direction);
            }
            int index = (level * Directions + direction) * Cells + cellIndex(c);
            vec4 transfer = uintBitsToFloat(volume.field[index]);
            vec4 outgoing = min(incoming * transfer.a + vec4(transfer.rgb, 0), vec4(65504));
            plane[slice % 2][xy.x + 16 * xy.y] = outgoing;
            volume.field[index] =
                uvec4(packHalf2x16(vec2(incoming.r, outgoing.r)), packHalf2x16(vec2(incoming.g, outgoing.g)),
                      packHalf2x16(vec2(incoming.b, outgoing.b)), packHalf2x16(vec2(incoming.a, outgoing.a)));
        }
        barrier();
    }
}
