#version 460
#extension GL_GOOGLE_include_directive : require
#define VOLUME_SET 0
#define VOLUME_ACCESS
#include "volume.glsl"
layout(local_size_x = 64) in;
layout(push_constant) uniform Source
{
    uint bounceNumber;
}
pass;
void main()
{
    int cell = int(gl_GlobalInvocationID.x), direction = int(gl_WorkGroupID.y);
    // The last work group runs past the last cell.
    if (cell >= CellCount)
        return;
    int level = levelOfCell(cell);
    int local = cell - firstCellOf(level);
    ivec3 c = coordinates(level, local);
    vec3 step = vec3(directionStep(direction));
    vec3 projected = step / max(max(abs(step.x), abs(step.y)), abs(step.z));
    float front = 0, back = 0;
    vec3 source = vec3(0);
    for (int side = 0; side < 6; ++side)
    {
        int k = cell * 6 + side;
        SurfaceBucket bucket = volume.surfaces[k];
        ivec4 an = bucket.areaNormal;
        if (an.w == 0)
            continue;
        float area = dot(vec3(an.xyz), projected) / 4096.0;
        back += max(-area, 0);
        if (area <= 0)
            continue;
        front += area;
        vec3 radiance = uintBitsToFloat(bucket.source.rgb) / float(an.w);
        if (pass.bounceNumber != 0u)
            radiance += reflectedLight(vec4(bucket.color), float(an.w), volume.bounce[k].rgb, 1.0) / float(an.w);
        source += area * radiance;
    }
    float clear = 1.0 - min(1.0, max(front, back));

    vec4 transfer = vec4(source / max(1.0, front), clear);
    volume.field[fieldIndex(level, direction, local)] = floatBitsToUint(transfer);
}
