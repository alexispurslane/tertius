#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_samplerless_texture_functions : require
// The screen-space reflections at full resolution (docs/plans/screen-space-reflections.md, "The method"): one ray per
// pixel through the depth pyramid, one trilinear read of the radiance pyramid at the hit, and the reflection delta
// f · (W · C − a · k · T_s) added to the lit HDR image, which already holds k · T_s.
#include "reflection_ray.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 3, binding = 3, rgba16f) uniform image2D hdrImage;  // the lit image, read and written at this pixel only

const float TexelSide = 1.0;  // in pixels: each pixel traces its own ray

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, imageSize(hdrImage))))
        return;
    ReflectingPixel p;
    vec4 rayResult;
    if (!reflectingPixel(pixel, p) || !traceReflection(p, TexelSide, rayResult))
        return;
    vec3 delta = reflectionDelta(p, rayResult);
    vec4 lit = imageLoad(hdrImage, pixel);
    imageStore(hdrImage, pixel, vec4(clamp(lit.rgb + delta, 0.0, MaxRadiance), lit.a));
}
