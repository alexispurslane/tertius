#version 460
// The finest level of the light pyramid (light_pyramid.glsl): each pixel's guide light, the luminance of the fresh light
// that the pixel sends toward a reflection ray, as a hit reads it without its history (sentDiffuseLight in sent_light.glsl):
// this frame's actual direct diffuse scene radiance, and the glow, times the pixel's surface share. The sky holds
// none, and an impostor only its glow times its share. One invocation per pixel.
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_samplerless_texture_functions : require
#include "light_pyramid.glsl"
#include "frame.glsl"
#include "gbuffer_surface.glsl"
#include "temporal.glsl"
#include "meter.glsl"
#include "signals.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 3, binding = 0) uniform texture2D directDiffuseLight;            // actual scene radiance
layout(set = 3, binding = 1, r32f) uniform writeonly image2D destination;   // the finest level, the screen's size
layout(set = 3, binding = 2, r16ui) uniform readonly uimage2D surfaceTest;    // the pass bits (signals.glsl)
layout(set = 3, binding = 3, rgba16f) uniform readonly image2D motionTarget; // the G-buffer's motion target
#include "sent_light.glsl"

// The guide light of a pixel inside the viewport.
float guideLightAt(ivec2 pixel)
{
    if (texelFetch(gbufferDistance, pixel, 0).r <= 0.0)
        return NoLight;
    vec3 directDiffuse = vec3(0.0);
    if (texelFetch(gbufferBaseColor, pixel, 0).a != 0.0)
    {
        directDiffuse = texelFetch(directDiffuseLight, pixel, 0).rgb;
    }
    return luminance(preExposed(sentDiffuseLight(pixel, directDiffuse, surfaceReprojectionAt(pixel))));
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, imageSize(destination))))
        return;
    bool inside = all(lessThan(pixel, ivec2(frame.viewport.xy)));
    imageStore(destination, pixel, vec4(inside ? guideLightAt(pixel) : NoLight));
}
