#version 460
// The occlusion far rays pass (docs/plans/screen-space-illumination.md, "The far ray of a slice" and "The estimate of a
// texel"): one ray per slice beyond the radius, through the center of one open sector, along SSR's trace through the
// depth pyramid. Its outcome moves the slice's open share of term A, which holds the near estimate, to blocked, with
// the light of the hit. FarRay and SectorSearch in Shading/ are the C# copy. Change both together.
#extension GL_GOOGLE_include_directive : require
#include "sectors.glsl"
#include "reflection.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

// The half-resolution texel of the invocation.
ivec2 texel()
{
    return ivec2(gl_GlobalInvocationID.xy);
}

// What a far ray decides for its slice's open sectors: the share that it blocks, from 0 to 1, and that share times its
// light, pre-exposed (FarOutcome).
struct FarOutcome
{
    float blocked;
    vec3 light;
};

// The far ray from R along the view-space unit direction, one outcome per way that SSR's trace ends (decision 20).
FarOutcome farRay(GtaoTexel setup, vec3 direction)
{
    // Only a normal map tilts an open sector below the geometric surface, which blocks the ray and shows it no light.
    if (dot(direction, setup.geometricNormal) <= 0.0)
        return FarOutcome(1.0, vec3(0.0));
    vec3 start = setup.center + occlusion.radiusMeters * direction;
    // The ray leaves the view through the near plane before R, and screenRayOf divides by the start's view depth.
    if (start.z <= NearPlane)
        return FarOutcome(0.0, vec3(0.0));
    // SSR's trace works in the camera-relative world axes.
    vec3 origin = toWorldAxes(start) + toWorldAxes(setup.geometricNormal) * originOffset(start.z);
    ScreenRay ray = screenRayOf(origin, toWorldAxes(direction), start.z);
    vec2 hit;
    ivec2 hitPixel;
    // SSR's entry share fades a reflection that enters a slab from behind. A far ray that meets a slab is blocked, and
    // the facing test says whether the hit's light reaches the receiver.
    float entryShare;
    if (!traceRay(depthPyramid, ray, occlusion.farSteps, hit, hitPixel, entryShare))
        return FarOutcome(0.0, vec3(0.0));
    float fade = edgeFade(hit);
    vec3 hitDirect = texelFetch(gbufferDirect, hitPixel, 0).rgb;
    return FarOutcome(fade, fade * blockerLight(hitDirect, geometricNormalAt(hitPixel), -direction));
}

// The direction of slice g's far ray through the center of the open sector of a rank.
vec3 farRayDirection(SliceGeometry g, uint open, uint rank)
{
    float angle = sectorCenterAngle(g, openSectorOfRank(open, rank));
    return cos(angle) * g.toEye + sin(angle) * g.side;
}

// Option A of fork 2 (FarRays.OnePerSlice): each slice with an open sector traces one ray, whose outcome moves the slice's
// open share U = W · count / (32 ΣW).
vec4 farRaysPerSlice(GtaoTexel setup, float totalWeight, vec4 estimate)
{
    int stepsPerSide = int(occlusion.stepsPerSide);
    for (int slice = 0; slice < int(occlusion.slices); slice++)
    {
        SliceGeometry g = gtaoSliceGeometry(setup, slice);
        uint open = ~sectorMasks[maskIndex(texel(), slice)];
        uint count = uint(bitCount(open));
        if (count == 0u)
            continue;
        // U: the share of the texel's estimate that the slice's open sectors hold.
        float share = g.weight * float(count) / (float(SectorCount) * totalWeight);
        // The next value of the slice's R1 sequence past its steps, k + n² (SectorSearch.FarRayNoise).
        float noise = fract(setup.noise.y + float(slice + stepsPerSide * stepsPerSide) * 0.6180339887498948482);
        // The rank is below the count, so findLSB never meets 0.
        FarOutcome outcome = farRay(setup, farRayDirection(g, open, min(uint(noise * float(count)), count - 1u)));
        estimate.a -= share * outcome.blocked;
        estimate.rgb += share * outcome.light;
    }
    return estimate;
}

// Option B of fork 2 (FarRays.OnePerTexel): one ray through an open sector of any slice, rank ⌊η Σ W c⌋ of the open
// sectors in slice order, each counting its slice's weight, with η slice 0's noise (SectorSearch.TexelFarRay). Its
// outcome moves the texel's whole open share, which is the near V that term A holds (AmbientEstimate.WithTexelFarRay).
vec4 farRayPerTexel(GtaoTexel setup, vec4 estimate)
{
    int slices = int(occlusion.slices);
    float openWeight = 0.0;
    for (int slice = 0; slice < slices; slice++)
        openWeight += gtaoSliceGeometry(setup, slice).weight * float(bitCount(~sectorMasks[maskIndex(texel(), slice)]));
    int stepsPerSide = int(occlusion.stepsPerSide);
    float target = fract(setup.noise.y + float(stepsPerSide * stepsPerSide) * 0.6180339887498948482) * openWeight;
    // The loop only picks the slice and the rank. The direction, a bisection with trigonometry, is computed once after it.
    int picked = -1;
    uint pickedOpen = 0u;
    uint rank = 0u;
    for (int slice = 0; slice < slices; slice++)
    {
        float weight = gtaoSliceGeometry(setup, slice).weight;
        uint open = ~sectorMasks[maskIndex(texel(), slice)];
        uint count = uint(bitCount(open));
        float share = weight * float(count);
        if (!(share > 0.0))
            continue;
        picked = slice;
        pickedOpen = open;
        if (target < share)
        {
            // target < W · count, so the quotient is below the count up to a rounding: finite and within the uint range.
            // The rank is below the count, so findLSB never meets 0.
            rank = min(uint(target / weight), count - 1u);
            break;
        }
        // A noise that rounds up to 1 falls through every slice and keeps the last open sector of the last open slice.
        rank = count - 1u;
        target -= share;
    }
    if (picked < 0)
        return estimate;
    vec3 direction = farRayDirection(gtaoSliceGeometry(setup, picked), pickedOpen, rank);
    FarOutcome outcome = farRay(setup, direction);
    return vec4(estimate.rgb + estimate.a * outcome.light, estimate.a - estimate.a * outcome.blocked);
}

void main()
{
    if (!insideHalf(texel()))
        return;
    float z = viewDepthAt(texel());
    // Sky holds the open estimate, which the sectors pass wrote.
    if (z >= SkyDepth)
        return;
    GtaoTexel setup = gtaoTexelSetup(texel(), z, occlusion.radiusMeters / texelWidth(z));
    float totalWeight = 0.0;
    for (int slice = 0; slice < int(occlusion.slices); slice++)
        totalWeight += gtaoSliceGeometry(setup, slice).weight;
    // A texel with no weight holds the open estimate, which the sectors pass wrote (decision 17).
    if (!(totalWeight > MinTotalWeight))
        return;
    // Each invocation reads and writes its own texel only.
    vec4 estimate = imageLoad(occlusionTermA, texel());
    estimate = occlusion.farRayPerTexel != 0u ? farRayPerTexel(setup, estimate)
                                              : farRaysPerSlice(setup, totalWeight, estimate);
    imageStore(occlusionTermA, texel(), estimate);
}
