#version 460
// The ray plan of the screen tracer (docs/plans/temporal-renderer.md, section 6, "The ray budget"): one invocation per
// pixel writes the light that leaves the pixel toward a ray of each kind into the hit light image, and decides, for each kind that the pixel starts, whether it traces a ray of its own, writes the plan's bits and
// lists the pixel in the kind's own-ray list. A block's chosen pixel traces the block's ray instead. Another pixel traces
// its own ray while its history of the kind is shorter than FullRateFrames, or where the block's ray does not fit it. With
// the precise specular history, a block's reflection ray fits a pixel only inside the pixel's reflection lobe
// ("Shared reflection rays by lobe fit").
#extension GL_GOOGLE_include_directive : require
#include "screen_trace.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

#ifdef TERTIUS_PRECISE_SPECULAR_HISTORY
#include "meter.glsl"

// The share by which the exact light must leave the last frame's range around the pixel's place to move: the range of
// 3 × 3 pixels takes in the jitter at a shadow's edge, and the share the half-float rounding of the direct light under
// another pre-exposure.
const float LightChangeShare = 0.02;

// The least weight of a tap other than the nearest whose last light the record's footprint takes in: the rounding of a
// still frame's pixel place gives its other taps weights near 0, which must not widen the band of the pixel's own light
// to its neighbors'.
const float LeastFootprintWeight = 1.0 / 64.0;

// The exact light at the pixel, the light that has no noise in a still scene: the luminance of the demodulated direct
// diffuse light and of the glow that the pixel sends, with the pre-exposure undone, so that an exposure change is no light
// change. It leaves out the direct specular light, which moves with the eye, and every history, which holds noisy bounced
// light. An impostor's light is its glow, as at a hit. The sky has none: −1.
float exactLightAt(ivec2 pixel)
{
    if (texelFetch(gbufferDistance, pixel, 0).r <= 0.0)
        return -1.0;
    vec3 light = glowSent(texelFetch(gbufferEmissive, pixel, 0).rgb, lightMarkOfWord(texelFetch(gbufferShading, pixel, 0).b));
    if (texelFetch(gbufferBaseColor, pixel, 0).a != 0.0)
        light += imageLoad(directDiffuseLight, pixel).rgb;
    return luminance(light) / exposureScale();
}

// Whether the light leaves the range from `least` to `most` by more than LightChangeShare of the range's end and by more
// than `cutoff`.
bool leaves(float light, float least, float most, float cutoff)
{
    return light > most + max(most * LightChangeShare, cutoff) || light < least - max(least * LightChangeShare, cutoff);
}

// Whether the change of the light at the last frame's texel `center` covers an area of the last frame's records
// (insideChangedArea). The caller's pending change reaches its last draw, so the center's last record is changing.
bool insideChangedLastArea(ivec2 center)
{
    ivec2 last = ivec2(frame.previousViewport.xy) - 1;
    bool changing[5][5];
    for (int y = 0; y < 5; y++)
        for (int x = 0; x < 5; x++)
            changing[y][x] =
                changingLight(imageLoad(lastLightAge, clamp(center + ivec2(x - 2, y - 2), ivec2(0), last)).g);
    return insideChangedArea(changing);
}

// This frame's light-age record of the pixel: its exact light, and its age. The last record's age, pending draws and
// 3 × 3 range reproject through the surface test from the tap of the largest weight, the pixel's own place in a still
// frame, so that no age spreads to a neighbor. Its last light is the taps' weighted mean. A pixel without a history, as in a reset frame or where a surface is uncovered, is shown for the first time:
// NoLightAge. A light moves when it leaves the range of the last exact light over the 3 × 3 pixels around that tap. A move
// counts as a change only when it lasts LightChangeDraws draws in a row (ticket tiunr-okzm, ARCHITECTURE.md) and covers an
// area of the last records (insideChangedLastArea).
// Until then the record keeps its last light at the pixel's surface point, the taps' weighted mean, and counts the draws,
// and a light back inside the range drops the count. The record takes a light inside the range only near the last lights
// of its footprint, the nearest tap and the taps of weight LeastFootprintWeight or more: a light that only a neighbor's
// explains, as at an edge under jitter, would carry a pending change of the neighbors into their ranges. Otherwise the
// age grows by a frame.
// A light that the record never saw change keeps no evidence, but counts the frames that showed it: its value falls by one.
vec2 lightAgeOf(ivec2 pixel)
{
    float light = exactLightAt(pixel);
    if (light < 0.0)
        return vec2(light, NoLightAge);
    Reprojection r = reprojectionOf(lastPlaceAt(pixel), imageLoad(surfaceTest, pixel).r & 0xFu);
    if (!holdsHistory(r))
        return vec2(light, NoLightAge);
    uint nearest = 0u;
    for (uint tap = 1u; tap < 4u; tap++)
        if (r.weights[tap] > r.weights[nearest])
            nearest = tap;
    ivec2 center = tapTexel(r, nearest);
    vec2 lastRecord = imageLoad(lastLightAge, center).rg;
    // A defense only: a tap that passes the surface test shows a surface, whose last record holds a light of 0 or more.
    if (lastRecord.r < 0.0)
        return vec2(light, NoLightAge);
    ivec2 last = ivec2(frame.previousViewport.xy) - 1;
    float least = lastRecord.r;
    float most = lastRecord.r;
    for (int y = -1; y <= 1; y++)
        for (int x = -1; x <= 1; x++)
        {
            float neighbor = imageLoad(lastLightAge, clamp(center + ivec2(x, y), ivec2(0), last)).r;
            if (neighbor < 0.0)
                continue;
            least = min(least, neighbor);
            most = max(most, neighbor);
        }
    // The last light at the pixel's surface point, the weighted mean of the last records at the taps, and the range of
    // the footprint: at a still frame's pixel place both are the center's own light, up to the rounding of the place. Under motion over a
    // steep light, the light leaves the band around any one last light every draw, and the record would keep a last light
    // from which the pixel's light drifts until it leaves the 3 × 3 range (ticket tb-8zew). The center passes the defense
    // above, so the sum of the weights is more than 0.
    float lastLight = 0.0;
    float weightSum = 0.0;
    float footprintLeast = lastRecord.r;
    float footprintMost = lastRecord.r;
    for (uint tap = 0u; tap < 4u; tap++)
    {
        if (r.weights[tap] <= 0.0)
            continue;
        float recorded = imageLoad(lastLightAge, tapTexel(r, tap)).r;
        if (recorded < 0.0)
            continue;
        lastLight += r.weights[tap] * recorded;
        weightSum += r.weights[tap];
        if (r.weights[tap] >= LeastFootprintWeight)
        {
            footprintLeast = min(footprintLeast, recorded);
            footprintMost = max(footprintMost, recorded);
        }
    }
    lastLight /= weightSum;
    float age = ageOfRecord(lastRecord.g);
    float older = age < 0.0 ? max(age - 1.0, -MostLightAge - 1.0) : min(age + 1.0, MostLightAge);
    // The floor: the cutoff radiance with the pre-exposure undone, on the demodulated light. A base color of at most 1
    // shows a move no larger, so no move that a pixel shows above the cutoff escapes. The record cannot split its glow
    // from its direct light to scale only the latter by the albedo.
    float cutoff = CutoffRadiance / exposureScale();
    if (!leaves(light, least, most, cutoff))
        return vec2(leaves(light, footprintLeast, footprintMost, cutoff) ? lastLight : light, older);
    float pendingDraws = pendingDrawsOfRecord(lastRecord.g) + 1.0;
    if (pendingDraws < LightChangeDraws)
        return vec2(lastLight, recordAgeOf(older, pendingDraws));
    // A move that lasts counts as a change only over an area (insideChangedArea): one on a line one or two pixels wide, as
    // the jitter makes at a still feature thinner than a pixel, becomes the record's light, and the age goes on. The
    // change takes age 0, not the pending draws: those draws blended the new light into the receivers' histories, and a
    // cut to their count would keep the old light that the histories still hold.
    return vec2(light, insideChangedLastArea(center) ? 0.0 : older);
}

#endif

// The length of the pixel's history of the kind at its place in the last frame, in frames: the slow history's alpha,
// through the reprojection of the surface place, its taps, pass bits and weights, as the accumulator reads it. The
// specular signal's plan reads the surface place alone, because the reflected place needs this frame's hit distance.
float historyLengthOf(SignalReprojections r, uint kind)
{
    return kind == KindDiffuse ? slowDiffuseAt(r.diffuse).a : slowSpecularAt(r.specular).a;
}

// Writes the hit light of both kinds at the pixel.
void storeHitLight(ivec2 pixel, LeavingLight leaving)
{
    float moved = 0.0;
#ifdef TERTIUS_PRECISE_SPECULAR_HISTORY
    moved = movedSurfaceAt(pixel) ? 1.0 : 0.0;
#endif
    imageStore(hitLight, ivec3(pixel, KindReflection), vec4(leaving.reflection, moved));
    imageStore(hitLight, ivec3(pixel, KindDiffuse), vec4(leaving.diffuse, moved));
}

#ifdef TERTIUS_PRECISE_SPECULAR_HISTORY
// The share of a reflection lobe's width within which a pixel's mirror direction and its block's chosen pixel's must lie
// for the pixel to take the block's reflection ray (ticket ter-4oow).
const float LobeFitShare = 0.5;

// Whether the block's reflection ray from its chosen pixel c lies inside the pixel p's own reflection lobe: the two
// pixels' mirror directions, each its view direction reflected about its lobe normal, lie within LobeFitShare of the
// reflected lobe's width, 2 atan α, apart (docs/plans/temporal-renderer.md, section 6, "Shared reflection rays by lobe
// fit"). The chord between the directions keeps its precision at the roughness floor's lobe of 0.004 rad, and up to
// MaxRoughness it stays within 0.25 % of its angle. The bound is the angle, not its chord through sin, whose absolute
// error the Vulkan spec allows up to 2^-11, half the bound at the roughness floor.
bool insideLobe(TracingPixel p, TracingPixel c)
{
    return distance(reflect(-p.V, p.normal), reflect(-c.V, c.normal)) <= 2.0 * LobeFitShare * atan(p.alpha);
}
#endif

// Whether the block's ray of the kind from its chosen pixel c fits the pixel p: c's plane passes p's surface point within
// the thickness, and their geometric normals lie within 25°. With the precise specular history, a reflection ray must
// also lie inside p's reflection lobe.
bool fits(TracingPixel p, TracingPixel c, uint kind)
{
    bool fit = abs(dot(p.point - c.point, c.s.geometricNormal)) <= ThicknessShare * p.viewDepth
        && dot(p.s.geometricNormal, c.s.geometricNormal) >= SameNormalCosine;
#ifdef TERTIUS_PRECISE_SPECULAR_HISTORY
    fit = fit && (kind != KindReflection || insideLobe(p, c));
#endif
    return fit;
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(vec2(pixel), frame.viewport.xy)))
        return;
#ifdef TERTIUS_PRECISE_SPECULAR_HISTORY
    vec2 record = lightAgeOf(pixel);
    imageStore(lightAge, pixel, vec4(record, 0.0, 0.0));
#endif
    uint plan = 0u;
    if (tracedSurface(pixel))
    {
        // The hit light shares the pixel's material and reprojections with the plan's decisions (leavingLightAt).
        TracingPixel p = tracingPixelAt(pixel);
        SignalReprojections r = reprojectionsAt(pixel);
        storeHitLight(pixel, leavingLightOf(pixel, p.s, p.V, r));
        for (uint kind = KindReflection; kind <= KindDiffuse; kind++)
        {
            ivec2 chosen;
            TracingPixel c;
            // A pixel that starts the kind gives its block a chosen pixel.
            if (!startsKind(p, kind) || !chosenPixelOf(pixel / 2, kind, chosen, c) || all(equal(chosen, pixel)))
                continue;
            if (historyLengthOf(r, kind) >= FullRateFrames && fits(p, c, kind))
                continue;
            if (kind == KindReflection)
            {
                plan |= PlanOwnReflection;
                APPEND_OWN_RAY(reflectionOwnRays, pixel)
            }
            else
            {
                plan |= PlanOwnDiffuse;
                APPEND_OWN_RAY(diffuseOwnRays, pixel)
            }
        }
    }
    // An impostor sends its glow alone. The sky's hit light stays as it is, because no walk hits it.
    else if (hittable(pixel))
        storeHitLight(pixel, LeavingLight(glowAt(pixel), glowAt(pixel)));
    imageStore(rayPlan, pixel, uvec4(plan));
}
