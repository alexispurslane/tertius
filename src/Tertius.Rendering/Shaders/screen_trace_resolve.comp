#version 460
// The resolve of the screen tracer (docs/plans/temporal-renderer.md, section 6, "The resolve"): one invocation per pixel
// writes the pixel's diffuse and specular samples from its own ray of each kind, where the plan gave it one, or else from
// its block's ray, reweighted for the pixel. A pixel above the hand-over band takes its specular sample from its diffuse
// ray alone, and one inside the band blends the two estimates by its roughness ("Rough reflections reuse the diffuse
// rays").
#extension GL_GOOGLE_include_directive : require
#include "screen_trace.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

// The ray of the kind for the pixel: its own ray's record where the plan gave it one, or else its block's.
RayRecord recordAt(ivec2 pixel, uint kind, uint plan)
{
    bool own = (plan & (kind == KindReflection ? PlanOwnReflection : PlanOwnDiffuse)) != 0u;
    ivec3 at = ivec3(own ? pixel : pixel / 2, kind);
    RayRecord record;
    record.light = own ? imageLoad(ownLight, at) : imageLoad(blockLight, at);
    record.ray = own ? imageLoad(ownRay, at) : imageLoad(blockRay, at);
    return record;
}

// A ray of the record that the pixel weighs: its direction and the density by which the pixel weighs it.
struct WeighedRay
{
    vec3 direction;
    float density;
    bool brings;    // whether the ray traced and lies above the pixel's geometric plane: only then does it bring light
};

// The ray of the record of the kind at the pixel. A reflection ray counts with the pixel's own density along its
// direction: the record's density for the pixel's own ray, and for its block's ray the density of the pixel's own lobe,
// not the density of the pixel that traced it (ticket ter-xo83). Where the two densities differ, as near a contact, their
// quotient made the weight noisy. The own density keeps the record's floor: below LeastDensity it is 0, so that no
// divisor is a denormal. A diffuse ray counts with the record's density.
WeighedRay weighedRayOf(TracingPixel p, RayRecord record, uint kind, uint plan)
{
    WeighedRay ray;
    ray.direction = directionOfCode(record.ray.xy);
    ray.density = densityOfCode(record.ray.z);
    if (kind == KindReflection && (plan & PlanOwnReflection) == 0u)
    {
        float own = reflectionDensity(p, ray.direction);
        ray.density = own >= LeastDensity ? own : 0.0;
    }
    ray.brings = (record.ray.w & RayTraced) != 0u && dot(ray.direction, p.s.geometricNormal) > 0.0 && ray.density > 0.0;
    return ray;
}

// The weight of a ray's light in the pixel's diffuse sample: the pixel's density cos θ / π along the ray over the ray's
// density, at most MostRayWeight. Without the guided rays it is 1 for the pixel's own ray, and for a block ray
// max(0, n_p·ω) / max(2^-14, n_c·ω). The guided rays' mixture density lowers it where the guided density is above 0, and
// raises it to 1 / (1 - g) times that on a miss (ARCHITECTURE.md, "Guided diffuse rays").
float diffuseWeightOf(TracingPixel p, WeighedRay ray)
{
    return min(max(dot(p.normal, ray.direction), 0.0) / max(PI * ray.density, LeastRayCosine), MostRayWeight);
}

// The weight of a ray's light in the pixel's specular sample: the pixel's f_s(ω) cos θ over the ray's density, divided by
// the specular factor (Stachowiak 2015), at most MostRayWeight. For the pixel's own reflection ray it is
// F(v·h) G2 / (G1 E), whose mean over the lobe is 1.
vec3 specularWeightOf(TracingPixel p, SurfaceLobes lobes, MaterialFactors factors, WeighedRay ray)
{
    vec3 response = p.s.model == ShadingHair ? hairResponse(p.s, lobes, p.V, ray.direction).specular
        : specularResponse(lobes, p.s.normal, p.V, ray.direction, 0.0);
    return min(response / (ray.density * max(factors.specular, vec3(LeastFactor))), vec3(MostRayWeight));
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(vec2(pixel), frame.viewport.xy)))
        return;
#ifdef TERTIUS_PRECISE_SPECULAR_HISTORY
    imageStore(lightChangeMask, pixel, vec4(lightChangeMaskAt(pixel), 0.0, 0.0, 0.0));
#endif
    if (!tracedSurface(pixel))
    {
        // The sky and the impostors: no signal, and the composite reads none there.
        imageStore(diffuseSample, pixel, vec4(0.0));
        imageStore(specularSample, pixel, vec4(0.0));
#ifdef TERTIUS_PRECISE_SPECULAR_HISTORY
        imageStore(specularSampleAge, pixel, uvec4(0u));
#endif
#ifdef TERTIUS_LIGHT_AGE_DIAGNOSTIC
        imageStore(uncoveredDiagnostic, pixel, vec4(-1.0, 0.0, 0.0, 0.0));
#endif
        return;
    }
    TracingPixel p = tracingPixelAt(pixel);
    uint plan = imageLoad(rayPlan, pixel).r;
    SurfaceLobes lobes = lobesOf(p.s, p.V);
    MaterialFactors factors = materialFactors(p.s, lobes);

    RayRecord diffuse = recordAt(pixel, KindDiffuse, plan);
    WeighedRay diffuseRay = weighedRayOf(p, diffuse, KindDiffuse, plan);
    vec3 diffuseLight = diffuseRay.brings ? diffuse.light.rgb * diffuseWeightOf(p, diffuseRay) : vec3(0.0);
    // Capped as the specular sample is: a light at MaxRadiance times a weight of up to 4 passes the largest half float.
    imageStore(diffuseSample, pixel, vec4(min(diffuseLight, vec3(MaxRadiance)), 1.0));

    // The share of the diffuse ray's estimate in the specular sample: 0 below the hand-over band, 1 above it.
    float handOver = clamp((sqrt(p.alpha) - trace.handOverStart) / (trace.maxRoughness - trace.handOverStart), 0.0, 1.0);
    vec3 specularLight = vec3(0.0);
#ifdef TERTIUS_PRECISE_SPECULAR_HISTORY
    // The youngest age code of the rays that the specular sample takes light from, 0 where none brings an age.
    uint ageCode = 0u;
#endif
#ifdef TERTIUS_LIGHT_AGE_DIAGNOSTIC
    // The fewest frames seen plus 1 of the never-changed surfaces that those rays hit, 0 where none hits one.
    uint seenCode = 0u;
#endif
    if (handOver > 0.0 && diffuseRay.brings)
    {
        specularLight = handOver * diffuse.light.rgb * specularWeightOf(p, lobes, factors, diffuseRay);
#ifdef TERTIUS_PRECISE_SPECULAR_HISTORY
        ageCode = ageCodeOfRecord(diffuse.ray);
#endif
#ifdef TERTIUS_LIGHT_AGE_DIAGNOSTIC
        seenCode = seenCodeOfRecord(diffuse.ray);
#endif
    }
    float hitDistance = diffuse.light.a;
    vec3 diagHit = diffuse.light.rgb;
    float diagOwn = (plan & PlanOwnDiffuse) != 0u ? 1.0 : 0.0;
    if (startsKind(p, KindReflection))
    {
        RayRecord reflection = recordAt(pixel, KindReflection, plan);
        WeighedRay reflectionRay = weighedRayOf(p, reflection, KindReflection, plan);
        if (reflectionRay.brings)
        {
            specularLight += (1.0 - handOver) * reflection.light.rgb * specularWeightOf(p, lobes, factors, reflectionRay);
#ifdef TERTIUS_PRECISE_SPECULAR_HISTORY
            uint reflectionCode = ageCodeOfRecord(reflection.ray);
            if (handOver < 1.0 && reflectionCode != 0u)
                ageCode = ageCode == 0u ? reflectionCode : min(ageCode, reflectionCode);
#endif
#ifdef TERTIUS_LIGHT_AGE_DIAGNOSTIC
            uint reflectionSeen = seenCodeOfRecord(reflection.ray);
            if (handOver < 1.0 && reflectionSeen != 0u)
                seenCode = seenCode == 0u ? reflectionSeen : min(seenCode, reflectionSeen);
#endif
        }
        hitDistance = reflection.light.a;
#ifdef TERTIUS_LIGHT_AGE_DIAGNOSTIC
        // THROWAWAY DIAGNOSTIC (t8-pkag): the record's hit pixel, its distance in 0.1 mm, and whether it is the pixel's own.
        diagHit = reflection.light.rgb;
        diagOwn = (plan & PlanOwnReflection) != 0u ? 1.0 : 0.0;
#endif
    }
    imageStore(specularSample, pixel, vec4(min(specularLight, vec3(MaxRadiance)), hitDistance));
#ifdef TERTIUS_PRECISE_SPECULAR_HISTORY
    imageStore(specularSampleAge, pixel, uvec4(ageCode));
#endif
#ifdef TERTIUS_LIGHT_AGE_DIAGNOSTIC
    imageStore(uncoveredDiagnostic, pixel, vec4(float(seenCode) + 64.0 * diagOwn + 128.0 * (1.0 + diagHit.x + 256.0 * diagHit.y) - 1.0, 0.0, 0.0, 0.0));
    imageStore(specularSample, pixel, vec4(min(specularLight, vec3(MaxRadiance)), seenCode != 0u ? diagHit.z : 0.0));
#endif
}
