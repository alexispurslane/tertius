#version 460
// The temporal dispatch of an accumulation (docs/plans/temporal-renderer.md, section 8, "The model", steps 1 and 2): one
// invocation per pixel reprojects the last frame's slow and fast histories through the surface test, rescales them by the
// exposure ratio and blends the sample in. The specular signal also tests the reflected point's place and that place's
// hit distances (section 8, "The specular signal's own tests"). It writes the slow history into the scratch image, so that
// the spatial dispatch reads the neighbors' results while it writes the slow history, and this frame's fast history. The
// diffuse signal's fast history keeps in alpha the retained deviation: the standard deviation of the luminance of the
// samples that the slow history averages, weighted as it weighs them (docs/plans/bounce-light-confidence.md, section 6).
// The clamp's box and the diffuse filter read it. The reflections keep theirs in an image of their own beside a precise
// history, because their fast history's alpha holds the hit distance. With the block test, each workgroup also sums its
// block's differences of the fast and the slow history into its texel of the block sums, which the spatial dispatch tests
// (section 8).
#extension GL_GOOGLE_include_directive : require
#include "accumulate.glsl"
#define ACCUMULATE_BLOCK_SUMS
#include "accumulate_blocks.glsl"
#include "accumulate_reflection_guide.glsl"
#include "gbuffer_surface.glsl"
#include "meter.glsl"
#include "motion.glsl"
#include "neighbor_limit_prototype.glsl"

// The draws of the retained deviation's window: the bounce cap. A half-float store cannot follow a weight below about
// 2^−11, so an uncapped history takes this window too.
const float DeviationFrames = 32.0;

// The share of the fast history's luminance within which a sample's weighted step is the store's rounding, not noise. A
// half-float blend of the weight w stops within about 1 / w half-float steps of a constant sample where the store rounds
// toward zero, as the spec allows, and a step is at most 2^−10 of a value: a weighted step of at most (4 / 3) 2^−10.
const float BlendRounding = 1.0 / 768.0;

// The share of the larger of two hit distances by which they may differ for a tap to pass.
const float HitDistanceShare = 0.5;

#ifdef TERTIUS_LIGHT_AGE
// The sample's light age (tickets tiunr-py6q and ter-wkvw, TemporalSignal.SampleAge): 0 for no evidence, else the age in
// frames of the youngest light that its rays hit, plus 1.
layout(set = 3, binding = 11, r16ui) uniform readonly uimage2D sampleAge;

// The least share of the slow history's luminance that a sample must hold for its age to cut the history: a dim ray does
// not speak for the light that the history holds.
const float AgeCutShare = 0.25;
#endif

#ifdef TERTIUS_LIGHT_AGE_DIAGNOSTIC
// The diagnostic of uncovered surfaces (TemporalSignal.UncoveredDiagnostic): the resolve wrote r, and this dispatch keeps
// it and writes the length just before the blend, whether the sample holds the cut share, and the length before the cut.
layout(set = 3, binding = 12, rgba32f) uniform image2D uncoveredDiagnostic;
#endif

#ifdef TERTIUS_ACCUMULATION_TRACE
// The place flags of the invocation's historyPlaceOf (accumulate.glsl), and the place that won in texels of the last
// frame's image, as reprojectionOf takes it.
uint tracedPlace = 0u;
vec2 tracedTexelPlace = vec2(0.0);
// Flags of layer 0 past accumulate.glsl's (ticket tiunr-wk29), which only this dispatch writes: the surface place is the
// pixel place (screen.glsl's pixel rule), and the tried reflected place is its pixel place.
const uint TracedPixelPlaceRead = 1u << 10;
const uint TracedReflectedPixelPlaceRead = 1u << 11;

// The pixel rule's choices of the invocation's historyPlaceOf: TracedPixelPlaceRead and TracedReflectedPixelPlaceRead.
uint tracedPixelPlaces = 0u;
#endif

// The place in the last frame's image of a point relative to this frame's eye, or a place outside it for a point
// behind the last frame's eye.
vec2 lastPlaceOf(vec3 clip)
{
    return clip.z > 0.0 ? 0.5 * clip.xy / clip.z + 0.5 - frame.previousJitter.xy * frame.previousViewport.zw : NoHistoryMotion;
}

// Whether two hit distances, in m with 0 for a miss, show the same hit: two misses, or two hits within HitDistanceShare
// of the larger.
bool sameHit(float stored, float current)
{
    if (stored <= 0.0 || current <= 0.0)
        return stored <= 0.0 && current <= 0.0;
    return abs(stored - current) <= HitDistanceShare * max(stored, current);
}

// The pass bits of a reprojection's taps whose stored hit distance shows the sample's hit.
uint sameHitBits(Reprojection r, uint bits, float hitDistance)
{
    uint kept = 0u;
    for (uint tap = 0u; tap < 4u; tap++)
        if ((bits & (1u << tap)) != 0u && sameHit(imageLoad(lastFast, tapTexel(r, tap)).a, hitDistance))
            kept |= 1u << tap;
    return kept;
}

// The reflected place's reprojection through the taps of `bits`, with its hit distance test.
Reprojection reflectedReprojectionOf(vec2 place, uint bits, float hitDistance)
{
    Reprojection r = reprojectionOf(place, bits);
    return reprojectionOf(place, sameHitBits(r, bits, hitDistance));
}

HISTORY_READER(lastFastAt, lastFast)
HISTORY_READER(lastSlowAt, slowHistory)
HISTORY_READER(lastReflectionGuideAt, reflectionGuide)

#ifdef TERTIUS_PRECISE_SPECULAR_HISTORY
// The reflections' retained deviation beside a precise history (TemporalSignal.DeviationImage): the last draw's and this
// draw's. Only the reflections take the precise shaders, and their block test of drops pools it.
layout(set = 3, binding = 14, r16f) uniform readonly image2D lastDeviation;
layout(set = 3, binding = 15, r16f) uniform writeonly image2D deviationHistory;

HISTORY_READER(lastDeviationAt, lastDeviation)
#endif

// The last draw's retained deviation, reprojected as `r` reprojects the fast history `lastFast4`: the diffuse light's in
// that history's alpha, the reflections' in their own image beside a precise history, and 0 without one.
float retainedDeviationAt(Reprojection r, vec4 lastFast4)
{
    if (parameters.light == DiffuseLight)
        return lastFast4.a;
#ifdef TERTIUS_PRECISE_SPECULAR_HISTORY
    return lastDeviationAt(r).r;
#else
    return 0.0;
#endif
}

// Stores this draw's retained deviation of the reflections beside a precise history, whose fast history's alpha holds the
// hit distance.
void storeRetainedDeviation(ivec2 pixel, float deviation)
{
#ifdef TERTIUS_PRECISE_SPECULAR_HISTORY
    if (parameters.light == SpecularLight)
        imageStore(deviationHistory, pixel, vec4(deviation));
#endif
}

// The mean luminance of this frame's finite samples on the same surface over the 3 × 3 pixels around the pixel.
float meanSampleLuminance(ivec2 pixel)
{
    SurfaceKey key = surfaceKeyAt(pixel);
    float sum = 0.0;
    float count = 0.0;
    for (int y = -1; y <= 1; y++)
        for (int x = -1; x <= 1; x++)
        {
            ivec2 neighbor = pixel + ivec2(x, y);
            if (!insideImages(neighbor) || !sameSurface(key, surfaceKeyAt(neighbor)))
                continue;
            vec3 sampled = imageLoad(sampleImage, neighbor).rgb;
            if (!finiteSample(sampled))
                continue;
            sum += luminance(sampled);
            count += 1.0;
        }
    return count > 0.0 ? sum / count : 0.0;
}

// The reflected point's place (section 8, "The specular signal's own tests"): where a flat mirror shows the hit, behind
// the mirror along the view ray, or for a miss the view direction's place, as for the sky.
vec2 reflectedPlaceOf(vec3 point, float hitDistance)
{
    vec3 toSurface = normalize(point);
    if (hitDistance <= 0.0)
        return lastPlaceOf((frame.previousViewProj * vec4(toSurface, 0.0)).xyw);
    return lastPlaceOf(lastClipOf(point + toSurface * hitDistance - frame.previousEye.xyz));
}

// The reflected point's pixel place (screen.glsl's pixel history rule): its place as reflectedPlaceOf gives it, with this
// frame's jitter in place of the last frame's, so that a still point's place is the center of the pixel whose jittered
// sample sees it.
vec2 pixelReflectedPlaceOf(vec3 point, float hitDistance)
{
    return reflectedPlaceOf(point, hitDistance) + frame.previousJitter.xy * frame.previousViewport.zw
        - frame.renderParams.yz * frame.viewport.zw;
}

// The place whose history the pixel reprojects: the surface place, or below reflectedPlaceBelow also the reflected
// point's place, whichever passes, and of two that pass the one whose fast history lies nearer this frame's samples. A
// pixel without a sample has no hit distance to test, so it takes the surface place.
Reprojection historyPlaceOf(ivec2 pixel, float roughness, bool hasSample, float hitDistance)
{
    uint bits = imageLoad(surfaceTest, pixel).r;
    vec4 motion = imageLoad(motionTarget, pixel);
    vec2 samplePlace = historyPlace(vec2(pixel) + 0.5, motion.xy);
    vec2 surfacePlace = readPlace(vec2(pixel) + 0.5, motion);
    bool specular = parameters.light == SpecularLight;
    bool tryReflected = specular && hasSample && roughness < parameters.reflectedPlaceBelow;
    // The specular signal takes the taps that pass the specular test, bits 4 to 7.
    uint surfaceBits = specular ? (bits >> 4) & 0xFu : bits & 0xFu;
    Reprojection surface = reprojectionOf(surfacePlace, surfaceBits);
#ifdef TERTIUS_ACCUMULATION_TRACE
    tracedPlace = holdsHistory(surface) ? TracedSurfaceHolds : 0u;
    tracedTexelPlace = surfacePlace * frame.previousViewport.xy - 0.5;
    tracedPixelPlaces = motion.w != 0.0 ? TracedPixelPlaceRead : 0u;
#endif
    if (!tryReflected || parameters.reset != 0u)
        return surface;

    vec3 viewRay = viewRayThrough(vec2(pixel) + 0.5);
    float distanceToEye = texelFetch(gbufferDistance, pixel, 0).r;
    vec3 point = normalize(viewRay) * distanceToEye;
    // The pixel's last point, as the surface test rebuilds it: the mirror's point in the last frame.
    vec3 lastPoint = lastViewRayThrough(samplePlace) * (distanceToEye / length(viewRay) * motion.z);
    vec3 normal = octDecode(texelFetch(gbufferNormal, pixel, 0).ba);
    // The reflected place follows the rule of the surface place (signals.glsl).
    HistoryTaps taps = historyTaps(lastSurfaceHistory, lastDeviceDepth, reflectedPlaceOf(point, hitDistance),
        pixelReflectedPlaceOf(point, hitDistance), lastPoint, normal, roughness);
    vec2 reflectedPlace = taps.place;
    uint reflectedBits = (taps.bits >> 4) & 0xFu;
#ifdef TERTIUS_ACCUMULATION_TRACE
    tracedPixelPlaces |= taps.pixel ? TracedReflectedPixelPlaceRead : 0u;
#endif
    Reprojection reflected = reflectedReprojectionOf(reflectedPlace, reflectedBits, hitDistance);
#ifdef TERTIUS_ACCUMULATION_TRACE
    tracedPlace = TracedReflectedTried | (holdsHistory(surface) ? TracedSurfaceHolds : 0u)
        | (holdsHistory(reflected) ? TracedReflectedHolds : 0u);
#endif
    if (!holdsHistory(reflected))
        return surface;
    if (!holdsHistory(surface))
    {
#ifdef TERTIUS_ACCUMULATION_TRACE
        tracedPlace |= TracedReflectedWon;
        tracedTexelPlace = reflectedPlace * frame.previousViewport.xy - 0.5;
#endif
        return reflected;
    }
    float mean = meanSampleLuminance(pixel);
    float surfaceOff = abs(luminance(lastFastAt(surface).rgb) - mean);
    float reflectedOff = abs(luminance(lastFastAt(reflected).rgb) - mean);
#ifdef TERTIUS_ACCUMULATION_TRACE
    if (reflectedOff < surfaceOff)
    {
        tracedPlace |= TracedReflectedWon;
        tracedTexelPlace = reflectedPlace * frame.previousViewport.xy - 0.5;
    }
#endif
    return reflectedOff < surfaceOff ? reflected : surface;
}

#ifdef TERTIUS_ACCUMULATION_TRACE
// The sum of the bilinear weights of the taps of `bits` around a place.
float tracedWeightOf(vec2 place, uint bits)
{
    return dot(reprojectionOf(place, bits).weights, vec4(1.0));
}

// Layer 8 (ticket tiunr-wk29): the weights of the taps that pass at the pixel's two places, as the surface test
// (surface_test.comp) tests them against the pixel's exact last point: the pixel place's under the surface test and the
// sample place's, then the same under the specular test. The pixel place is screen.glsl's pixelPlace. A place outside the
// last frame's image, and every place of a frame that resets, holds no weight.
vec4 tracedPlaceWeights(ivec2 pixel)
{
    vec2 center = vec2(pixel) + 0.5;
    vec3 ray = viewRayThrough(center);
    float depth = texelFetch(gbufferDistance, pixel, 0).r / length(ray);
    vec3 normal = octDecode(texelFetch(gbufferNormal, pixel, 0).ba);
    float roughness = texelFetch(gbufferSpecular, pixel, 0).g;
    vec4 motion = imageLoad(motionTarget, pixel);
    vec2 samplePlace = historyPlace(center, motion.xy);
    vec2 ownPlace = pixelPlace(center, motion.xy);
    vec3 lastPoint = lastViewRayThrough(samplePlace) * (depth * motion.z);
    uint sampleBits = 0u;
    uint ownBits = 0u;
    if (parameters.reset == 0u)
    {
        if (all(greaterThanEqual(samplePlace, vec2(0.0))) && all(lessThanEqual(samplePlace, vec2(1.0))))
            sampleBits = surfaceTaps(lastSurfaceHistory, lastDeviceDepth, samplePlace, lastPoint, normal, roughness);
        if (all(greaterThanEqual(ownPlace, vec2(0.0))) && all(lessThanEqual(ownPlace, vec2(1.0))))
            ownBits = surfaceTaps(lastSurfaceHistory, lastDeviceDepth, ownPlace, lastPoint, normal, roughness);
    }
    return vec4(tracedWeightOf(ownPlace, ownBits & 0xFu), tracedWeightOf(samplePlace, sampleBits & 0xFu),
        tracedWeightOf(ownPlace, (ownBits >> 4) & 0xFu), tracedWeightOf(samplePlace, (sampleBits >> 4) & 0xFu));
}
#endif

// Steps 1 and 2 at a pixel inside the images: the pixel's share of its block's sums (accumulate_blocks.glsl), 0 where it
// does not contribute.
vec4 accumulateAt(ivec2 pixel)
{
    if (texelFetch(gbufferDistance, pixel, 0).r <= 0.0)
    {
        // The sky: no signal, and no reader reads it.
        imageStore(scratch, pixel, vec4(0.0));
        imageStore(fastHistory, pixel, vec4(0.0));
        storeRetainedDeviation(pixel, 0.0);
        if (reflectionSharingPrototype && parameters.light == SpecularLight)
            imageStore(reflectionGuideScratch, pixel, vec4(0.0));
#ifdef TERTIUS_ACCUMULATION_TRACE
        for (int layer = 0; layer < 4; layer++)
            storeTrace(pixel, layer, vec4(0.0));
        storeTrace(pixel, 8, vec4(0.0));
#endif
        return vec4(0.0);
    }

    vec4 sample4 = imageLoad(sampleImage, pixel);
    vec3 sampled = limitIncomingEstimate(pixel, sample4.rgb);
    bool hasSample = finiteSample(sampled);
    // The specular signal's sample holds its hit distance in alpha, 0 for a miss.
    float hitDistance = parameters.light == SpecularLight && hasSample && !isnan(sample4.a) ? sample4.a : 0.0;
    float roughness = roughnessAt(pixel);
    float cap = capAt(roughness);

    // Step 1: the bilinear weights of the place over the 2 × 2 texels of the last frame's images around it, times the
    // pass bits. A failing tap and a tap outside the last image hold no weight: the surface test fails it.
    Reprojection r = historyPlaceOf(pixel, roughness, hasSample, hitDistance);
    vec4 slow = lastSlowAt(r);
    vec4 lastFast4 = lastFastAt(r);
    vec3 fast = lastFast4.rgb;
    float deviation = retainedDeviationAt(r, lastFast4);
    vec2 guide = vec2(0.0);
    if (reflectionSharingPrototype && parameters.light == SpecularLight)
        guide = lastReflectionGuideAt(r).rg;

#ifdef TERTIUS_ACCUMULATION_TRACE
    // Layers 1 to 3: the taps' weights; where tap 0 lies relative to the pixel, the hit distance and the sample's
    // luminance; the least and the most length of the taps that hold weight, and the luminance of the reprojected fast
    // and slow histories before the exposure ratio, 0 without a history.
    uint tracedTaps = 0u;
    float leastTapLength = 0.0;
    float mostTapLength = 0.0;
    for (uint tap = 0u; tap < 4u; tap++)
        if (r.weights[tap] > 0.0)
        {
            float tapLength = imageLoad(slowHistory, tapTexel(r, tap)).a;
            leastTapLength = tracedTaps == 0u ? tapLength : min(leastTapLength, tapLength);
            mostTapLength = tracedTaps == 0u ? tapLength : max(mostTapLength, tapLength);
            tracedTaps |= 1u << tap;
        }
    storeTrace(pixel, 1, r.weights);
    storeTrace(pixel, 2, vec4(tracedTexelPlace - vec2(pixel), hitDistance, hasSample ? luminance(sampled) : 0.0));
    storeTrace(pixel, 3, vec4(leastTapLength, mostTapLength, luminance(fast), luminance(slow.rgb)));
    float lastAccepted = imageLoad(slowHistory, pixel).a;
    bool tracedHasSample = hasSample;
#endif

    float historyLength = 0.0;
    if (holdsHistory(r))
    {
        // Both histories hold pre-exposed light: the ratio 2^(S − S_last) keeps them in this frame's scale. A rise of more
        // than about one stop takes a history at MaxRadiance past the largest half float, so `exposed` caps the product at
        // MaxRadiance before it. Its bounds hold for a ratio of at most 2^64, and two exposures can lie 128 stops apart.
        float ratio = historyRatio(exposureStops, previousStops);
        // A length above this pixel's cap, from a neighbor of another roughness, is cut to it.
        historyLength = min(slow.a, cap);
        slow.rgb = exposed(slow.rgb, ratio);
        fast = exposed(fast, ratio);
        deviation = min(deviation * ratio, MaxRadiance);
    }

#ifdef TERTIUS_LIGHT_AGE
    // The light-change age: the history keeps no more frames than the age of the light that the sample's rays see, so
    // after the blend it holds only frames from after the change.
#ifdef TERTIUS_LIGHT_AGE_DIAGNOSTIC
    float uncutLength = historyLength;
#endif
    uint ageCode = imageLoad(sampleAge, pixel).r;
    if (hasSample && ageCode != 0u && luminance(sampled) >= AgeCutShare * luminance(slow.rgb))
        historyLength = min(historyLength, float(ageCode - 1u));
#ifdef TERTIUS_LIGHT_AGE_DIAGNOSTIC
    bool holdsCutShare = hasSample && luminance(sampled) >= AgeCutShare * luminance(slow.rgb);
    imageStore(uncoveredDiagnostic, pixel, vec4(imageLoad(uncoveredDiagnostic, pixel).r,
        hasSample ? historyLength : -1.0, holdsCutShare ? 1.0 : 0.0, uncutLength));
#endif
#endif

#ifdef TERTIUS_ACCUMULATION_TRACE
    // Layer 0: the length that the last draw accepted at this texel, the length before the blend, the sum of the taps'
    // weights and the flags.
    storeTrace(pixel, 0, vec4(lastAccepted, historyLength, dot(r.weights, vec4(1.0)),
        float(tracedTaps | tracedPlace | tracedPixelPlaces | (tracedHasSample ? TracedSample : 0u) | TracedSurfacePixel)));
    storeTrace(pixel, 8, tracedPlaceWeights(pixel));
#endif

    // Step 2. A sample that is not finite counts as no sample: the pixel keeps its history and its length. Without a
    // history, it takes the closed form.
    if (!hasSample && historyLength == 0.0)
    {
        IndirectLight closed = closedForm(withAmbientFootprint(materialAt(pixel), pixel),
            -normalize(viewRayThrough(vec2(pixel) + 0.5)));
        sampled = parameters.light == SpecularLight ? closed.specular : closed.diffuse;
        hasSample = true;
    }
    if (hasSample)
    {
        historyLength = min(historyLength + 1.0, cap);
        // The retained deviation: the exponential update of the variance with the sample's weight w is
        // (1 − w) (variance + w step²), 0 for the first sample (Finch 2009). Updated from the step, not from the mean of
        // the squares, so that samples without noise keep exactly 0. The step goes from the fast history, the mean of the
        // pixel's own samples, because the diffuse filter writes the light that it moves into the slow history: a step
        // from that light would count a stable edge's moved light as spread and hold the luminance stop open across it.
        float before = luminance(fast);
        float weight = 1.0 / min(historyLength, DeviationFrames);
        float step = luminance(sampled) - before;
        step = abs(step) * weight <= BlendRounding * before ? 0.0 : step;
        deviation = min(sqrt((1.0 - weight) * (deviation * deviation + weight * step * step)), MaxRadiance);
        // The weight 1 / length, written as a step toward the sample, so that a sample equal to the history leaves it
        // exact. A length of 1 takes the sample itself.
        slow.rgb = historyLength <= 1.0 ? sampled : slow.rgb + (sampled - slow.rgb) / historyLength;
        if (reflectionSharingPrototype && parameters.light == SpecularLight)
        {
            vec2 sampledGuide = reflectionDistanceSample(hitDistance);
            guide = historyLength <= 1.0 ? sampledGuide : guide + (sampledGuide - guide) / historyLength;
        }
        float fastLength = min(historyLength, fastCapOf(cap));
        fast = fastLength <= 1.0 ? sampled : fast + (sampled - fast) / fastLength;
    }
    imageStore(scratch, pixel, vec4(slow.rgb, historyLength));
    imageStore(fastHistory, pixel, vec4(fast, parameters.light == SpecularLight ? hitDistance : deviation));
    storeRetainedDeviation(pixel, deviation);
    if (reflectionSharingPrototype && parameters.light == SpecularLight)
        imageStore(reflectionGuideScratch, pixel, vec4(guide, 0.0, 0.0));
    // A pixel contributes to the block test where the clamp acts: past the fast cap, a history averages more draws than
    // its fast history.
    float fastLength = fastCapOf(cap);
    if (historyLength <= fastLength)
        return vec4(0.0);
    return blockShareOf(luminance(fast), luminance(slow.rgb), deviation, historyLength, fastLength);
}

// Every invocation reaches the block test's barriers: a pixel outside the images or of the sky contributes nothing.
void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    vec4 share = vec4(0.0);
    if (insideImages(pixel))
        share = accumulateAt(pixel);
    if (parameters.blockTest != 0u)
        blockSumsStore(share);
}
