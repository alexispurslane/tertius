#version 460
// Level 0 of the radiance pyramid (docs/plans/screen-space-reflections.md, "The radiance pyramid"): the lit image without
// the glow of an entity that holds a light, times the surface coverage, and the coverage, so that sky in a cone's
// footprint counts as a miss.
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_samplerless_texture_functions : require
#include "frame.glsl"
#include "gbuffer_inputs.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 3, binding = 0) uniform texture2D source;                         // the HDR image
layout(set = 3, binding = 1, rgba16f) uniform writeonly image2D destination;   // level 0

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, imageSize(destination))))
        return;
    float coverage = texelFetch(gbufferDistance, pixel, 0).r > 0.0 ? 1.0 : 0.0;
    // A lamp's glow is its light's face, and the light's lobe already reflects the lamp in every surface, so a ray that
    // meets the glow reads the lamp dark, as the map shows it (docs/plans/screen-space-reflections.md, "A lamp's
    // glow"). The glow that the pixel keeps is the one that it sends (glowSent, frame.glsl), the rule of the map and
    // the bounce source. The G-buffer pass pre-exposed the glow, as the lit image is, and capped it at MaxRadiance. The
    // lit image is the glow plus light, capped at MaxRadiance, so the difference is 0 or more up to the rounding of the
    // cap's product. The skin scatter then adds the scattered diffuse light less the pixel's own, which can take far more
    // than the light without the glow: at a skin pixel whose entity holds a light, whose glow reached the cap and which
    // lies beside a sharp edge of light, the difference falls to about -1,200. The max keeps level 0 at 0 or more there
    // (PyramidRenderTests). Where the lit image reached the cap, the difference is less than the light without the
    // glow. Both operands are finite, so the max sees no NaN.
    vec3 emissive = texelFetch(gbufferEmissive, pixel, 0).rgb;
    vec3 lampGlow = emissive - glowSent(emissive, lightMarkOfWord(texelFetch(gbufferShading, pixel, 0).b));
    // The select keeps sky's light out of the cones exactly. It guards against no infinity: the HDR image holds none,
    // because every writer caps its light at MaxRadiance, sky's star field too (ARCHITECTURE.md, "Portable Vulkan").
    vec3 radiance = coverage > 0.0 ? max(texelFetch(source, pixel, 0).rgb - lampGlow, vec3(0.0)) : vec3(0.0);
    imageStore(destination, pixel, vec4(radiance, coverage));
}
