#version 460
// The spatial dispatch of an accumulation (docs/plans/temporal-renderer.md, section 8, steps 3 to 5): one invocation per
// pixel fixes a short history from its neighbors in the scratch image, clamps the slow history into the box of this
// frame's fast history around the pixel, shortens the length by the clamp's move, and writes the slow history.
#extension GL_GOOGLE_include_directive : require
#include "accumulate.glsl"
#include "meter.glsl"

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (!insideImages(pixel))
        return;
    vec4 scratched = imageLoad(scratch, pixel);
    if (texelFetch(gbufferDistance, pixel, 0).r <= 0.0)
    {
        imageStore(slowHistory, pixel, vec4(0.0));
        return;
    }

    SurfaceKey key = surfaceKeyAt(pixel);
    vec3 slow = scratched.rgb;
    float historyLength = scratched.a;

    // Step 3, the fix: a weighted mean over 3 × 3 pixels 2^(HistoryFixFrames − 1 − n) apart, each neighbor weighted by its
    // length where it shows the same surface. The pixel's own length is at least 1 after the blend, so the sum is never 0.
    if (historyLength < min(parameters.fixFrames, parameters.cap))
    {
        int spacing = 1 << int(max(parameters.fixFrames - 1.0 - floor(historyLength), 0.0));
        vec3 sum = slow * historyLength;
        float weights = historyLength;
        for (int y = -1; y <= 1; y++)
            for (int x = -1; x <= 1; x++)
            {
                ivec2 neighbor = pixel + spacing * ivec2(x, y);
                if (x == 0 && y == 0 || !insideImages(neighbor) || !sameSurface(key, surfaceKeyAt(neighbor)))
                    continue;
                vec4 other = imageLoad(scratch, neighbor);
                sum += other.rgb * other.a;
                weights += other.a;
            }
        slow = sum / weights;
    }

    // Step 4, the clamp and the anti-lag, only past the fast cap: until then the slow history holds no more frames than the
    // fast history, so it has no lag to remove.
    if (historyLength > parameters.fastCap)
    {
        vec3 moments = vec3(0.0);
        vec3 squares = vec3(0.0);
        float count = 0.0;
        for (int y = -1; y <= 1; y++)
            for (int x = -1; x <= 1; x++)
            {
                ivec2 neighbor = pixel + ivec2(x, y);
                if (!(x == 0 && y == 0) && (!insideImages(neighbor) || !sameSurface(key, surfaceKeyAt(neighbor))))
                    continue;
                vec3 fast = imageLoad(fastHistory, neighbor).rgb;
                moments += fast;
                squares += fast * fast;
                count += 1.0;
            }
        vec3 mean = moments / count;
        vec3 sigma = sqrt(max(squares / count - mean * mean, vec3(0.0)));
        vec3 low = mean - parameters.clampSigmas * sigma;
        vec3 high = mean + parameters.clampSigmas * sigma;
        vec3 clamped = clamp(slow, low, high);
        float lag = luminance(abs(slow - clamped)) / max(luminance(mean), 1e-4);
        historyLength = max(parameters.fastCap, historyLength * (1.0 - min(1.0, lag / parameters.antiLagShare)));
        slow = clamped;
    }

    // Step 5.
    imageStore(slowHistory, pixel, vec4(slow, historyLength));
}
