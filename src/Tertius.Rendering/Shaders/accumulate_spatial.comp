#version 460
// The spatial dispatch of an accumulation (docs/plans/temporal-renderer.md, section 8, steps 3 to 5): one invocation
// per pixel fixes a short history from its neighbors in the scratch image, clamps the slow history into the box of this
// frame's fast history around the pixel, shortens the length by the clamp's move, and writes the slow history. The
// workgroup is a block of 8 × 8 pixels, and the block's evidence level, the strongest of its pixels' samples, acts on
// every pixel of it in this draw: motion evidence drops the box's widening, and light evidence also cuts the length to
// the fast cap (docs/plans/bounce-light-confidence.md, section 8).
#extension GL_GOOGLE_include_directive : require
#include "accumulate.glsl"
#include "accumulate_reflection_guide.glsl"
#include "meter.glsl"

// The least luminance by which the clamp divides: the lag's share and the chroma of the widening.
const float LeastLuminance = 1e-4;

// The evidence levels of a block, ordered by strength (section 8.2). Motion evidence narrows the box for this draw, and
// light evidence also cuts the length to the fast cap.
const uint NoEvidence = 0u;
const uint MotionEvidence = 1u;
const uint LightEvidence = 2u;

#ifdef TERTIUS_LIGHT_AGE
// The block's evidence level in this draw, which its 64 invocations share.
shared uint blockEvidence;

// The evidence level of one sample, from its age (sample_age.glsl): light evidence where one of its rays saw a recent
// light change, motion evidence where it saw motion. This is the one place that chooses the action of motion: a moved
// object narrows the box and does not cut, because a cut makes the pixels trace their own rays for as long as the motion
// lasts (docs/plans/bounce-light-confidence.md, section 8.2, open point 1).
uint evidenceOfSample(uint sampleAge)
{
    if (recentLightCode(lightCodeOf(sampleAge)))
        return LightEvidence;
    return sawMotion(sampleAge) ? MotionEvidence : NoEvidence;
}

// The evidence level of the workgroup's block: the strongest level of its pixels' samples. Every invocation of the
// workgroup calls it from main before any branch, so both barriers run in uniform control flow. A maximum does not depend
// on the order of the invocations, so one machine gives the same level in every run. A sky pixel's age is 0, and a pixel
// outside the images adds nothing.
uint evidenceOfBlock(ivec2 pixel)
{
    if (gl_LocalInvocationIndex == 0u)
        blockEvidence = NoEvidence;
    barrier();
    if (insideImages(pixel))
        atomicMax(blockEvidence, evidenceOfSample(imageLoad(sampleAge, pixel).r));
    barrier();
    return blockEvidence;
}
#endif

// Steps 3 to 5 at a pixel inside the images, where `evidence` is its block's evidence level in this draw.
void accumulateAt(ivec2 pixel, uint evidence)
{
    vec4 scratched = imageLoad(scratch, pixel);
    vec2 guide = vec2(0.0);
    if (reflectionSharingPrototype && parameters.light == SpecularLight)
        guide = imageLoad(reflectionGuideScratch, pixel).rg;
    if (texelFetch(gbufferDistance, pixel, 0).r <= 0.0)
    {
        imageStore(slowHistory, pixel, vec4(0.0));
        if (reflectionSharingPrototype && parameters.light == SpecularLight)
            imageStore(reflectionGuide, pixel, vec4(0.0));
#ifdef TERTIUS_ACCUMULATION_TRACE
        for (int layer = 4; layer < 8; layer++)
            storeTrace(pixel, layer, vec4(0.0));
#endif
        return;
    }

    SurfaceKey key = surfaceKeyAt(pixel);
    vec3 slow = scratched.rgb;
    float historyLength = scratched.a;
    float cap = capAt(roughnessAt(pixel));
    float fastCap = fastCapOf(cap);
#ifdef TERTIUS_ACCUMULATION_TRACE
    // Layers 4 to 7 (TemporalSignal.TraceLayers). They store the values that the dispatch computes and compute nothing:
    // an arithmetic of the trace's own changed the driver's rounding of the slow history in the last bit.
    float tracedBefore = historyLength;
#endif

    // Step 3, the fix: a weighted mean over 3 × 3 pixels 2^(HistoryFixFrames − 1 − n) apart, each neighbor weighted by its
    // length where it shows the same surface. The pixel's own length is at least 1 after the blend, so the sum is never 0.
    if (historyLength < min(parameters.fixFrames, cap))
    {
        int spacing = 1 << int(max(parameters.fixFrames - 1.0 - floor(historyLength), 0.0));
        vec3 sum = slow * historyLength;
        vec2 guideSum = guide * historyLength;
        float weights = historyLength;
        for (int y = -1; y <= 1; y++)
            for (int x = -1; x <= 1; x++)
            {
                ivec2 neighbor = pixel + spacing * ivec2(x, y);
                if (x == 0 && y == 0 || !insideImages(neighbor) || !sameSurface(key, surfaceKeyAt(neighbor)))
                    continue;
                vec4 other = imageLoad(scratch, neighbor);
                sum += other.rgb * other.a;
                weights += other.a;
                if (reflectionSharingPrototype && parameters.light == SpecularLight)
                    guideSum += imageLoad(reflectionGuideScratch, neighbor).rg * other.a;
            }
        slow = sum / weights;
        guide = guideSum / weights;
    }

    // Step 4, the clamp and the anti-lag, only past the fast cap: until then the slow history holds no more frames than the
    // fast history, so it has no lag to remove.
    if (historyLength > fastCap)
    {
        vec3 moments = vec3(0.0);
        vec3 squares = vec3(0.0);
        float count = 0.0;
        for (int y = -1; y <= 1; y++)
            for (int x = -1; x <= 1; x++)
            {
                ivec2 neighbor = pixel + ivec2(x, y);
                if (!(x == 0 && y == 0) && (!insideImages(neighbor) || !sameSurface(key, surfaceKeyAt(neighbor))))
                    continue;
                vec3 fast = imageLoad(fastHistory, neighbor).rgb;
                moments += fast;
                squares += fast * fast;
                count += 1.0;
            }
        vec3 mean = moments / count;
        vec3 sigma = sqrt(max(squares / count - mean * mean, vec3(0.0)));
        // The box holds every excursion that the history's own samples explain: at least retainedSigmas retained
        // deviations, in the chroma of the history, which holds the excess (docs/plans/bounce-light-confidence.md,
        // section 7). The reflections' narrow box takes none, and either level of evidence drops the widening for this
        // draw.
        vec3 spread = parameters.clampSigmas * sigma;
        if (parameters.retainedSigmas > 0.0 && evidence == NoEvidence)
        {
            float deviation = imageLoad(fastHistory, pixel).a;
            spread = max(spread, parameters.retainedSigmas * deviation * slow / max(luminance(slow), LeastLuminance));
        }
        vec3 clamped = clamp(slow, mean - spread, mean + spread);
        float lag = luminance(abs(slow - clamped)) / max(luminance(mean), LeastLuminance);
#ifdef TERTIUS_ACCUMULATION_TRACE
        storeTrace(pixel, 5, vec4(slow, 1.0));
        storeTrace(pixel, 6, vec4(mean, lag));
        storeTrace(pixel, 7, vec4(sigma, 0.0));
#endif
        // Light evidence restarts the history from the fast window, which already holds the change. Motion has no known
        // size, so the narrow box measures it, and the anti-lag shortens the history by the clamp's move.
        historyLength = evidence == LightEvidence
            ? fastCap
            : max(fastCap, historyLength * (1.0 - min(1.0, lag / parameters.antiLagShare)));
        slow = clamped;
    }

#ifdef TERTIUS_ACCUMULATION_TRACE
    else
    {
        storeTrace(pixel, 5, vec4(slow, 0.0));
        storeTrace(pixel, 6, vec4(0.0));
        storeTrace(pixel, 7, vec4(0.0));
    }
    storeTrace(pixel, 4, vec4(tracedBefore, historyLength, 0.0, 0.0));
#endif

    // Step 5.
    imageStore(slowHistory, pixel, vec4(slow, historyLength));
    if (reflectionSharingPrototype && parameters.light == SpecularLight)
        imageStore(reflectionGuide, pixel, vec4(guide, 0.0, 0.0));
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    // A signal without a light age has no evidence.
#ifdef TERTIUS_LIGHT_AGE
    uint evidence = evidenceOfBlock(pixel);
#else
    uint evidence = NoEvidence;
#endif
    if (insideImages(pixel))
        accumulateAt(pixel, evidence);
}
