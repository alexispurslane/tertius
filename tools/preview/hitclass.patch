+    parts[2] = 0.0;    // the glow's code 3 is the sky's here
+    parts[3] = dot(f.specular * imageLoad(directSpecularLight, q).rgb, Y);
+    parts[4] = holdsHistory(r.specular) ? dot(f.specular * lastLightOf(r.specular, KindReflection), Y) : 0.0;
+    uint best = 0u;
+    float most = 0.0;
+    for (uint i = 0u; i < 5u; i++)
