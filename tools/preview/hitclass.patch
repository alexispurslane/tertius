+// PROBE (t0-adau, never merges): what the pixel's diffuse ray hit, for the probe's hit census (TERTIUS_PROBE_HITS).
+// Bits 0 and 1: 0 no ray (below the geometric plane, or none traced), 1 a miss, 2 a hit. For a hit, bits 2 and 3 the hit
+// surface's facing against the pixel's own geometric normal: 0 the same way (cosine above 0.7, as the ceiling or a
+// lamp's lower face seen from the ceiling), 1 across (a wall, a lamp's side), 2 opposite (cosine below -0.7, as the
+// floor); bit 4 the ray meets the hit surface from behind; bit 5 the hit pixel's material glows (its raw emission above
+// 0); bit 6 the hit pixel's entity holds a light. The hit point is the pixel's own ray start plus the record's direction
+// times its hit distance, so for a block's ray, which starts at the block's chosen pixel, it lies up to a pixel off.
+uint probeHitClassOf(TracingPixel p, RayRecord record, WeighedRay ray)
+{
+    if (!ray.brings)
+        return 0u;
+    float distance = record.light.a;
+    if (distance <= 0.0)
+        return 1u;
+    vec3 clip = clipOf(p.origin + ray.direction * distance);
+    if (clip.z <= 0.0)
+        return 1u;
+    ivec2 q = clamp(ivec2(floor((0.5 * clip.xy / clip.z + 0.5) * frame.viewport.xy)), ivec2(0),
+        ivec2(frame.viewport.xy) - 1);
+    vec3 n = materialAt(q).geometricNormal;
+    float facing = dot(n, p.s.geometricNormal);
+    uint code = 2u | ((facing > 0.7 ? 0u : facing < -0.7 ? 2u : 1u) << 2);
+    if (dot(ray.direction, n) > 0.0)
+        code |= 16u;
+    if (any(greaterThan(texelFetch(gbufferEmissive, q, 0).rgb, vec3(0.0))))
+        code |= 32u;
+    if (lightMarkOfWord(texelFetch(gbufferShading, q, 0).b) != 0u)
+        code |= 64u;
+    return code;
+}
