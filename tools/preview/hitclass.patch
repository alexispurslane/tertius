+// PROBE (t0-adau): the place mode (TERTIUS_PROBE_HIT_PLACES=1, bit 2 of the knob): the specular sample's age holds its
+// class's bits 0 to 4 and 6 and 7, bit 5 whether the hit pixel's demodulated direct diffuse light passes 50, and bits 8 to
+// 12 the hit pixel's y >> 5; the diffuse sample's age holds the hit pixel's x in bits 0 to 10 and y & 31 in bits 11 to 15.
+// PROBE (t0-adau): the part of leavingLightOf's reflection light at q that is largest: 1 the direct diffuse light, 2 the
+// diffuse history, 3 the glow, 4 the direct specular light, 5 the specular history, 6 q is no traced surface (an
+// impostor, whose light is its glow), 7 a closed form in place of a history; 0 when all are 0.
+uint probeDominantOf(ivec2 q)
+{
+    if (!hittable(q))
+        return 3u;    // the sky: no walk hits it, so a hit there is misplaced or reads a stale hit light
+    if (!tracedSurface(q))
+        return 6u;    // an impostor
+    ShadingInput s = materialAt(q);
+    vec3 V = -normalize(viewRayThrough(vec2(q) + 0.5));
+    MaterialFactors f = materialFactors(s, lobesOf(s, V));
+    SignalReprojections r = reprojectionsAt(q);
+    const vec3 Y = vec3(0.2126, 0.7152, 0.0722);
+    float parts[5];
