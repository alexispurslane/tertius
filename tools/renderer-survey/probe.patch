+    // PROBE (tools/renderer-survey, never commit to src): with TERTIUS_PROBE_SERIES=<file>, each capture appends one line
+    // to the file: its name, then the mean scene luminance of the whole image and of each cell of a 3 x 3 grid, by rows.
+    // It decodes the probe's 24-bit log2 luminance as probe_luminance and region_means of tools/renderer-survey.py do.
+    // It writes the PNG only for the names in TERTIUS_PROBE_KEEP, a comma-separated list, so that a film of every draw
+    // pays no PNG encoding (ticket ter-d7qy).
+    private static readonly string? ProbeSeries =
+        Environment.GetEnvironmentVariable("TERTIUS_PROBE_SERIES") is { Length: > 0 } series ? series : null;
+    private static readonly HashSet<string> ProbeKeep =
+        [.. (Environment.GetEnvironmentVariable("TERTIUS_PROBE_KEEP") ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries)];
+
+    // exp2(q / 16777215 * 40 - 24) of a 24-bit code q is the product of a table entry for its high 12 bits and one for
+    // its low 12 bits. It differs from the direct exp2 by at most 4e-16 of its value, and it makes the means of a
+    // 1920 x 1080 capture about 12 times faster than one exp2 per pixel.
+    private static readonly double[] ProbeHigh = [.. Enumerable.Range(0, 4096).Select(k => double.Exp2(k * 4096 / 16777215.0 * 40.0 - 24.0))];
+    private static readonly double[] ProbeLow = [.. Enumerable.Range(0, 4096).Select(k => double.Exp2(k / 16777215.0 * 40.0))];
+
+    private static unsafe double[] ProbeMeans(in CapturedImage image)
+    {
+        const int grid = 3;
+        int width = image.Width;
+        int height = image.Height;
+        var sums = new double[grid * grid];
+        fixed (byte* start = image.Rgba)
+        {
+            nint pixels = (nint)start;
+            Parallel.For(0, grid * grid, cell =>
+            {
+                int row = cell / grid;
+                int column = cell % grid;
+                double sum = 0.0;
+                for (int y = row * height / grid; y < (row + 1) * height / grid; y++)
+                    for (int x = column * width / grid; x < (column + 1) * width / grid; x++)
+                    {
+                        byte* pixel = (byte*)pixels + ((long)y * width + x) * 4;
+                        int q = (pixel[0] << 16) | (pixel[1] << 8) | pixel[2];
+                        if (q != 0)
+                            sum += ProbeHigh[q >> 12] * ProbeLow[q & 4095];
+                    }
+                sums[cell] = sum;
+            });
+        }
+        var means = new double[1 + grid * grid];
+        double total = 0.0;
+        for (int cell = 0; cell < grid * grid; cell++)
+        {
+            int row = cell / grid;
+            int column = cell % grid;
+            long pixels = (long)((row + 1) * height / grid - row * height / grid)
+                * ((column + 1) * width / grid - column * width / grid);
+            means[1 + cell] = sums[cell] / pixels;
+            total += sums[cell];
+        }
+        means[0] = total / ((double)width * height);
+        return means;
+    }
