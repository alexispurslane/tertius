+    // PROBE (tools/renderer-survey, never commit to src): TERTIUS_PROBE_LAMP_OFF="a-b,c-d" turns the selected local lights
+    // off in the draws a <= draw < b, counted from 0 over every draw of the run. TERTIUS_PROBE_LAMP_SEL = all, or
+    // x:lo:hi, y:lo:hi or z:lo:hi, selects the local lights whose world position lies in that range on that axis.
+    // TERTIUS_PROBE_SUN=off turns off every light whose reach is at least 10^6 m.
+    private static int probeDraw;
+    private static readonly (int From, int To)[] ProbeRanges = (Environment.GetEnvironmentVariable("TERTIUS_PROBE_LAMP_OFF") ?? "")
+        .Split(',', StringSplitOptions.RemoveEmptyEntries)
+        .Select(r => r.Split('-'))
+        .Select(r => (int.Parse(r[0]), int.Parse(r[1])))
+        .ToArray();
+    private static readonly string[] ProbeSelect = (Environment.GetEnvironmentVariable("TERTIUS_PROBE_LAMP_SEL") ?? "all").Split(':');
+    private static readonly bool ProbeSunOff = Environment.GetEnvironmentVariable("TERTIUS_PROBE_SUN") == "off";
+
+    private static void ProbeLamps(Span<GpuLight> lights)
+    {
+        int draw = probeDraw++;
+        if (ProbeSunOff)
+            for (int i = 0; i < lights.Length; i++)
+                if (lights[i].PositionReach.W >= 1e6f)
+                    lights[i].IntensityKind = new Vector4(0, 0, 0, lights[i].IntensityKind.W);
+        bool off = false;
+        foreach ((int from, int to) in ProbeRanges)
+            off |= draw >= from && draw < to;
+        if (!off)
+            return;
+        int count = 0;
+        for (int i = 0; i < lights.Length; i++)
+        {
+            Vector4 p = lights[i].PositionReach;
+            bool chosen = ProbeSelect[0] switch
+            {
+                "x" => p.X >= float.Parse(ProbeSelect[1]) && p.X <= float.Parse(ProbeSelect[2]),
+                "y" => p.Y >= float.Parse(ProbeSelect[1]) && p.Y <= float.Parse(ProbeSelect[2]),
+                "z" => p.Z >= float.Parse(ProbeSelect[1]) && p.Z <= float.Parse(ProbeSelect[2]),
+                _ => true,
+            };
+            if (chosen && p.W > 0 && p.W < 1e6f)
+            {
+                lights[i].IntensityKind = new Vector4(0, 0, 0, lights[i].IntensityKind.W);
+                count++;
+            }
+        }
+        if (ProbeRanges.Any(r => r.From == draw))
+            Console.Error.WriteLine($"PROBE draw {draw}: {count} of {lights.Length} lights off");
+    }
