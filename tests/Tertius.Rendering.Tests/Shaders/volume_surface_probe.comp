#version 460
// Test tool: reads the coverage that the real raster and restriction passes stored in every outer cell.
#extension GL_GOOGLE_include_directive : require
#include "screen_trace.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(vec2(pixel), frame.viewport.xy)))
        return;
    int local = pixel.x + int(frame.viewport.x) * pixel.y;
    float area = 0.0;
    if (local < cellsOf(2))
        for (int side = 0; side < 6; ++side)
            area += float(volume.surfaces[(firstCellOf(2) + local) * 6 + side].areaNormal.w);
    imageStore(specularSample, pixel, vec4(area, 0, 0, 1));
}
