#version 460
// The history part of a diffuse ray's hit at each pixel q of a white surface without glow: the light of a hit
// (leavingLightAt) less q's direct diffuse light, whose material factor is 1.
#extension GL_GOOGLE_include_directive : require
#include "screen_trace.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(vec2(pixel), frame.viewport.xy)))
        return;
    vec3 history = leavingLightAt(pixel).diffuse - imageLoad(directDiffuseLight, pixel).rgb;
    imageStore(specularSample, pixel, vec4(history, 1.0));
}
