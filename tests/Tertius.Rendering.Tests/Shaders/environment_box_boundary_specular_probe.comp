#version 460
#extension GL_GOOGLE_include_directive : require
#include "screen_trace.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(vec2(pixel), frame.viewport.xy)))
        return;
    vec3 position = vec3(1.0, 1.0, frame.mapBoxes[0].minimum.z);
    vec3 direction = vec3(0.0, 0.0, 1.0);
    vec3 actual = environmentSpecular(0u, position, direction, direction, 0.0, frame.params.z);
    imageStore(specularSample, pixel, vec4(actual, 1.0));
}
