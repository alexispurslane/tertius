#version 460
// Each 2 × 2 block's recorded reflection ray of this frame, against the direction that its chosen pixel's draw gives
// through the blue-noise mask at the block's cell and at the chosen pixel's cell: r 1 where the record holds the block
// cell's direction, g 1 where it holds the pixel cell's, and b 1 where the block chose a pixel. The values go to the
// specular sample at the block's position.
#extension GL_GOOGLE_include_directive : require
#include "screen_trace.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

uvec2 recordedCodeOf(TracingPixel p, ivec2 pixel, ivec2 cell)
{
    uvec3 draw = drawOf(pixel, trace.drawIndex, DirectionDraw[KindReflection]);
    vec3 drawn = reflectionDirection(p, reflectionNumbersOf(cell, trace.drawIndex, draw));
    return directionCodeOf(directionOfCode(directionCodeOf(drawn)));
}

void main()
{
    ivec2 block = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(block, ivec2(ceil(frame.viewport.xy * 0.5)))))
        return;
    vec4 result = vec4(0.0, 0.0, 0.0, 1.0);
    ivec2 chosen;
    TracingPixel p;
    if (chosenPixelOf(block, KindReflection, chosen, p))
    {
        uvec2 recorded = imageLoad(blockRay, ivec3(block, KindReflection)).xy;
        result = vec4(float(all(equal(recorded, recordedCodeOf(p, chosen, block)))),
                      float(all(equal(recorded, recordedCodeOf(p, chosen, chosen)))), 1.0, 1.0);
    }
    imageStore(specularSample, block, result);
}
