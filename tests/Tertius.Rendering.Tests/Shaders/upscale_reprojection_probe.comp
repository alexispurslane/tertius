#version 460
#extension GL_GOOGLE_include_directive : require
#include "screen_trace.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(vec2(pixel), frame.viewport.xy)))
        return;
    vec2 place = historyPlace(vec2(pixel) + 0.5, imageLoad(motionTarget, pixel).xy);
    imageStore(specularSample, pixel, vec4(place - vec2(0.5), 0.0, 1.0));
}
