#version 460
// Test tool: observes incoming broad radiance before the receiver's material applies it.
#extension GL_GOOGLE_include_directive : require
#include "screen_trace.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(vec2(pixel), frame.viewport.xy)))
        return;
    ShadingInput s = materialAt(pixel);
    vec3 view = normalize(-s.position);
    vec4 grid = volume.grids[0];
    vec3 p = (s.position - grid.xyz) / grid.w + 0.45 * s.geometricNormal;
    vec4 diffuse, glossy;
    volumeAt(0, p, s.normal, normalize(reflect(-view, s.normal)), true, diffuse, glossy);
    imageStore(specularSample, pixel, glossy);
}
