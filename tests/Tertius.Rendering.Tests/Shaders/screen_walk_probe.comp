#version 460
#extension GL_GOOGLE_include_directive : require
#include "screen_trace.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(vec2(pixel), frame.viewport.xy)))
        return;
    float wallW = texelFetch(depthFinest, pixel, 0).r;
    ScreenRay behind = ScreenRay(vec2(pixel) + 0.5, vec2(1.0, 0.0), wallW * 0.25, 0.0, 4.0);
    ScreenRay backface = ScreenRay(vec2(pixel) + 0.5, vec2(1.0, 0.0), wallW, 0.0, 4.0);
    vec2 hit;
    ivec2 hitPixel;
    float share;
    uint behindResult = walkScreen(depthFinest, depthPyramid,
        screenWalkOf(behind, vec3(0.0, 0.0, -1.0), NoCard), 256u, hit, hitPixel, share);
    uint backfaceResult = walkScreen(depthFinest, depthPyramid,
        screenWalkOf(backface, vec3(0.0, 0.0, 1.0), NoCard), 256u, hit, hitPixel, share);
    ScreenWalk tie = screenWalkOf(ScreenRay(vec2(0.5), vec2(1.0, 0.0), 1.0, 0.0, 4.0),
        vec3(0.0, 0.0, -1.0), NoCard);
    imageStore(specularSample, pixel, vec4(float(behindResult), float(backfaceResult),
        childAt(tie, vec2(0.0), 0, 0.5, true).x, childAt(tie, vec2(0.0), 0, 0.5, false).x));
}
