#version 460
#extension GL_GOOGLE_include_directive : require
#include "screen_trace.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(vec2(pixel), frame.viewport.xy)))
        return;
    imageStore(rayPlan, pixel, uvec4(0u));
    if (any(notEqual(pixel & 1, ivec2(0))))
        return;
    // A precise history's ray also carries its hit's light age: none here.
#ifdef TERTIUS_PRECISE_SPECULAR_HISTORY
    RayRecord record = recordOf(TracedRay(vec3(0.0, 0.0, 1.0), 0.00001, vec3(32256.0), 1.0, true, NoLightAge, false));
#else
    RayRecord record = recordOf(TracedRay(vec3(0.0, 0.0, 1.0), 0.00001, vec3(32256.0), 1.0, true));
#endif
    for (uint kind = KindReflection; kind <= KindDiffuse; kind++)
    {
        ivec3 at = ivec3(pixel / 2, kind);
        imageStore(blockLight, at, record.light);
        imageStore(blockRay, at, record.ray);
    }
}
