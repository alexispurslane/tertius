#version 460
// Overwrites the hit light of every pixel with a marker of each kind: 1000 in every channel of the reflection layer and
// 3000 in the diffuse layer (HitLightImageTests).
#extension GL_GOOGLE_include_directive : require
#include "screen_trace.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(vec2(pixel), frame.viewport.xy)))
        return;
    imageStore(hitLight, ivec3(pixel, KindReflection), vec4(1000.0));
    imageStore(hitLight, ivec3(pixel, KindDiffuse), vec4(3000.0));
}
