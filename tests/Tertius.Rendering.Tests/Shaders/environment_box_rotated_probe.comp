#version 460
#extension GL_GOOGLE_include_directive : require
#include "screen_trace.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(vec2(pixel), frame.viewport.xy)))
        return;
    float wall = frame.mapBoxes[0].minimum.z;
    float height = (pixel.x & 1) == 0 ? 0.0 : -wall * 0.375;
    vec3 position = vec3(-height, 0.0, -1.0);
    vec3 direction = vec3(0.0, 0.0, -1.0);
    vec3 actual = environmentSpecular(0u, position, direction, direction, 0.0, frame.params.z);
    vec3 expected = environmentLobeInMapAxes(0u, vec3(0.0, height, wall), 0.0).rgb;
    imageStore(specularSample, pixel, vec4(actual, 1.0));
    imageStore(diffuseSample, pixel, vec4(expected, 1.0));
}
