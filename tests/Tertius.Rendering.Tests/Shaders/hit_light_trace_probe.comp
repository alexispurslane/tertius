#version 460
// A ray of each kind that each pixel of a traced surface starts, traced as the tracer traces it (traceFrom): r its light's
// red channel and g its hit distance, 0 for a miss, of the reflection ray in the specular sample and of the diffuse ray in
// the diffuse sample. A pixel that starts no ray of the kind holds −1 in g.
#extension GL_GOOGLE_include_directive : require
#include "screen_trace.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

vec4 rayOf(ivec2 pixel, uint kind)
{
    if (!tracedSurface(pixel))
        return vec4(0.0, -1.0, 0.0, 1.0);
    TracingPixel p = tracingPixelAt(pixel);
    if (!startsKind(p, kind))
        return vec4(0.0, -1.0, 0.0, 1.0);
    TracedRay ray = traceFrom(pixel, pixel, p, kind);
    return vec4(ray.light.r, ray.distance, 0.0, 1.0);
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(vec2(pixel), frame.viewport.xy)))
        return;
    imageStore(specularSample, pixel, rayOf(pixel, KindReflection));
    imageStore(diffuseSample, pixel, rayOf(pixel, KindDiffuse));
}
