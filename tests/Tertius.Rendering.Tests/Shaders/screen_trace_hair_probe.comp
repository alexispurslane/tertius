#version 460
#extension GL_GOOGLE_include_directive : require
#include "screen_trace.glsl"

// The hair test's rays from the left card's pixels (ScreenTraceRecordTests): each walks once with the receiver-card
// exclusion and once without. Each pixel writes the column of each walk's hit, or -1 for a miss, and its own card code.
layout(local_size_x = 8, local_size_y = 8) in;

// The middle column of the right card, which every ray meets at the right card's stored center w.
const int TargetColumn = 92;

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(vec2(pixel), frame.viewport.xy)))
        return;
    uvec4 shading = texelFetch(gbufferShading, pixel, 0);
    uint ownCard = cardOfWords(shading.b, shading.a);
    if (ownCard == NoCard)
    {
        imageStore(specularSample, pixel, vec4(0.0));
        return;
    }
    // The ray runs right along the row, and its w falls by perPixel per pixel. It meets its own card's center w at the
    // center of the second pixel to the right, and the right card's center w at the center of TargetColumn. Both
    // crossings lie at a pixel's center, inside its slab, far from the slabs' ends.
    float w = texelFetch(depthFinest, pixel, 0).r;
    float ownChange = texelFetch(depthFinest, pixel + ivec2(1, 0), 0).r - w;
    float target = texelFetch(depthFinest, ivec2(TargetColumn, pixel.y), 0).r;
    float perPixel = (w + 2.0 * ownChange - target) / float(TargetColumn - pixel.x - 2);
    ScreenRay ray = ScreenRay(vec2(pixel) + 0.5, vec2(frame.viewport.x, 0.0), w + 2.0 * (perPixel + ownChange),
        -perPixel * frame.viewport.x, 1.0);
    vec3 direction = normalize(vec3(1.0, 0.0, -0.001));
    vec2 hit;
    ivec2 hitPixel;
    float share;
    uint result = walkScreen(depthFinest, depthPyramid, screenWalkOf(ray, direction, ownCard), 256u,
        hit, hitPixel, share);
    float afterOwn = result == WalkHit ? float(hitPixel.x) : -1.0;
    result = walkScreen(depthFinest, depthPyramid, screenWalkOf(ray, direction, NoCard), 256u,
        hit, hitPixel, share);
    imageStore(specularSample, pixel, vec4(afterOwn, result == WalkHit ? float(hitPixel.x) : -1.0,
        float(ownCard & 255u), float(ownCard >> 8u)));
}
