#version 460
#extension GL_GOOGLE_include_directive : require
#include "screen_trace.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(vec2(pixel), frame.viewport.xy)))
        return;
    uvec4 shading = texelFetch(gbufferShading, pixel, 0);
    uint ownCard = cardOfWords(shading.b, shading.a);
    if (ownCard == NoCard)
    {
        imageStore(specularSample, pixel, vec4(0.0));
        return;
    }
    ScreenRay ray = ScreenRay(vec2(pixel) + 0.5, vec2(frame.viewport.x, 0.0),
        texelFetch(depthFinest, pixel, 0).r, -0.0001, 1.0);
    vec3 direction = normalize(vec3(1.0, 0.0, -0.001));
    vec2 hit;
    ivec2 hitPixel;
    float share;
    uint result = walkScreen(depthFinest, depthPyramid, screenWalkOf(ray, direction, ownCard), 256u,
        hit, hitPixel, share);
    float afterOwn = result == WalkHit ? float(hitPixel.x) : -1.0;
    result = walkScreen(depthFinest, depthPyramid, screenWalkOf(ray, direction, NoCard), 256u,
        hit, hitPixel, share);
    imageStore(specularSample, pixel, vec4(afterOwn, result == WalkHit ? float(hitPixel.x) : -1.0,
        float(ownCard & 255u), float(ownCard >> 8u)));
}
