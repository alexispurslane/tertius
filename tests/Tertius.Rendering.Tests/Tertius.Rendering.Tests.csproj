<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <UsesVulkan>true</UsesVulkan>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Tertius.Rendering/Tertius.Rendering.csproj" />
    <ProjectReference Include="../Tertius.Testing/Tertius.Testing.csproj" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
  </ItemGroup>
  <!-- The golden values of FSR 3.1.4's host calculations, which tools/fsr3-golden/build.sh writes from AMD's code. -->
  <ItemGroup>
    <EmbeddedResource Include="Fsr3Golden.json" LogicalName="Tertius.Rendering.Tests.Fsr3Golden.json" WithCulture="false" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="AwesomeAssertions" />
  </ItemGroup>
  <!-- The reference of AmbientSkipsTests: the ambient pass's two stages from src, built with TERTIUS_EVERY_AMBIENT_TERM,
       which computes every term that the engine's build skips (environment.glsl). Embedded under the engine's resource
       names, for a ShaderLibrary of this assembly. glslc comes from shaderc in the Nix dev shell. -->
  <PropertyGroup>
    <Glslc Condition="'$(Glslc)' == ''">glslc</Glslc>
    <EngineShaders>$(MSBuildProjectDirectory)/../../src/Tertius.Rendering/Shaders</EngineShaders>
  </PropertyGroup>
  <ItemGroup>
    <ReferenceShader Include="$(EngineShaders)/lighting.vert;$(EngineShaders)/ambient.frag;$(EngineShaders)/ambient_scatter.frag" />
    <ReferenceShaderInclude Include="$(EngineShaders)/*.glsl" />
  </ItemGroup>

  <Target Name="CompileReferenceShaders" BeforeTargets="BeforeBuild"
          Inputs="@(ReferenceShader);@(ReferenceShaderInclude);$(MSBuildProjectFullPath)"
          Outputs="@(ReferenceShader->'$(IntermediateOutputPath)reference-shaders/%(Filename)%(Extension).spv')">
    <MakeDir Directories="$(IntermediateOutputPath)reference-shaders" />
    <Exec Command="&quot;$(Glslc)&quot; --target-env=vulkan1.3 -O -Werror -DTERTIUS_EVERY_AMBIENT_TERM -I &quot;$(EngineShaders)&quot; -o &quot;$(IntermediateOutputPath)reference-shaders/%(ReferenceShader.Filename)%(ReferenceShader.Extension).spv&quot; &quot;%(ReferenceShader.FullPath)&quot;" />
  </Target>

  <Target Name="EmbedReferenceShaders" DependsOnTargets="CompileReferenceShaders" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <_ReferenceSpirv Include="@(ReferenceShader->'$(IntermediateOutputPath)reference-shaders/%(Filename)%(Extension).spv')" />
      <EmbeddedResource Include="@(_ReferenceSpirv)" LogicalName="Tertius.Rendering.Shaders.%(_ReferenceSpirv.Filename)%(_ReferenceSpirv.Extension)" WithCulture="false" />
    </ItemGroup>
  </Target>
</Project>
