<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <UsesVulkan>true</UsesVulkan>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Tertius.Rendering/Tertius.Rendering.csproj" />
    <ProjectReference Include="../../tools/Tertius.ReflectionReference/Tertius.ReflectionReference.csproj" />
    <ProjectReference Include="../../tools/Tertius.LtcFit/Tertius.LtcFit.csproj" />
    <ProjectReference Include="../Tertius.Testing/Tertius.Testing.csproj" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
  </ItemGroup>
  <!-- The golden values of FSR 3.1.4's host calculations, which tools/fsr3-golden/build.sh writes from AMD's code. -->
  <ItemGroup>
    <EmbeddedResource Include="Fsr3Golden.json" LogicalName="Tertius.Rendering.Tests.Fsr3Golden.json" WithCulture="false" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="AwesomeAssertions" />
  </ItemGroup>
  <!-- The test shaders, each compiled with the engine's flags plus its own Flags, and embedded under the engine's resource
       names for a ShaderLibrary of this assembly. glslc comes from shaderc in the Nix dev shell.
       - The reference of AmbientSkipsTests: the composite's two stages from src, built with TERTIUS_EVERY_AMBIENT_TERM,
         which computes every term that the engine's build skips (environment.glsl).
       - The probe of DirectLightProbe, with the same flags.
       - The probes of GpuCalibrationTests. -->
  <PropertyGroup>
    <Glslc Condition="'$(Glslc)' == ''">glslc</Glslc>
    <EngineShaders>$(MSBuildProjectDirectory)/../../src/Tertius.Rendering/Shaders</EngineShaders>
  </PropertyGroup>
  <ItemGroup>
    <TestShader Include="$(EngineShaders)/lighting.vert;$(EngineShaders)/composite.frag;$(EngineShaders)/composite_scatter.frag;Shaders/direct_light_probe.frag;Shaders/direct_diffuse_probe.frag;Shaders/specular_parts_probe.frag;Shaders/reflection_sharing_pulse.frag"
                Flags="-DTERTIUS_EVERY_AMBIENT_TERM -I &quot;$(EngineShaders)&quot;" />
    <TestShader Include="Shaders/*.comp;Shaders/upscale_view_ray_probe.frag" Flags="-I &quot;$(EngineShaders)&quot;" />
    <TestShader Include="$(EngineShaders)/screen_trace_resolve.comp" Flags="-I &quot;$(EngineShaders)&quot;" />
    <PreciseHistoryTestShader Include="@(TestShader)" />
    <TestShaderInclude Include="$(EngineShaders)/*.glsl;Shaders/*.glsl" />
    <DirectionOnlyShader Include="$(EngineShaders)/lighting.vert;$(EngineShaders)/composite.frag" />
  </ItemGroup>

  <Target Name="CompileDirectionOnlyShaders" BeforeTargets="BeforeBuild"
          Inputs="@(DirectionOnlyShader);@(TestShaderInclude);$(MSBuildProjectFullPath)"
          Outputs="@(DirectionOnlyShader->'$(IntermediateOutputPath)direction-only/%(Filename)%(Extension).spv')">
    <MakeDir Directories="$(IntermediateOutputPath)direction-only" />
    <Exec Command="&quot;$(Glslc)&quot; --target-env=vulkan1.3 -O -Werror -DTERTIUS_MAP_DIRECTION_ONLY -I &quot;$(EngineShaders)&quot; -o &quot;$(IntermediateOutputPath)direction-only/%(DirectionOnlyShader.Filename)%(DirectionOnlyShader.Extension).spv&quot; &quot;%(DirectionOnlyShader.FullPath)&quot;" />
  </Target>

  <Target Name="EmbedDirectionOnlyShaders" DependsOnTargets="CompileDirectionOnlyShaders" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <_DirectionOnlySpirv Include="@(DirectionOnlyShader->'$(IntermediateOutputPath)direction-only/%(Filename)%(Extension).spv')" />
      <EmbeddedResource Include="@(_DirectionOnlySpirv)" LogicalName="Tertius.Rendering.Shaders.direction_only_%(_DirectionOnlySpirv.Filename)%(_DirectionOnlySpirv.Extension)" WithCulture="false" />
    </ItemGroup>
  </Target>

  <Target Name="CompileTestShaders" BeforeTargets="BeforeBuild"
          Inputs="@(TestShader);@(TestShaderInclude);$(MSBuildProjectFullPath)"
          Outputs="@(TestShader->'$(IntermediateOutputPath)test-shaders/%(Filename)%(Extension).spv')">
    <MakeDir Directories="$(IntermediateOutputPath)test-shaders" />
    <Exec Command="&quot;$(Glslc)&quot; --target-env=vulkan1.3 -O -Werror %(TestShader.Flags) -o &quot;$(IntermediateOutputPath)test-shaders/%(TestShader.Filename)%(TestShader.Extension).spv&quot; &quot;%(TestShader.FullPath)&quot;" />
  </Target>

  <Target Name="EmbedTestShaders" DependsOnTargets="CompileTestShaders" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <_TestSpirv Include="@(TestShader->'$(IntermediateOutputPath)test-shaders/%(Filename)%(Extension).spv')" />
      <EmbeddedResource Include="@(_TestSpirv)" LogicalName="Tertius.Rendering.Shaders.%(_TestSpirv.Filename)%(_TestSpirv.Extension)" WithCulture="false" />
    </ItemGroup>
  </Target>

  <Target Name="CompilePreciseHistoryTestShaders" BeforeTargets="BeforeBuild"
          Inputs="@(PreciseHistoryTestShader);@(TestShaderInclude);$(MSBuildProjectFullPath)"
          Outputs="@(PreciseHistoryTestShader->'$(IntermediateOutputPath)test-shaders/%(Filename)_precise%(Extension).spv')">
    <MakeDir Directories="$(IntermediateOutputPath)test-shaders" />
    <Exec Command="&quot;$(Glslc)&quot; --target-env=vulkan1.3 -O -Werror -DTERTIUS_PRECISE_SPECULAR_HISTORY %(PreciseHistoryTestShader.Flags) -o &quot;$(IntermediateOutputPath)test-shaders/%(PreciseHistoryTestShader.Filename)_precise%(PreciseHistoryTestShader.Extension).spv&quot; &quot;%(PreciseHistoryTestShader.FullPath)&quot;" />
  </Target>

  <Target Name="EmbedPreciseHistoryTestShaders" DependsOnTargets="CompilePreciseHistoryTestShaders" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <_PreciseHistoryTestSpirv Include="@(PreciseHistoryTestShader->'$(IntermediateOutputPath)test-shaders/%(Filename)_precise%(Extension).spv')" />
      <EmbeddedResource Include="@(_PreciseHistoryTestSpirv)" LogicalName="Tertius.Rendering.Shaders.%(_PreciseHistoryTestSpirv.Filename)%(_PreciseHistoryTestSpirv.Extension)" WithCulture="false" />
    </ItemGroup>
  </Target>
</Project>
