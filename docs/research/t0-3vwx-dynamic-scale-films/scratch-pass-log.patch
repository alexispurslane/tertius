# <the controller's cost group> <ms>", to <folder>/pass-<TERTIUS_PROBE_LAMP_OFF, or "none">.txt.
--- a/src/Tertius.Rendering/VulkanRenderer.cs
+++ b/src/Tertius.Rendering/VulkanRenderer.cs
@@ -913,6 +913,10 @@
             foreach (PassTiming probePass in probeTimings.Passes.Span)
             {
                 RenderScaleController.CostGroup probeGroup = RenderScaleController.CostGroupOf(probePass.Stage);
