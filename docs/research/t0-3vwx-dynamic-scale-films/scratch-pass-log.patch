+                if (Environment.GetEnvironmentVariable("TERTIUS_X_PASS_LOG") is { Length: > 0 } probePassFolder)
+                    System.IO.File.AppendAllText(System.IO.Path.Combine(System.IO.Directory.CreateDirectory(probePassFolder).FullName, $"pass-{(Environment.GetEnvironmentVariable("TERTIUS_PROBE_LAMP_OFF") is { Length: > 0 } probePassOff ? probePassOff : "none")}.txt"),
