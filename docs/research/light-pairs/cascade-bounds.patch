diff --git a/tests/Tertius.Rendering.Tests/CascadeBoundsRenderTests.cs b/tests/Tertius.Rendering.Tests/CascadeBoundsRenderTests.cs
new file mode 100644
index 000000000..54048a47c
--- /dev/null
+++ b/tests/Tertius.Rendering.Tests/CascadeBoundsRenderTests.cs
@@ -0,0 +1,130 @@
+using System.Numerics;
+using Tertius.Testing;
+
+namespace Tertius.Rendering.Tests;
+
+/// <summary>
+/// The bounds of the cascades on the GPU (ticket t2-mlvy): each texel of a cascade's bounds holds the least and the
+/// greatest depth of its window of the cascade, as a tile's bounds do for the tile, so that one fetch settles a lookup
+/// whose every tap agrees. A box stands 5 m ahead of the camera under a sun.
+/// </summary>
+[Collection(GpuCollection.Name)]
+public sealed class CascadeBoundsRenderTests
+{
+    /// <summary>The smallest cascade, so that the readbacks stay small.</summary>
+    private const int MapSize = ShadowMap.MinimumSize;
+
+    private static VulkanRenderer Renderer() =>
+        VulkanRenderer.CreateHeadless(
+            new()
+            {
+                Validation = true,
+                Width = 160,
+                Height = 90,
+                ShadowMapSize = MapSize,
+                Bloom = new NoBloom(),
+                Upscaling = new NoUpscaling(),
+            }
+        );
+
+    /// <summary>A snapshot of a box that casts a shadow under a sun high over the camera's right shoulder.</summary>
+    private static RenderSnapshot BoxUnderASun(VulkanRenderer renderer)
+    {
+        RenderSnapshot snapshot = Gpu.Snapshot(new(0.3f, 1f, 0.2f));
+        snapshot.Instances.Add(
+            Gpu.Instance(
+                mesh: renderer.CreateMesh(Primitives.Box(new(0.5f))),
+                material: renderer.CreateMaterial(MaterialDesc.Color(Vector4.One, roughness: 0.38f)),
+                position: new(0, 0, -5),
+                scale: Vector3.One,
+                flags: RenderFlags.CastsShadow,
+                chainDepth: TestChains.CamerasFrame
+            )
+        );
+        return snapshot;
+    }
+
+    /// <summary>
+    /// How many texels of the bounds of a cascade differ from the least and the greatest depth of the cascade in their
+    /// window: texel k of a bounds row covers the cascade's texels 2k to 2k + 5 along each axis, clamped to the cascade.
+    /// </summary>
+    private static int BoundsMismatches(float[] cascade, float[] bounds)
+    {
+        const int half = MapSize / 2;
+        bounds.Length.Should().Be(half * half * 2, "a bounds texel holds the least and the greatest depth");
+        int mismatches = 0;
+        for (int ky = 0; ky < half; ky++)
+        {
+            for (int kx = 0; kx < half; kx++)
+            {
+                float least = float.MaxValue,
+                    most = float.MinValue;
+                for (int y = 2 * ky; y < 2 * ky + 6; y++)
+                {
+                    for (int x = 2 * kx; x < 2 * kx + 6; x++)
+                    {
+                        float depth = cascade[Math.Min(y, MapSize - 1) * MapSize + Math.Min(x, MapSize - 1)];
+                        least = Math.Min(least, depth);
+                        most = Math.Max(most, depth);
+                    }
+                }
+
+                int texel = 2 * (ky * half + kx);
+                if (bounds[texel] != least || bounds[texel + 1] != most)
+                    mismatches++;
+            }
+        }
+
+        return mismatches;
+    }
+
+    [Fact]
+    public void EachCascadesBoundsHoldTheLeastAndTheGreatestDepthOfEveryWindow()
+    {
+        VulkanRenderer renderer = Renderer();
+        try
+        {
+            renderer.Render(BoxUnderASun(renderer), 1f);
+
+            // The nearest cascade holds the box. A cascade that no caster touches is cleared, and its bounds hold the
+            // cleared depth.
+            renderer.ReadShadowCascade(set: 0, cascade: 0).Should().Contain(depth => depth > 0, "cascade 0 holds the box");
+            for (int cascade = 0; cascade < ShadowCascades.Count; cascade++)
+            {
+                float[] depths = renderer.ReadShadowCascade(set: 0, cascade: cascade);
+                BoundsMismatches(cascade: depths, bounds: renderer.ReadShadowCascadeBounds(set: 0, cascade: cascade))
+                    .Should()
+                    .Be(0, "the bounds of cascade {0} are those of its own windows", cascade);
+            }
+        }
+        finally
+        {
+            Gpu.DisposeAndAssertClean(renderer);
+        }
+    }
+
+    [Fact]
+    public void TheBoundsFollowACasterThatMoves()
+    {
+        // The cascades draw in every frame, so their bounds are those of the frame, not those of an earlier one.
+        VulkanRenderer renderer = Renderer();
+        try
+        {
+            RenderSnapshot snapshot = BoxUnderASun(renderer);
+            renderer.Render(snapshot, 1f);
+            float[] before = renderer.ReadShadowCascadeBounds(set: 0, cascade: 0);
+            RenderInstance box = snapshot.Instances[0];
+            snapshot.Instances[0] = box with { Position = box.Position + new Vector3(0.7f, 0, 0), PreviousPosition = box.Position };
+
+            renderer.Render(snapshot, 1f);
+
+            float[] after = renderer.ReadShadowCascadeBounds(set: 0, cascade: 0);
+            after.Should().NotEqual(before, "the box moved across the cascade");
+            BoundsMismatches(cascade: renderer.ReadShadowCascade(set: 0, cascade: 0), bounds: after).Should().Be(0);
+        }
+        finally
+        {
+            Gpu.DisposeAndAssertClean(renderer);
+        }
+    }
+}
