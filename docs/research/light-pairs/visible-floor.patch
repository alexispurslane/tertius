diff --git a/src/Tertius.Rendering/LightPairSetting.cs b/src/Tertius.Rendering/LightPairSetting.cs
new file mode 100644
index 000000000..338fcea15
--- /dev/null
+++ b/src/Tertius.Rendering/LightPairSetting.cs
@@ -0,0 +1,63 @@
+namespace Tertius.Rendering;
+
+/// <summary>
+/// Every pair of a shaded point and a light in whose reach it lies is shaded in full, as before the visible floor
+/// (ticket t2-mlvy).
+/// </summary>
+public readonly record struct EveryLightPair;
+
+/// <summary>
+/// A pair of a shaded point and a light is shaded only as far as its light can show (ticket t2-mlvy). The shown light of a
+/// pair is the most pre-exposed radiance that the light adds to the point before its shadow. A pair whose shown light is at
+/// most the floor adds nothing and takes no shadow lookup. A pair between one and two floors adds its light times its
+/// share (<see cref="Share"/>). A pair of two floors or more is shaded in full. The shown light is continuous in the
+/// light's place, the point's place and the exposure, so no light switches on or off at once.
+/// </summary>
+/// <param name="FloorStops">
+/// The floor as stops below a pre-exposed radiance of 1: the floor is 2^−FloorStops. From <see cref="LeastStops"/> to
+/// <see cref="MostStops"/>.
+/// </param>
+public readonly record struct VisibleLightPairs(float FloorStops)
+{
+    /// <summary>The highest floor: 2^−4, a third of the mid-grey of 0.18.</summary>
+    public const float LeastStops = 4;
+
+    /// <summary>The lowest floor: 2^−13, the cutoff radiance of the reach (<see cref="LightUnits.CutoffRadiance"/>).</summary>
+    public const float MostStops = 13;
+
+    /// <summary>The floor, a pre-exposed radiance: 2^−<see cref="FloorStops"/>.</summary>
+    public float Floor => MathF.Pow(2, -FloorStops);
+
+    /// <summary>
+    /// The share of its light that a pair of <paramref name="shown"/> shown light adds: 0 at one floor or less, 1 at two
+    /// floors or more, and even in between. pairShare in lighting.glsl is the copy.
+    /// </summary>
+    public double Share(double shown) => Math.Clamp(shown / Floor - 1, 0, 1);
+}
+
+/// <summary>
+/// Which pairs of a shaded point and a light the renderer shades: <see cref="EveryLightPair"/> or
+/// <see cref="VisibleLightPairs"/>. The default value is EveryLightPair. It is a generated union (see
+/// <see cref="GeneratedUnionAttribute"/>).
+/// </summary>
+[GeneratedUnion(typeof(EveryLightPair), typeof(VisibleLightPairs), ZeroCase = typeof(EveryLightPair))]
+public readonly partial struct LightPairSetting
+{
+    /// <summary>Why the renderer cannot use the setting, or null when it can.</summary>
+    internal string? Problem =>
+        this switch
+        {
+            EveryLightPair => null,
+            VisibleLightPairs { FloorStops: >= VisibleLightPairs.LeastStops and <= VisibleLightPairs.MostStops } => null,
+            VisibleLightPairs visible =>
+                $"VisibleLightPairs.FloorStops must be {VisibleLightPairs.LeastStops} to {VisibleLightPairs.MostStops}, not {visible.FloorStops}.",
+        };
+
+    /// <summary>The floor that the shaders take, a pre-exposed radiance, or 0 for every pair.</summary>
+    internal float Floor =>
+        this switch
+        {
+            EveryLightPair => 0,
+            VisibleLightPairs visible => visible.Floor,
+        };
+}
