diff --git a/tests/Tertius.Rendering.Tests/VisibleLightPairRenderTests.cs b/tests/Tertius.Rendering.Tests/VisibleLightPairRenderTests.cs
new file mode 100644
index 000000000..d62c59e65
--- /dev/null
+++ b/tests/Tertius.Rendering.Tests/VisibleLightPairRenderTests.cs
@@ -0,0 +1,154 @@
+using System.Numerics;
+using Tertius.Testing;
+
+namespace Tertius.Rendering.Tests;
+
+/// <summary>
+/// The visible floor of the light pairs on the GPU (ticket t2-mlvy): under <see cref="VisibleLightPairs"/>, a lamp whose
+/// light shows below the floor adds nothing, a lamp far above the floor lights as without the floor, and a lamp in
+/// between adds its share. The exposure is fixed at 0 stops, so the HDR image holds plain radiance. A matte white square
+/// stands 3 m ahead of the camera and faces it, with no ambient light.
+/// </summary>
+[Collection(GpuCollection.Name)]
+public sealed class VisibleLightPairRenderTests
+{
+    private const int Width = 320,
+        Height = 180;
+
+    /// <summary>The highest floor, 2^−4 = 0.0625, so that lamps of a few watts lie on both of its sides.</summary>
+    private static readonly VisibleLightPairs Floor = new(FloorStops: VisibleLightPairs.LeastStops);
+
+    private static readonly Vector3 Center = new(0, 0, -3);
+
+    private static VulkanRenderer Renderer(LightPairSetting lightPairs) =>
+        Gpu.Headless(width: Width, height: Height, lightPairs: lightPairs);
+
+    /// <summary>A dark snapshot with the square and <paramref name="light"/>.</summary>
+    private static RenderSnapshot Scene(VulkanRenderer renderer, RenderLight light)
+    {
+        RenderSnapshot snapshot = Gpu.Snapshot(Vector3.UnitY, starIrradiance: 0);
+        snapshot.Ambient.Intensity = 0;
+        snapshot.Instances.Add(
+            Gpu.Instance(
+                mesh: renderer.CreateMesh(Primitives.Plane(0.5f)),
+                material: renderer.CreateMaterial(new(BaseColor: Vector4.One, Roughness: 1, Reflectance: 0.5f)),
+                position: Center,
+                scale: Vector3.One,
+                rotation: Quaternion.CreateFromAxisAngle(Vector3.UnitX, MathF.PI / 2),
+                radius: 0.75f,
+                chainDepth: TestChains.CamerasFrame
+            )
+        );
+        snapshot.Lights.Add(light);
+        return snapshot;
+    }
+
+    /// <summary>A bulb of <paramref name="power"/> W, 1 m in front of the square's center, with no shadow.</summary>
+    private static RenderLight Bulb(float power) =>
+        Gpu.Lamp(position: new(0, 0, -2), color: Vector3.One, intensity: 0, chainDepth: TestChains.CamerasFrame) with
+        {
+            Power = power,
+        };
+
+    /// <summary>A panel 0.4 m square of <paramref name="power"/> W, 1 m in front of the square's center and facing it, with no shadow.</summary>
+    private static RenderLight Panel(float power) =>
+        new RectRenderLight(
+            EntityIndex: Gpu.LampEntity,
+            EntityGeneration: 0,
+            Position: new(0, 0, -2),
+            PreviousPosition: new(0, 0, -2),
+            Rotation: Quaternion.CreateFromAxisAngle(Vector3.UnitY, MathF.PI),
+            PreviousRotation: Quaternion.CreateFromAxisAngle(Vector3.UnitY, MathF.PI),
+            Color: Vector3.One,
+            Power: power,
+            Width: 0.4f,
+            Height: 0.4f,
+            CastsShadow: false,
+            ChainDepth: TestChains.CamerasFrame
+        );
+
+    /// <summary>The radiance of the HDR image's pixel that sees the square's center, under <paramref name="light"/>.</summary>
+    private static float RadianceAtTheCenter(LightPairSetting lightPairs, RenderLight light)
+    {
+        VulkanRenderer renderer = Renderer(lightPairs);
+        try
+        {
+            renderer.Render(Scene(renderer, light), 1f);
+            float[] image = renderer.ReadHdr();
+            Vector2 pixel = Gpu.Project(point: Center, width: Width, height: Height);
+            return image[((int)pixel.Y * Width + (int)pixel.X) * 4];
+        }
+        finally
+        {
+            Gpu.DisposeAndAssertClean(renderer);
+        }
+    }
+
+    /// <summary>The radiance that a bulb of 1 W gives the square's center without a floor: a bulb's light grows with its power.</summary>
+    private static float BulbRadiancePerWatt() => RadianceAtTheCenter(default, Bulb(8)) / 8;
+
+    [Fact]
+    public void ABulbWhoseLightShowsBelowTheFloorAddsNothing()
+    {
+        float perWatt = BulbRadiancePerWatt();
+        float power = 0.8f * Floor.Floor / perWatt;
+
+        RadianceAtTheCenter(default, Bulb(power)).Should().BeApproximately(0.8f * Floor.Floor, 0.02f * Floor.Floor);
+        RadianceAtTheCenter(new(Floor), Bulb(power)).Should().Be(0, "the bulb shows 0.8 floors at the square's center");
+    }
+
+    [Fact]
+    public void ABulbFarAboveTheFloorLightsTheSquareAsWithoutTheFloor()
+    {
+        float power = 4 * Floor.Floor / BulbRadiancePerWatt();
+
+        RadianceAtTheCenter(new(Floor), Bulb(power))
+            .Should()
+            .Be(RadianceAtTheCenter(default, Bulb(power)), "a pair of four floors is shaded in full");
+    }
+
+    [Fact]
+    public void ABulbBetweenOneAndTwoFloorsAddsItsShare()
+    {
+        float power = 1.5f * Floor.Floor / BulbRadiancePerWatt();
+
+        float whole = RadianceAtTheCenter(default, Bulb(power));
+        RadianceAtTheCenter(new(Floor), Bulb(power))
+            .Should()
+            .BeApproximately(0.5f * whole, 0.03f * whole, "a pair of 1.5 floors adds half its light");
+    }
+
+    [Fact]
+    public void APanelWhoseLightShowsFarBelowTheFloorAddsNothing()
+    {
+        // The panel's bound holds more than its light, so only a panel well below the floor is sure to add nothing.
+        float perWatt = RadianceAtTheCenter(default, Panel(8)) / 8;
+        float power = 0.3f * Floor.Floor / perWatt;
+
+        RadianceAtTheCenter(default, Panel(power)).Should().BeGreaterThan(0.25f * Floor.Floor);
+        RadianceAtTheCenter(new(Floor), Panel(power)).Should().Be(0, "the panel shows 0.3 floors at the square's center");
+    }
+
+    [Fact]
+    public void APanelFarAboveTheFloorLightsTheSquareAsWithoutTheFloor()
+    {
+        float perWatt = RadianceAtTheCenter(default, Panel(8)) / 8;
+        float power = 4 * Floor.Floor / perWatt;
+
+        RadianceAtTheCenter(new(Floor), Panel(power))
+            .Should()
+            .Be(RadianceAtTheCenter(default, Panel(power)), "a pair of four floors is shaded in full");
+    }
+
+    [Fact]
+    public void APanelBetweenOneAndTwoFloorsAddsAtLeastTheShareOfItsLight()
+    {
+        // The panel's share comes from its bound, which is at least its light: the share is at least that of the light
+        // itself, a half at 1.5 floors, and at most the whole.
+        float perWatt = RadianceAtTheCenter(default, Panel(8)) / 8;
+        float power = 1.5f * Floor.Floor / perWatt;
+
+        float whole = RadianceAtTheCenter(default, Panel(power));
+        RadianceAtTheCenter(new(Floor), Panel(power)).Should().BeInRange(0.47f * whole, whole);
+    }
+}
diff --git a/tests/Tertius.Rendering.Tests/VisibleLightPairTests.cs b/tests/Tertius.Rendering.Tests/VisibleLightPairTests.cs
new file mode 100644
index 000000000..fdf168590
--- /dev/null
+++ b/tests/Tertius.Rendering.Tests/VisibleLightPairTests.cs
@@ -0,0 +1,182 @@
+using System.Numerics;
+
+namespace Tertius.Rendering.Tests;
+
+/// <summary>
+/// The visible floor of the light pairs in C# (ticket t2-mlvy): the share of its light that a pair adds by its shown
+/// light, and the rectangle's bound that weighs its pair, which never falls below the light that the face really gives.
+/// </summary>
+public sealed class VisibleLightPairTests
+{
+    /// <summary>A floor of 2^−9, about 1 % of the mid-grey of 0.18.</summary>
+    private static readonly VisibleLightPairs Floor9 = new(FloorStops: 9);
+
+    [Theory]
+    [InlineData(0)]
+    [InlineData(0.5)]
+    [InlineData(1)]
+    public void APairThatShowsAtMostOneFloorAddsNothing(double floors)
+    {
+        Floor9.Share(floors * Floor9.Floor).Should().Be(0);
+    }
+
+    [Theory]
+    [InlineData(2)]
+    [InlineData(3)]
+    [InlineData(1000)]
+    public void APairThatShowsTwoFloorsOrMoreAddsAllItsLight(double floors)
+    {
+        Floor9.Share(floors * Floor9.Floor).Should().Be(1);
+    }
+
+    [Fact]
+    public void APairBetweenOneAndTwoFloorsAddsAnEvenShare()
+    {
+        Floor9.Share(1.25 * Floor9.Floor).Should().BeApproximately(0.25, 1e-12);
+        Floor9.Share(1.5 * Floor9.Floor).Should().BeApproximately(0.5, 1e-12);
+    }
+
+    [Fact]
+    public void TheLightThatAPairAddsNeverJumpsAsItsShownLightGrows()
+    {
+        // The added light is the share times the shown light. Over steps of a thousandth of a floor, it never falls, and
+        // it never rises by more than the step times the steepest slope of x (x − 1) on [1, 2], which is 3.
+        double floor = Floor9.Floor;
+        double step = floor / 1000;
+        double last = 0;
+        for (double shown = 0; shown <= 3 * floor; shown += step)
+        {
+            double added = Floor9.Share(shown) * shown;
+            (added - last).Should().BeInRange(0, 3.001 * step, "the light at {0} floors follows the light before it", shown / floor);
+            last = added;
+        }
+    }
+
+    [Fact]
+    public void ALowerFloorKeepsAPairThatAHigherFloorDrops()
+    {
+        double shown = 1.5 / 512;
+
+        new VisibleLightPairs(FloorStops: 8).Share(shown).Should().Be(0, "1.5 / 512 is under the floor of 1 / 256");
+        new VisibleLightPairs(FloorStops: 10).Share(shown).Should().Be(1, "1.5 / 512 is three floors of 1 / 1024");
+    }
+
+    [Theory]
+    [InlineData(3.9f)]
+    [InlineData(13.1f)]
+    [InlineData(float.NaN)]
+    public void AFloorOutsideItsRangeIsRefused(float stops)
+    {
+        new LightPairSetting(new VisibleLightPairs(FloorStops: stops)).Problem.Should().Contain("FloorStops");
+    }
+
+    [Fact]
+    public void EveryLightPairGivesTheShadersNoFloor()
+    {
+        default(LightPairSetting).Floor.Should().Be(0);
+        default(LightPairSetting).Problem.Should().BeNull();
+        new LightPairSetting(new VisibleLightPairs(FloorStops: 9)).Floor.Should().Be(1f / 512);
+    }
+
+    /// <summary>
+    /// Rectangles seen from a point at the origin, by name: near and far, facing and edge-on, above and across the horizon
+    /// of the normals of <see cref="Normals"/>.
+    /// </summary>
+    public static TheoryData<string> Rectangles =>
+        ["overhead", "far-overhead", "far-aside", "edge-on", "wall", "touching", "tilted"];
+
+    private static RectView RectNamed(string name) =>
+        name switch
+        {
+            // The deck's panel, 1.2 m square, facing down from 3 m above the point.
+            "overhead" => FacingDown(center: new(0, 3, 0), side: 1.2),
+            "far-overhead" => FacingDown(center: new(0, 30, 0), side: 1.2),
+            // 20 m along the floor from under the panel: the panel shows at a slant of about 81°.
+            "far-aside" => FacingDown(center: new(20, 3, 4), side: 1.2),
+            // 1 cm below the panel's plane and 2 m aside: the panel shows almost edge-on.
+            "edge-on" => FacingDown(center: new(2, 0.01, 0), side: 1.2),
+            // A panel on a wall 2 m ahead that faces the point.
+            "wall" => new(toCenter: new(0, 1, 2), halfWidth: new(-0.6, 0, 0), halfHeight: new(0, 0.6, 0)),
+            // 5 cm under the middle of the panel, which fills most of the sky.
+            "touching" => FacingDown(center: new(0.1, 0.05, 0.1), side: 1.2),
+            "tilted" => Turned(center: new(0.8, 1.2, -0.4), width: 0.9, height: 0.4),
+            _ => throw new ArgumentOutOfRangeException(nameof(name), name, "No such rectangle."),
+        };
+
+    /// <summary>A square panel of <paramref name="side"/> m centered <paramref name="center"/> from the point, whose front is −Y.</summary>
+    private static RectView FacingDown(Double3 center, double side) =>
+        new(toCenter: center, halfWidth: new(side / 2, 0, 0), halfHeight: new(0, 0, side / 2));
+
+    /// <summary>A panel turned about two axes, so that no side lies along a world axis.</summary>
+    private static RectView Turned(Double3 center, double width, double height)
+    {
+        Quaternion turn = Quaternion.Normalize(
+            Quaternion.CreateFromAxisAngle(Vector3.UnitY, 0.7f) * Quaternion.CreateFromAxisAngle(Vector3.UnitX, 2.1f)
+        );
+        return new(
+            toCenter: center,
+            halfWidth: Vector3.Transform(Vector3.UnitX, turn) * (float)(width / 2),
+            halfHeight: Vector3.Transform(Vector3.UnitY, turn) * (float)(height / 2)
+        );
+    }
+
+    /// <summary>Unit normals on a grid of the whole sphere, 15° apart.</summary>
+    private static IEnumerable<Double3> Normals()
+    {
+        for (int polar = 0; polar <= 12; polar++)
+        for (int around = 0; around < 24; around++)
+        {
+            double theta = polar * Math.PI / 12,
+                phi = around * Math.PI / 12;
+            yield return new(Math.Sin(theta) * Math.Cos(phi), Math.Cos(theta), Math.Sin(theta) * Math.Sin(phi));
+        }
+    }
+
+    [Theory]
+    [MemberData(nameof(Rectangles))]
+    public void ARectanglesBoundIsNeverBelowTheLightThatItsFaceGives(string name)
+    {
+        RectView rect = RectNamed(name);
+        rect.InFront.Should().BeTrue("each rectangle of the list faces the point");
+
+        foreach (Double3 normal in Normals())
+            rect.CosineBound(normal)
+                .Should()
+                .BeGreaterThanOrEqualTo(
+                    rect.ClippedCosine(normal) * (1 - 1e-9),
+                    "the bound holds the face's cosine integral for the normal {0}",
+                    normal
+                );
+    }
+
+    [Fact]
+    public void ARectanglesBoundIsPositiveWhereAnyOfItsFaceLiesAboveTheHorizon()
+    {
+        // The wall panel's center lies 1 m up and 2 m ahead. For a normal that leans back, its center is below the
+        // horizon and its upper edge is above it, so the face still gives light.
+        RectView wall = RectNamed("wall");
+        Double3 leaningBack = new Double3(0, 2, -1.2).Normalized();
+        Double3.Dot(leaningBack, wall.ToCenter).Should().BeNegative("the center lies below this horizon");
+
+        wall.ClippedCosine(leaningBack).Should().BePositive();
+        wall.CosineBound(leaningBack).Should().BePositive();
+    }
+
+    [Fact]
+    public void AFarRectanglesBoundComesCloseToItsLight()
+    {
+        // 25 panel half diagonals away the face is nearly a point, so the bound holds little more than the light.
+        RectView far = RectNamed("far-overhead");
+
+        far.CosineBound(Double3.UnitY).Should().BeLessThan(far.ClippedCosine(Double3.UnitY) * 1.2);
+    }
+
+    [Fact]
+    public void ARectangleBehindThePointHasNoBound()
+    {
+        // The panel faces down and the point lies 1 m above it.
+        RectView above = FacingDown(center: new(0, -1, 0), side: 1.2);
+
+        above.CosineBound(-Double3.UnitY).Should().Be(0);
+    }
+}
