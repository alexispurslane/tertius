diff --git a/src/Tertius.Rendering/Frame/KeyFillImages.cs b/src/Tertius.Rendering/Frame/KeyFillImages.cs
new file mode 100644
index 000000000..0e791a62e
--- /dev/null
+++ b/src/Tertius.Rendering/Frame/KeyFillImages.cs
@@ -0,0 +1,129 @@
+using System.Diagnostics.CodeAnalysis;
+using Silk.NET.Vulkan;
+
+namespace Tertius.Rendering;
+
+/// <summary>
+/// The images and the tile records of key and fill (docs/plans/light-pairs.md, "Key and fill"), under
+/// <see cref="KeyAndFill"/>: the three images that the corner pass draws, one texel per corner of the tile grid, and the
+/// buffer of one record per tile that the tile pass writes and the direct pass reads, at
+/// <see cref="TilesBinding"/> of the G-buffer set. All have the size of the targets' largest render size. A frame of a
+/// smaller render size uses the first corners and tiles of each, and its tiles count from the frame's own width
+/// (Shaders/key_fill.glsl).
+/// </summary>
+internal sealed unsafe class KeyFillImages : IDisposable
+{
+    /// <summary>The binding of the tile records in the G-buffer set.</summary>
+    public const uint TilesBinding = 7;
+
+    /// <summary>The bytes of one tile's record, LightTile in key_fill.glsl: std430.</summary>
+    public const ulong TileBytes = 272;
+
+    /// <summary>The format of the two fill images: the fill's light is plain irradiance, which no half float holds.</summary>
+    private const Format FillFormat = Format.R32G32B32A32Sfloat;
+
+    /// <summary>The format of the key image: one key per channel.</summary>
+    private const Format KeyFormat = Format.R32G32B32A32Uint;
+
+    private readonly VulkanDevice device;
+    private readonly DeviceAllocator allocator;
+    private readonly DescriptorLayouts layouts;
+
+    public KeyFillImages(VulkanDevice device, DeviceAllocator allocator, DescriptorLayouts layouts, RenderTargets targets)
+    {
+        this.device = device;
+        this.allocator = allocator;
+        this.layouts = layouts;
+        Set = layouts.AllocateKeyFillTilesSet();
+        Create(targets);
+    }
+
+    /// <summary>The fill's light of each corner, and its scale (key_fill_corners.frag).</summary>
+    public GpuImage FillLight { get; private set; }
+
+    /// <summary>The fill's direction sum of each corner, and the corner's distance to the eye.</summary>
+    public GpuImage FillDirection { get; private set; }
+
+    /// <summary>The keys of each corner.</summary>
+    public GpuImage Keys { get; private set; }
+
+    /// <summary>The tile records, <see cref="TileBytes"/> each, in rows of the frame's tiles.</summary>
+    public GpuBuffer Tiles { get; private set; }
+
+    /// <summary>The set of <see cref="DescriptorLayouts.KeyFillTilesLayout"/>: the three corner images and the tile records.</summary>
+    public DescriptorSet Set { get; }
+
+    /// <summary>The tiles of a render size of <paramref name="extent"/> along each axis. The corners are one more.</summary>
+    public static Extent2D TilesOf(Extent2D extent) =>
+        new(
+            (extent.Width + KeyAndFill.TileSize - 1) / KeyAndFill.TileSize,
+            (extent.Height + KeyAndFill.TileSize - 1) / KeyAndFill.TileSize
+        );
+
+    /// <summary>The corners of a render size of <paramref name="extent"/> along each axis.</summary>
+    public static Extent2D CornersOf(Extent2D extent)
+    {
+        Extent2D tiles = TilesOf(extent);
+        return new(tiles.Width + 1, tiles.Height + 1);
+    }
+
+    /// <summary>
+    /// Recreates the images and the records at the targets' size and rewrites both sets. The device must be idle, and the
+    /// targets resized first.
+    /// </summary>
+    public void Resize(RenderTargets targets)
+    {
+        Destroy();
+        Create(targets);
+    }
+
+    [MemberNotNull(nameof(FillLight), nameof(FillDirection), nameof(Keys), nameof(Tiles))]
+    private void Create(RenderTargets targets)
+    {
+        Extent2D corners = CornersOf(targets.Extent);
+        Extent2D tiles = TilesOf(targets.Extent);
+        FillLight = CreateImage(extent: corners, format: FillFormat, name: "key fill light");
+        FillDirection = CreateImage(extent: corners, format: FillFormat, name: "key fill direction");
+        Keys = CreateImage(extent: corners, format: KeyFormat, name: "key fill keys");
+        Tiles = GpuBuffer.Create(
+            device: device,
+            allocator: allocator,
+            size: (ulong)tiles.Width * tiles.Height * TileBytes,
+            usage: BufferUsageFlags.StorageBufferBit,
+            memoryUsage: MemoryUsage.GpuOnly,
+            name: "key fill tiles"
+        );
+        layouts.WriteImage(set: Set, binding: 0, arrayElement: 0, image: FillLight);
+        layouts.WriteImage(set: Set, binding: 1, arrayElement: 0, image: FillDirection);
+        layouts.WriteImage(set: Set, binding: 2, arrayElement: 0, image: Keys);
+        layouts.WriteBuffer(set: Set, binding: 3, type: DescriptorType.StorageBuffer, buffer: Tiles);
+        layouts.WriteBuffer(
+            set: targets.GBufferSet,
+            binding: TilesBinding,
+            type: DescriptorType.StorageBuffer,
+            buffer: Tiles
+        );
+    }
+
+    private GpuImage CreateImage(Extent2D extent, Format format, string name) =>
+        GpuImage.Create(
+            device: device,
+            allocator: allocator,
+            extent: extent,
+            format: format,
+            usage: ImageUsageFlags.ColorAttachmentBit | ImageUsageFlags.SampledBit,
+            mipLevels: 1,
+            name: name
+        );
+
+    private void Destroy()
+    {
+        FillLight.Dispose();
+        FillDirection.Dispose();
+        Keys.Dispose();
+        Tiles.Dispose();
+    }
+
+    // The pool of the layouts frees the set.
+    public void Dispose() => Destroy();
+}
