@@ -0,0 +1,106 @@
+namespace Tertius.Rendering.Tests;
+
+/// <summary>
+/// The key share of a light at a screen corner (docs/plans/light-pairs.md, "Key and fill"): which lights a corner shades
+/// in full, and how a light moves between key and fill.
+/// </summary>
+public sealed class KeyAndFillTests
+{
+    /// <summary>The key shares of lights of <paramref name="importances"/> at a corner of <paramref name="split"/>.</summary>
+    private static double[] KeyShares(KeyAndFill split, params double[] importances)
+    {
+        double threshold = split.Threshold(importances);
+        return [.. importances.Select(importance => KeyAndFill.KeyShare(importance, threshold))];
+    }
+
+    [Fact]
+    public void ACornerWithNoMoreLightsThanItsKeyLightsShadesEveryLightInFull() =>
+        KeyShares(new KeyAndFill(KeyLights: 3), 5, 0.01, 200).Should().Equal(1, 1, 1);
+
+    [Fact]
+    public void ALightThatShowsNothingAtTheCornerHasNoKeyShare() =>
+        KeyShares(new KeyAndFill(KeyLights: 3), 5, 0, 200).Should().Equal(1, 0, 1);
+
+    [Theory]
+    [InlineData(1)]
+    [InlineData(2)]
+    [InlineData(4)]
+    public void AtMostTheKeyLightsOfACornerHaveAKeyShare(int keyLights)
+    {
+        double[] importances = [0.4, 7, 3, 3.5, 0.9, 12, 2.2, 5, 1.1, 6.5];
+
+        double[] shares = KeyShares(new KeyAndFill(keyLights), importances);
+
+        shares.Count(share => share > 0).Should().BeLessThanOrEqualTo(keyLights);
+    }
+
+    [Fact]
+    public void TheLightsWithAKeyShareAreTheMostImportantOnes()
+    {
+        double[] shares = KeyShares(new KeyAndFill(KeyLights: 2), 1, 9, 2, 30, 4);
+
+        // The third most important light, of 4, is the threshold: 9 and 30 are both more than twice it.
+        shares.Should().Equal(0, 1, 0, 1, 0);
+    }
+
+    [Fact]
+    public void ALightBetweenOneAndTwoThresholdsSharesItsLightBetweenKeyAndFill()
+    {
+        double[] shares = KeyShares(new KeyAndFill(KeyLights: 1), 6, 4);
+
+        // 6 is one and a half times the threshold of 4.
+        shares[0].Should().BeApproximately(0.5, 1e-12);
+        shares[1].Should().Be(0);
+    }
+
+    [Fact]
+    public void ALightThatPassesAnotherInImportanceChangesNoShareAtOnce()
+    {
+        var split = new KeyAndFill(KeyLights: 2);
+        // The second light rises from below the third to above the first, in small steps.
+        double[] before = KeyShares(split, 5, 1, 3, 2.5);
+        for (double importance = 1; importance <= 8; importance += 0.01)
+        {
+            double[] after = KeyShares(split, 5, importance, 3, 2.5);
+            for (int light = 0; light < after.Length; light++)
+                Math.Abs(after[light] - before[light])
+                    .Should()
+                    .BeLessThan(0.02, "light {0} must not jump at importance {1}", light, importance);
+            before = after;
+        }
+    }
+
+    [Fact]
+    public void TheSharesStayTheSameWhenEveryImportanceTakesOneFactor()
+    {
+        var split = new KeyAndFill(KeyLights: 2);
+        double[] importances = [0.4, 7, 3, 3.5, 0.9];
+
+        double[] dim = KeyShares(split, [.. importances.Select(importance => importance * 1e-6)]);
+
+        // The exposure scales every light's shown radiance alike, so it must not move a light between key and fill.
+        double[] plain = KeyShares(split, importances);
+        for (int light = 0; light < plain.Length; light++)
+            dim[light].Should().BeApproximately(plain[light], 1e-9);
+    }
+
+    [Theory]
+    [InlineData(0)]
+    [InlineData(5)]
+    [InlineData(-1)]
+    public void AKeyLightCountOutsideOneToFourHasAProblem(int keyLights) =>
+        new LightPairSetting(new KeyAndFill(keyLights)).Problem.Should().Contain("KeyAndFill.KeyLights");
+
+    [Theory]
+    [InlineData(1)]
+    [InlineData(4)]
+    public void AKeyLightCountFromOneToFourHasNoProblem(int keyLights) =>
+        new LightPairSetting(new KeyAndFill(keyLights)).Problem.Should().BeNull();
+
+    [Fact]
+    public void TheDefaultSettingShadesEveryPair()
+    {
+        default(LightPairSetting).KeyLights.Should().Be(0);
+        default(LightPairSetting).Problem.Should().BeNull();
+    }
+}
