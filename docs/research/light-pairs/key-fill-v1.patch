diff --git a/src/Tertius.Rendering/Passes/KeyFillPass.cs b/src/Tertius.Rendering/Passes/KeyFillPass.cs
new file mode 100644
index 000000000..9ef964f98
--- /dev/null
+++ b/src/Tertius.Rendering/Passes/KeyFillPass.cs
@@ -0,0 +1,137 @@
+using Silk.NET.Vulkan;
+
+namespace Tertius.Rendering;
+
+/// <summary>
+/// "Key and fill" (docs/plans/light-pairs.md, "Key and fill"), under <see cref="KeyAndFill"/>, right before the direct
+/// pass: the corner pass draws one fragment per corner of the frame's tile grid, which writes the corner's key lights and
+/// its fill (Shaders/key_fill_corners.frag), and the tile pass gathers each tile's four corners into its record
+/// (Shaders/key_fill_tiles.comp), which the direct pass reads.
+/// </summary>
+internal sealed unsafe class KeyFillPass : RenderPass
+{
+    /// <summary>The width and the height of a workgroup of key_fill_tiles.comp: its local size.</summary>
+    private const uint GroupSize = 8;
+
+    private readonly VulkanDevice device;
+    private readonly DescriptorLayouts layouts;
+    private readonly KeyFillImages images;
+    private readonly Pipeline corners;
+    private readonly Pipeline tiles;
+
+    public KeyFillPass(
+        VulkanDevice device,
+        ShaderLibrary shaders,
+        DescriptorLayouts layouts,
+        ShaderConstants constants,
+        KeyFillImages images
+    )
+    {
+        this.device = device;
+        this.layouts = layouts;
+        this.images = images;
+        corners = new GraphicsPipelineDesc
+        {
+            Name = "key fill corners",
+            VertexShader = "lighting.vert",
+            FragmentShader = "key_fill_corners.frag",
+            Layout = layouts.SceneLayout,
+            ColorFormats = [images.FillLight.Format, images.FillDirection.Format, images.Keys.Format],
+            CullMode = CullModeFlags.None,
+            Constants = constants,
+        }.Create(device, shaders);
+        tiles = new ComputePipelineDesc
+        {
+            Name = "key fill tiles",
+            Shader = "key_fill_tiles.comp",
+            Layout = layouts.KeyFillTilesLayout,
+        }.Create(device, shaders);
+    }
+
+    public override string Name => "key and fill";
+
+    public override void Record(FrameContext context)
+    {
+        RecordCorners(context);
+        RecordTiles(context);
+    }
+
+    /// <summary>Draws the corners of the frame's render size into the first texels of the three corner images.</summary>
+    private void RecordCorners(FrameContext context)
+    {
+        RenderTargets targets = context.Targets;
+        BarrierBatch barriers = context.Barriers;
+        // As the direct pass declares them: the corner pass shades as it does.
+        foreach (GpuImage image in targets.GBuffer)
+            if (image != targets.Motion)
+                barriers.Image(image, ImageUse.SampledFragment);
+        barriers.Image(context.Shadows.Image, ImageUse.SampledFragment);
+        context.ShadowAtlas?.DeclareSampled(barriers, ImageUse.SampledFragment);
+        // Discarded: the tile pass reads only the corners that this draw writes.
+        barriers.Image(images.FillLight, ImageUse.ColorAttachment, discard: true);
+        barriers.Image(images.FillDirection, ImageUse.ColorAttachment, discard: true);
+        barriers.Image(images.Keys, ImageUse.ColorAttachment, discard: true);
+        barriers.Flush(context.Vk, context.CommandBuffer);
+        context.BeginRenderingInto([
+            (images.FillLight, AttachmentLoadOp.DontCare),
+            (images.FillDirection, AttachmentLoadOp.DontCare),
+            (images.Keys, AttachmentLoadOp.DontCare),
+        ]);
+        context.Vk.CmdBindPipeline(context.CommandBuffer, PipelineBindPoint.Graphics, corners);
+        context.BindSceneSets();
+        context.SetViewport(KeyFillImages.CornersOf(context.Extent));
+        context.Vk.CmdDraw(
+            commandBuffer: context.CommandBuffer,
+            vertexCount: 3,
+            instanceCount: 1,
+            firstVertex: 0,
+            firstInstance: 0
+        );
+        context.Vk.CmdEndRendering(context.CommandBuffer);
+    }
+
+    /// <summary>Dispatches one invocation per tile of the frame's render size.</summary>
+    private void RecordTiles(FrameContext context)
+    {
+        BarrierBatch barriers = context.Barriers;
+        barriers.Image(images.FillLight, ImageUse.SampledCompute);
+        barriers.Image(images.FillDirection, ImageUse.SampledCompute);
+        barriers.Image(images.Keys, ImageUse.SampledCompute);
+        barriers.Buffer(images.Tiles, BufferUse.ComputeWrite);
+        barriers.Flush(context.Vk, context.CommandBuffer);
+        context.Vk.CmdBindPipeline(context.CommandBuffer, PipelineBindPoint.Compute, tiles);
+        DescriptorSet set = images.Set;
+        context.Vk.CmdBindDescriptorSets(
+            commandBuffer: context.CommandBuffer,
+            pipelineBindPoint: PipelineBindPoint.Compute,
+            layout: layouts.KeyFillTilesLayout,
+            firstSet: 0,
+            descriptorSetCount: 1,
+            pDescriptorSets: &set,
+            dynamicOffsetCount: 0,
+            pDynamicOffsets: null
+        );
+        Extent2D count = KeyFillImages.TilesOf(context.Extent);
+        var push = new KeyFillTilesPushConstants { TilesWide = count.Width, TilesHigh = count.Height };
+        context.Vk.CmdPushConstants(
+            commandBuffer: context.CommandBuffer,
+            layout: layouts.KeyFillTilesLayout,
+            stageFlags: ShaderStageFlags.ComputeBit,
+            offset: 0,
+            size: (uint)sizeof(KeyFillTilesPushConstants),
+            pValues: &push
+        );
+        context.Vk.CmdDispatch(
+            commandBuffer: context.CommandBuffer,
+            groupCountX: (count.Width + GroupSize - 1) / GroupSize,
+            groupCountY: (count.Height + GroupSize - 1) / GroupSize,
+            groupCountZ: 1
+        );
+    }
+
+    public override void Dispose()
+    {
+        device.Vk.DestroyPipeline(device.Device, corners, null);
+        device.Vk.DestroyPipeline(device.Device, tiles, null);
+    }
+}
