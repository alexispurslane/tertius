@@ -0,0 +1,162 @@
+using System.Numerics;
+using Tertius.Testing;
+
+namespace Tertius.Rendering.Tests;
+
+/// <summary>
+/// Key and fill on the GPU (docs/plans/light-pairs.md, "Key and fill"): a scene with no more lamps than key lights
+/// renders as with every light pair, the fill returns the diffuse light of the lamps that are not key, and no step
+/// shows at the edges of the screen tiles. The exposure is fixed at 0 stops, so the HDR image holds plain radiance. A
+/// square 3 m wide stands 3 m ahead of the camera and faces it, with no ambient light and bulbs 1 m in front of it.
+/// </summary>
+[Collection(GpuCollection.Name)]
+public sealed class KeyAndFillRenderTests
+{
+    private const int Width = 320,
+        Height = 180;
+
+    /// <summary>The bulbs in front of the square: the place of each on the plane 1 m in front of it, in m, and its power in W.</summary>
+    private static readonly (float X, float Y, float Power)[] Bulbs =
+    [
+        (-1.0f, 0.5f, 8),
+        (-0.3f, -0.4f, 3),
+        (0.4f, 0.6f, 5),
+        (1.0f, -0.2f, 2),
+        (0.0f, 0.0f, 1),
+        (0.7f, 0.7f, 4),
+    ];
+
+    /// <summary>A dark snapshot with the square of <paramref name="desc"/> and the first <paramref name="bulbs"/> bulbs, none with a shadow.</summary>
+    private static RenderSnapshot Scene(VulkanRenderer renderer, MaterialDesc desc, int bulbs)
+    {
+        RenderSnapshot snapshot = Gpu.Snapshot(Vector3.UnitY, starIrradiance: 0);
+        snapshot.Ambient.Intensity = 0;
+        snapshot.Instances.Add(
+            Gpu.Instance(
+                mesh: renderer.CreateMesh(Primitives.Plane(1.5f)),
+                material: renderer.CreateMaterial(desc),
+                position: new(0, 0, -3),
+                scale: Vector3.One,
+                rotation: Quaternion.CreateFromAxisAngle(Vector3.UnitX, MathF.PI / 2),
+                radius: 2.2f,
+                chainDepth: TestChains.CamerasFrame
+            )
+        );
+        foreach ((float x, float y, float power) in Bulbs.Take(bulbs))
+            snapshot.Lights.Add(
+                Gpu.Lamp(
+                    position: new(x, y, -2),
+                    color: Vector3.One,
+                    intensity: 0,
+                    chainDepth: TestChains.CamerasFrame
+                ) with
+                {
+                    Power = power,
+                }
+            );
+        return snapshot;
+    }
+
+    /// <summary>The red channel of the HDR image of the scene under <paramref name="lightPairs"/>, row by row from the top.</summary>
+    private static float[] Radiance(LightPairSetting lightPairs, MaterialDesc desc, int bulbs)
+    {
+        VulkanRenderer renderer = Gpu.Headless(width: Width, height: Height, lightPairs: lightPairs);
+        try
+        {
+            renderer.Render(Scene(renderer: renderer, desc: desc, bulbs: bulbs), 1f);
+            float[] image = renderer.ReadHdr();
+            return [.. Enumerable.Range(0, Width * Height).Select(pixel => image[pixel * 4])];
+        }
+        finally
+        {
+            Gpu.DisposeAndAssertClean(renderer);
+        }
+    }
+
+    /// <summary>A white square with no shine: its light is its diffuse light alone.</summary>
+    private static MaterialDesc Matte => new(BaseColor: Vector4.One, Roughness: 1, Reflectance: 0);
+
+    /// <summary>A white square whose shine shows each bulb as a soft highlight.</summary>
+    private static MaterialDesc Glossy => new(BaseColor: Vector4.One, Roughness: 0.4f, Reflectance: 0.5f);
+
+    [Theory]
+    [InlineData(1)]
+    [InlineData(3)]
+    public void ASceneWithNoMoreLampsThanKeyLightsRendersAsWithEveryLightPair(int bulbs)
+    {
+        float[] every = Radiance(lightPairs: default, desc: Glossy, bulbs: bulbs);
+
+        float[] split = Radiance(lightPairs: new(new KeyAndFill(KeyLights: 3)), desc: Glossy, bulbs: bulbs);
+
+        every.Max().Should().BeGreaterThan(0.01f, "the bulbs light the square");
+        for (int pixel = 0; pixel < every.Length; pixel++)
+            split[pixel]
+                .Should()
+                .BeApproximately(every[pixel], 1e-4f + 1e-3f * every[pixel], "pixel {0} takes every lamp as a key light", pixel);
+    }
+
+    [Theory]
+    [InlineData(1)]
+    [InlineData(2)]
+    [InlineData(4)]
+    public void TheFillReturnsTheDiffuseLightOfTheLampsThatAreNotKey(int keyLights)
+    {
+        float[] every = Radiance(lightPairs: default, desc: Matte, bulbs: Bulbs.Length);
+
+        float[] split = Radiance(lightPairs: new(new KeyAndFill(keyLights)), desc: Matte, bulbs: Bulbs.Length);
+
+        float brightest = every.Max();
+        brightest.Should().BeGreaterThan(0.01f, "the bulbs light the square");
+        for (int pixel = 0; pixel < every.Length; pixel++)
+            split[pixel]
+                .Should()
+                .BeApproximately(
+                    every[pixel],
+                    0.02f * every[pixel] + 0.002f * brightest,
+                    "pixel {0} keeps the diffuse light of all six bulbs",
+                    pixel
+                );
+    }
+
+    [Fact]
+    public void AnUnlitSceneStaysBlackUnderKeyAndFill()
+    {
+        float[] split = Radiance(lightPairs: new(new KeyAndFill(KeyLights: 3)), desc: Glossy, bulbs: 0);
+
+        split.Should().OnlyContain(radiance => radiance == 0);
+    }
+
+    [Fact]
+    public void NoStepShowsAtTheEdgesOfTheScreenTiles()
+    {
+        // Two key lights of six bulbs on a glossy square: the key shares differ from corner to corner.
+        float[] split = Radiance(lightPairs: new(new KeyAndFill(KeyLights: 2)), desc: Glossy, bulbs: Bulbs.Length);
+
+        // The mean change from a pixel to its right neighbor, across a tile edge and inside a tile. A step at the tile
+        // edges adds its height to the first mean alone.
+        double acrossEdges = 0,
+            inside = 0;
+        int edgePairs = 0,
+            insidePairs = 0;
+        for (int y = 0; y < Height; y++)
+        for (int x = 0; x + 1 < Width; x++)
+        {
+            double change = Math.Abs(split[y * Width + x + 1] - split[y * Width + x]);
+            if ((x + 1) % KeyAndFill.TileSize == 0)
+            {
+                acrossEdges += change;
+                edgePairs++;
+            }
+            else
+            {
+                inside += change;
+                insidePairs++;
+            }
+        }
+
+        (inside / insidePairs).Should().BeGreaterThan(0, "the bulbs' light changes across the square");
+        (acrossEdges / edgePairs)
+            .Should()
+            .BeLessThan(1.25 * inside / insidePairs, "the light changes across a tile edge as it does inside a tile");
+    }
+}
