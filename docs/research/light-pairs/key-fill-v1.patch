new file mode 100644
index 000000000..ef7f17a7b
--- /dev/null
+++ b/src/Tertius.Rendering/LightPairSetting.cs
@@ -0,0 +1,84 @@
+namespace Tertius.Rendering;
+
+/// <summary>
+/// The direct pass shades every pair of a pixel and a light in full: the light's shadow lookup and its response, at the
+/// pixel (ARCHITECTURE.md, "The shaders").
+/// </summary>
+public readonly record struct EveryLightPair;
+
+/// <summary>
+/// The direct pass shades in full only the key lights of each pixel, and takes every other light from the fill
+/// (docs/plans/light-pairs.md, "Key and fill"). The key lights of a screen corner are the at most
+/// <paramref name="KeyLights"/> lights that show the most light there before their shadows. A corner is a point of a grid
+/// of <see cref="TileSize"/> render pixels. Each light has a key share at each corner (<see cref="KeyShare"/>), and a
+/// pixel takes each light's key share from the four corners around it. The fill of a corner is the diffuse light of every
+/// light's other share with its shadow, and a pixel takes it from the same four corners. So the diffuse light of every
+/// light stays, and a light's shine and the sharp edge of its shadow stay by its key share.
+/// </summary>
+/// <param name="KeyLights">The most key lights of a corner, from 1 to <see cref="MaxKeyLights"/>.</param>
+public readonly record struct KeyAndFill(int KeyLights)
+{
+    /// <summary>The most key lights of a corner: the keys that one texel of the corners' key image holds.</summary>
+    public const int MaxKeyLights = 4;
+
+    /// <summary>The side of a screen tile, in render pixels: the distance between two corners. TileSize in key_fill.glsl.</summary>
+    public const int TileSize = 8;
+
+    /// <summary>The most lights of a tile's list: the key lights of its four corners.</summary>
+    public const int TileEntries = 4 * MaxKeyLights;
+
+    /// <summary>
+    /// The key share of a light of <paramref name="importance"/> at a corner whose threshold is
+    /// <paramref name="threshold"/>: 0 at the threshold or below, 1 at twice the threshold or above, and even in between.
+    /// The importance of a light is the radiance that it shows at the corner before its shadow, and the threshold is the
+    /// importance of the light that follows the key lights in the order of importance, or 0 without such a light. The share
+    /// is continuous in every light's importance, so no light switches between key and fill at once, and it stays the same
+    /// when every importance takes one factor, such as the exposure's. keyShare in key_fill.glsl is the copy.
+    /// </summary>
+    public static double KeyShare(double importance, double threshold)
+    {
+        if (importance <= 0)
+            return 0;
+        return threshold <= 0 ? 1 : Math.Clamp(importance / threshold - 1, 0, 1);
+    }
+
+    /// <summary>
+    /// The threshold of a corner whose lights have <paramref name="importances"/>: the importance of the light that
+    /// follows the <see cref="KeyLights"/> most important ones, or 0 without one.
+    /// </summary>
+    public double Threshold(ReadOnlySpan<double> importances)
+    {
+        if (importances.Length <= KeyLights)
+            return 0;
+        double[] sorted = importances.ToArray();
+        Array.Sort(sorted);
+        return Math.Max(sorted[^(KeyLights + 1)], 0);
+    }
+}
+
+/// <summary>
+/// Which pairs of a pixel and a light the direct pass shades in full: <see cref="EveryLightPair"/> or
+/// <see cref="KeyAndFill"/>. The default value is EveryLightPair. It is a generated union (see
+/// <see cref="GeneratedUnionAttribute"/>).
+/// </summary>
+[GeneratedUnion(typeof(EveryLightPair), typeof(KeyAndFill), ZeroCase = typeof(EveryLightPair))]
+public readonly partial struct LightPairSetting
+{
+    /// <summary>Why the renderer cannot use the setting, or null when it can.</summary>
