From 3dded7d2362604806ce4d202776a884a91e46ebf Mon Sep 17 00:00:00 2001
From: Alexis Purslane <alexispurslane@pm.me>
Date: Fri, 27 Nov 2026 10:42:24 -0500
Subject: [PATCH] Prototype a 2 m outer light-grid level (#21)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- Keep the 0.25 m and 0.5 m levels and widen the coarsest level to 2 m
  cells, so the outer cube spans 32 m per side.
- Generalize the surface restriction to a parent that spans 2 or 4
  children per axis, and scale each face sum by 1/ratio².
- Evidence only: this branch is not for merge.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../Passes/LightVolumePass.cs                 |  7 +++++--
 .../Shaders/volume_restrict.comp              | 19 +++++++++++--------
 2 files changed, 16 insertions(+), 10 deletions(-)

diff --git a/src/Tertius.Rendering/Passes/LightVolumePass.cs b/src/Tertius.Rendering/Passes/LightVolumePass.cs
index ad2888795..568acc0e3 100644
--- a/src/Tertius.Rendering/Passes/LightVolumePass.cs
+++ b/src/Tertius.Rendering/Passes/LightVolumePass.cs
@@ -8,6 +8,8 @@ internal sealed unsafe class LightVolumePass : RenderPass
 {
     private const int Side = 16;
     private const int Levels = 3;
+    // Prototype (issue #21): the cell width of each level, finest first. A parent spans 2 or 4 children per axis.
+    private static ReadOnlySpan<float> Widths => [0.25f, 0.5f, 2f];
     private const int Cells = Side * Side * Side;
     private const int Directions = 32;
     private const int Tiles = Cells / 64;
@@ -101,7 +103,8 @@ internal sealed unsafe class LightVolumePass : RenderPass
 
     // A grid center lies at most half a cell from the camera along any axis.
     public static bool Intersects(Vector3 center, float radius) =>
-        MathF.Max(MathF.Abs(center.X), MathF.Max(MathF.Abs(center.Y), MathF.Abs(center.Z))) <= 8.5f + radius;
+        MathF.Max(MathF.Abs(center.X), MathF.Max(MathF.Abs(center.Y), MathF.Abs(center.Z)))
+        <= (Side + 1) * 0.5f * Widths[Levels - 1] + radius;
 
     public override void Record(FrameContext context)
     {
@@ -109,7 +112,7 @@ internal sealed unsafe class LightVolumePass : RenderPass
         Double3 anchor = ShadowCascades.Anchor(context.Snapshot.OriginInFrame, context.Scene.Camera.Offset);
         for (int level = 0; level < Levels; level++)
         {
-            float width = 0.25f * (1 << level);
+            float width = Widths[level];
             float Origin(double x) => (float)Math.IEEERemainder(x, width) - Side / 2 * width;
             grids[level] = new(x: Origin(anchor.X), y: Origin(anchor.Y), z: Origin(anchor.Z), w: width);
         }
diff --git a/src/Tertius.Rendering/Shaders/volume_restrict.comp b/src/Tertius.Rendering/Shaders/volume_restrict.comp
index d3effe9a2..013be1407 100644
--- a/src/Tertius.Rendering/Shaders/volume_restrict.comp
+++ b/src/Tertius.Rendering/Shaders/volume_restrict.comp
@@ -15,14 +15,16 @@ void main()
     int cell = int(gl_GlobalInvocationID.x);
     int side = int(gl_WorkGroupID.y);
     vec4 parent = volume.grids[level], child = volume.grids[level - 1];
-    ivec3 first = 2 * coordinates(cell) + ivec3(round((parent.xyz - child.xyz) / child.w));
-    if (any(lessThan(first, ivec3(-1))) || any(greaterThanEqual(first, ivec3(GridSide))))
+    // Prototype (issue #21): a parent cell spans `ratio` child cells per axis, 2 or 4.
+    int ratio = int(round(parent.w / child.w));
+    ivec3 first = ratio * coordinates(cell) + ivec3(round((parent.xyz - child.xyz) / child.w));
+    if (any(lessThan(first, ivec3(1 - ratio))) || any(greaterThanEqual(first, ivec3(GridSide))))
         return;
     vec4 areaNormal = vec4(0);
     vec3 color = vec3(0), emission = vec3(0);
-    for (int i = 0; i < 8; ++i)
+    for (int i = 0; i < ratio * ratio * ratio; ++i)
     {
-        ivec3 c = first + ivec3(i & 1, (i >> 1) & 1, i >> 2);
+        ivec3 c = first + ivec3(i % ratio, (i / ratio) % ratio, i / (ratio * ratio));
         if (!withinGrid(c))
             continue;
         SurfaceBucket sampleBucket = volume.surfaces[((level - 1) * Cells + cellIndex(c)) * 6 + side];
@@ -30,9 +32,10 @@ void main()
         color += vec3(sampleBucket.color.rgb);
         emission += vec3(sampleBucket.emission.rgb);
     }
-    // One parent face covers four child faces. Preserve shell geometry already in this cell.
+    // One parent face covers ratio² child faces. Preserve shell geometry already in this cell.
     int target = (level * Cells + cell) * 6 + side;
-    volume.surfaces[target].areaNormal += ivec4(round(areaNormal * 0.25));
-    volume.surfaces[target].color.rgb += uvec3(round(color * 0.25));
-    volume.surfaces[target].emission.rgb += uvec3(round(emission * 0.25));
+    float faceShare = 1.0 / float(ratio * ratio);
+    volume.surfaces[target].areaNormal += ivec4(round(areaNormal * faceShare));
+    volume.surfaces[target].color.rgb += uvec3(round(color * faceShare));
+    volume.surfaces[target].emission.rgb += uvec3(round(emission * faceShare));
 }
-- 
