     return outgoingOf(volume.field[fieldIndex(level, direction, cellIndex(level, q))]);
 }
 
+vec4 upwindOutgoing(int level, ivec3 q, int direction)
+{
+    if (!withinGrid(level, q))
+        return parentOutgoing(q, level, direction);
+    return outgoingOf(volume.field[fieldIndex(level, direction, cellIndex(level, q))]);
+}
+// PROBE: the sweep's taps that cross the face of the receiving axis, with the sweep's weights renormalized.
+vec4 incidentAcrossFace(int level, int local, int direction, int receivingAxis)
+{
+    ivec3 step = directionStep(direction);
+    ivec3 magnitude = abs(step);
+    int axis = magnitude.x >= max(magnitude.y, magnitude.z) ? 0 : magnitude.y >= magnitude.z ? 1 : 2;
+    int u = (axis + 1) % 3, v = (axis + 2) % 3;
+    vec2 shift = vec2(magnitude[u], magnitude[v]) / float(magnitude[axis]);
+    ivec3 c = coordinates(level, local);
+    vec4 sum = vec4(0);
+    float total = 0;
+    for (int i = 0; i < 4; ++i)
+    {
+        ivec2 corner = ivec2(i % 2, i / 2);
+        vec2 weights = mix(1.0 - shift, shift, vec2(corner));
+        ivec3 q = c;
+        q[axis] -= sign(step[axis]);
+        q[u] -= corner.x * sign(step[u]);
+        q[v] -= corner.y * sign(step[v]);
+        if (q[receivingAxis] == c[receivingAxis])
+            continue;
+        sum += weights.x * weights.y * upwindOutgoing(level, q, direction);
+        total += weights.x * weights.y;
+    }
+    return sum / total;
+}
+
