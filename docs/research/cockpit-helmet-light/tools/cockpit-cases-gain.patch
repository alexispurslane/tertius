# Diagnostic tool code (#20): the local changes of the ramp checkout for the corrected-gain cockpit cases, on #42
# commit 9e4e9d8de. It holds tools/diagnostics.patch plus the research switches NOSE_GLOW and CEILING_GLOW (0 = the
# two ceiling glow0 patches send no glow). Never committed to the engine.
diff --git a/src/Tertius.Assets/GlbReader.cs b/src/Tertius.Assets/GlbReader.cs
index 0a97f530e..b2fc0c4a0 100644
--- a/src/Tertius.Assets/GlbReader.cs
+++ b/src/Tertius.Assets/GlbReader.cs
@@ -434,6 +434,17 @@ internal static class GlbReader
                 throw new GlbException($"image {index} does not decode: {ex.Message}");
             }
 
+            if (System.Environment.GetEnvironmentVariable("TERTIUS_DEBUG_RECOLOR_BYTES") == bytes.Length.ToString(System.Globalization.CultureInfo.InvariantCulture))
+            {
+                string mode = System.Environment.GetEnvironmentVariable("TERTIUS_DEBUG_RECOLOR_MODE") ?? "blue";
+                for (int i = 0; i + 3 < result.Data.Length; i += 4)
+                {
+                    byte r = result.Data[i], g = result.Data[i + 1], b = result.Data[i + 2];
+                    if (mode == "black") { result.Data[i] = 0; result.Data[i + 1] = 0; result.Data[i + 2] = 0; }
+                    else if (mode == "gray") { byte y = (byte)((r * 54 + g * 183 + b * 19) >> 8); result.Data[i] = y; result.Data[i + 1] = y; result.Data[i + 2] = y; }
+                    else { result.Data[i] = b; result.Data[i + 2] = r; }
+                }
+            }
             return new(Width: result.Width, Height: result.Height, Rgba: result.Data, Srgb: srgb);
         }
 
