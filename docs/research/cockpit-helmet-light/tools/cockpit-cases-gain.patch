diff --git a/src/Tertius.Rendering/Shaders/volume.glsl b/src/Tertius.Rendering/Shaders/volume.glsl
index 97cb53f75..ac567049e 100644
--- a/src/Tertius.Rendering/Shaders/volume.glsl
+++ b/src/Tertius.Rendering/Shaders/volume.glsl
@@ -139,6 +139,15 @@ int volumeVisibleLamps = 0;
 #ifndef COLOR_GAIN
 #define COLOR_GAIN 1.0
 #endif
+// Research switches (#20, never committed): NOSE_GLOW 0 = the scene as it is, 1 = the shuttle art's nose lamps send
+// no glow, 2 = they send glow from their front side only. CEILING_GLOW 0 = the two glow0 patches near the cockpit
+// ceiling send no glow, 1 = as they are.
+#ifndef NOSE_GLOW
+#define NOSE_GLOW 0
+#endif
+#ifndef CEILING_GLOW
+#define CEILING_GLOW 1
+#endif
 // Variants 2 and 3 store small products, such as area x 0.02 x reflectance, in the integer color words. One fragment
 // adds up to about 256 area units, so 64 steps per unit keep about 200 steps for one fragment of 0.65 gray paint at
 // the neutral share.
diff --git a/src/Tertius.Rendering/Shaders/volume_surface.frag b/src/Tertius.Rendering/Shaders/volume_surface.frag
index 694bc6c7f..cdc5f6729 100644
--- a/src/Tertius.Rendering/Shaders/volume_surface.frag
+++ b/src/Tertius.Rendering/Shaders/volume_surface.frag
@@ -52,6 +52,29 @@ void main()
     vec3 diffuse = clamp(base.rgb * (1.0 - metal), 0.0, 1.0);
     vec4 reflectance = capturedReflectance(diffuse);
     vec3 glow = capturedEmission(min(glowSent(m.emissive, draw.words.z), vec3(32256)));
+#if NOSE_GLOW != 0 || CEILING_GLOW == 0
+    float e = max(m.emissive.r, max(m.emissive.g, m.emissive.b));
+#endif
+#if NOSE_GLOW != 0
+    // The nose lamps: ahead of and below the camera, with emission above 4 (glow0 4.45, glow1 11.28, glow2 17.8,
+    // glow3 51.65). n is the drawn triangle's outward normal, and a double-sided patch draws both sides.
+    if (world.z < -4.0 && world.y < -1.5 && e > 4.0)
+    {
+#if NOSE_GLOW == 1
+        glow = vec3(0);
+#else
+        // The art's own facing: glow3 faces forward (-z), glow1 faces down, glow0 and glow2 face up.
+        bool front = e > 40.0 ? n.z < 0.0 : (abs(e - 11.28) < 1.0 ? n.y < 0.0 : n.y > 0.0);
+        if (!front)
+            glow = vec3(0);
+#endif
+    }
+#endif
+#if CEILING_GLOW == 0
+    // The two glow0 patches near the cockpit ceiling, above the camera (#48 puts false light from them on the panel).
+    if (world.y > 0.3 && e > 4.0)
+        glow = vec3(0);
+#endif
     float area = length(crossArea) / (g.w * g.w) * 4096.0;
 #if VOLUME_COUNTERS
     atomicAdd(volume.surfaces[0].source.w, 1u);
