@@ -49,6 +49,22 @@ void main()
     vec3 diffuse = clamp(base.rgb * (1.0 - metal), 0.0, 1.0);
     vec4 reflectance = capturedReflectance(diffuse);
     vec3 glow = capturedEmission(min(glowSent(m.emissive, draw.words.z), vec3(32256)));
+#if NOSE_GLOW != 0
+    // The nose lamps: ahead of and below the camera, with emission above 4 (glow0 4.45, glow1 11.28, glow2 17.8,
+    // glow3 51.65). n is the drawn triangle's outward normal, and a double-sided patch draws both sides.
+    float e = max(m.emissive.r, max(m.emissive.g, m.emissive.b));
+    if (world.z < -4.0 && world.y < -1.5 && e > 4.0)
+    {
+#if NOSE_GLOW == 1
+        glow = vec3(0);
+#else
+        // The art's own facing: glow3 faces forward (-z), glow1 faces down, glow0 and glow2 face up.
+        bool front = e > 40.0 ? n.z < 0.0 : (abs(e - 11.28) < 1.0 ? n.y < 0.0 : n.y > 0.0);
+        if (!front)
+            glow = vec3(0);
+#endif
+    }
+#endif
     float area = length(crossArea) / (g.w * g.w) * 4096.0;
