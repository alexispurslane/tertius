+        /// <summary>
+        /// The history lengths of part 0 in the draw that takes the test's answer of a step of the whole view whose drift is
+        /// <paramref name="statistic"/> standard deviations.
+        /// </summary>
+        private static float[] LengthsAfterAStepOf(float statistic)
+        {
+            (VulkanRenderer renderer, SamplePass sample, RenderSnapshot scene) = Accumulating(
+                parameters: WithoutAntiLag
+            );
+            try
+            {
+                SwingThenStep(
+                    renderer: renderer,
+                    sample: sample,
+                    scene: scene,
+                    stepAt: _ => StepOfStatistic(statistic)
+                );
+                return LengthsOf(renderer, sample);
+            }
+            finally
+            {
+                Gpu.DisposeAndAssertClean(renderer);
+            }
+        }
+
+        [Fact]
+        public void ADriftJustAboveTheBarLeavesTheRegionsHistoriesLong()
+        {
+            // The stills' case: a drift of 3.3 standard deviations, just past the bar of 3, is the size that noise and a
+            // slow settle give a frozen scene. Its excess over the bar is a tenth of the bar, so the lag that a history of
+            // about 25 draws keeps stays within the noise (https://github.com/alexispurslane/tertius/wiki/bounce-light-confidence, section 8.7).
+            LengthsAfterAStepOf(statistic: 3.3f)
+                .Should()
+                .OnlyContain(length => length > 3 * FullRateFrames, "the cap of a drift just above the bar is long");
+        }
+
+        [Fact]
+        public void ADriftFarAboveTheBarCutsTheRegionsHistoriesToFullRateFrames()
+        {
+            // The switch's case: a drift of 6 standard deviations asks for a history shorter than FullRateFrames, the
+            // floor that keeps the block's shared ray.
+            LengthsAfterAStepOf(statistic: 6f)
+                .Should()
+                .OnlyContain(length => length == FullRateFrames, "the cap of a large drift is the floor");
+        }
+
+        [Fact]
+        public void AGreaterExcessOverTheBarGivesTheRegionsHistoriesAShorterCap()
+        {
+            // Between the stills and the switch: 3.6 standard deviations give a cap of about 16 draws, 4 give about 11.
+            float[] smaller = LengthsAfterAStepOf(statistic: 3.6f);
+            float[] greater = LengthsAfterAStepOf(statistic: 4f);
+
+            greater.Should().OnlyContain(length => length > FullRateFrames, "a drift of 4 stays above the floor");
+            greater.Max().Should().BeLessThan(smaller.Min(), "a greater excess over the bar gives a shorter cap");
+        }
+
+        [Fact]
+        public void AnAnchorsRingHoldsTheCutOfItsRegionsDrift()
+        {
+            // The ring's b holds the answer as a cut, 1 over the cap: ((√2 u) / (W s1))^(2/3), where s1 is the older
+            // window's spread and u the drift's excess over the bar, 3 s1 sqrt(2 / W). The test computes it from the
+            // ring's own lights, so it holds for the light that the taps gave, whatever the exposure's scale.
+            (VulkanRenderer renderer, SamplePass sample, RenderSnapshot scene) = Accumulating(
+                parameters: WithoutAntiLag
+            );
+            try
+            {
+                SwingThenStep(
+                    renderer: renderer,
+                    sample: sample,
+                    scene: scene,
+                    stepAt: _ => StepOfStatistic(4f),
+                    last: FullStepDraw
+                );
+
+                // Anchor 0's texel is the first of each layer, and the layer of a draw is its index modulo 36.
+                double LightOf(int draw) =>
+                    renderer.ReadImageLayer(sample.Signal.RegionRing(0)!, draw % TemporalSignal.RegionRingDraws)[0];
+                double[] older = [.. Enumerable.Range(FullStepDraw - TwoWindows + 1, Window).Select(LightOf)];
+                double[] newer = [.. Enumerable.Range(FullStepDraw - Window + 1, Window).Select(LightOf)];
+                double drift = newer.Average() - older.Average();
+                double spread = Math.Sqrt(older.Sum(x => (x - older.Average()) * (x - older.Average())) / (Window - 1));
+                double excess = Math.Abs(drift) - 3 * spread * Math.Sqrt(2.0 / Window);
+                double cut = Math.Pow(Math.Sqrt(2) * excess / (Window * spread), 2.0 / 3);
+                float[] ring = renderer.ReadImageLayer(
+                    sample.Signal.RegionRing(0)!,
+                    FullStepDraw % TemporalSignal.RegionRingDraws
+                );
+
+                cut.Should().BeInRange(1.0 / 32, 1.0 / FullRateFrames, "the step's cap lies between the floor and 32");
+                ring[2].Should().BeApproximately((float)cut, 1e-3f * (float)cut, "the ring holds the formula's cut");
+            }
+            finally
+            {
+                Gpu.DisposeAndAssertClean(renderer);
+            }
+        }
+
+        [Fact]
+        public void ABlockInTheRegionsOfTwoAnchorsTakesTheShorterOfTheirCaps()
+        {
+            // Block 12 lies in the regions of anchors 8 and 16. The light of the blocks 0 to 7 steps far above anchor 8's
+            // bar: they are 8 of its region's 17 columns. The light of the blocks 17 to 23 steps 3.6 standard deviations
+            // above anchor 16's: they are 7 of its 16 columns. Block 20 lies only in anchor 16's region.
+            (VulkanRenderer renderer, SamplePass sample, RenderSnapshot scene) = Accumulating(
+                parameters: WithoutAntiLag,
+                wall: (new(0, 0, -20), new(400, 40, 1)),
+                width: WideWidth
+            );
+            try
+            {
+                static float StepAt(int column)
+                {
+                    if (column < FallingColumns)
+                        return StepOfStatistic(8f * 17 / 8);
+                    if (column >= FirstRightFallingColumn)
+                        return StepOfStatistic(3.6f * 16 / 7);
+                    return 0;
+                }
+                SwingThenStep(renderer: renderer, sample: sample, scene: scene, stepAt: StepAt);
+                float[] lengths = WideLengthsOf(renderer, sample);
+
+                BlockColumnLengths(lengths, column: 20)
+                    .Should()
+                    .OnlyContain(
+                        length => Math.Abs(length - CapOfStatistic(3.6f)) < 0.5f,
+                        "anchor 16 alone caps block 20 at about 16 draws"
+                    );
+                BlockColumnLengths(lengths, column: 12)
+                    .Should()
+                    .OnlyContain(length => length == FullRateFrames, "anchor 8's cap is the shorter");
+            }
+            finally
+            {
+                Gpu.DisposeAndAssertClean(renderer);
+            }
+        }
+
+        [Fact]
+        public void ARegionOfExactlyEqualLightGivesNoCap()
+        {
+            // The older window's spread is exactly 0, and so is the drift: the excess over the bar is 0, so no cap, and no
+            // division by the spread gives an infinity or a NaN (the Vulkan rule of CLAUDE.md).
+            (VulkanRenderer renderer, SamplePass sample, RenderSnapshot scene) = Accumulating(
+                parameters: WithoutAntiLag
+            );
+            try
+            {
+                SwingThenStep(renderer: renderer, sample: sample, scene: scene, stepAt: _ => 0, swing: 0);
+
+                float[] ring = renderer.ReadImageLayer(
+                    sample.Signal.RegionRing(0)!,
+                    CapDraw % TemporalSignal.RegionRingDraws
+                );
+                ring[2].Should().Be(0, "a light that does not change gives no cut");
+                LengthsOf(renderer, sample).Should().OnlyContain(length => length == 32, "no cap acts");
+            }
+            finally
+            {
+                Gpu.DisposeAndAssertClean(renderer);
+            }
+        }
+
+        [Fact]
+        public void AStepInARegionOfExactlyEqualLightCutsItsHistoriesToFullRateFrames()
+        {
+            // The older window's spread is exactly 0, so any step is infinitely far above the bar.
+            (VulkanRenderer renderer, SamplePass sample, RenderSnapshot scene) = Accumulating(
+                parameters: WithoutAntiLag
+            );
+            try
+            {
+                SwingThenStep(renderer: renderer, sample: sample, scene: scene, stepAt: _ => 1f / 64, swing: 0);
+
+                LengthsOf(renderer, sample)
+                    .Should()
+                    .OnlyContain(length => length == FullRateFrames, "a step without spread takes the floor");
+            }
+            finally
+            {
+                Gpu.DisposeAndAssertClean(renderer);
+            }
+        }
