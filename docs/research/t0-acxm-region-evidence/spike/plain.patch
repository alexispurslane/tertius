diff --git a/src/Tertius.Rendering/Shaders/region_drift.comp b/src/Tertius.Rendering/Shaders/region_drift.comp
new file mode 100644
index 000000000..ed7954da1
--- /dev/null
+++ b/src/Tertius.Rendering/Shaders/region_drift.comp
@@ -0,0 +1,82 @@
+#version 460
+// The region drift pass of a signal with a light age (region_drift.glsl): one invocation per block of 8 × 8 pixels. It
+// takes the region's light of this draw from the taps that the temporal dispatch stored, writes it into the block's ring,
+// and tests the ring's newer window against its older one. The spatial dispatch reads the result
+// (docs/plans/bounce-light-confidence.md, section 8.6).
+#extension GL_GOOGLE_include_directive : require
+#include "accumulate.glsl"
+#include "region_drift.glsl"
+
+// One draw of a block's ring.
+struct RegionDraw
+{
+    float light;        // the region's light of the draw: the mean of its counted taps
+    float validDraws;   // the count of valid draws in a row up to the draw, at most RegionRingDraws, 0 if it is not valid
+};
+
+// The region's light of this draw at `block`: the mean over the counted taps of the 17 × 17 blocks around it. The draw is
+// valid where at least half of the region's taps inside the images count, so that the mean is of mostly the same surfaces
+// from draw to draw: a camera move makes every tap move, so the count restarts. `validDrawsBefore` is the count of the
+// draw before.
+RegionDraw regionDrawOf(ivec2 block, float validDrawsBefore)
+{
+    float sum = 0.0;
+    float counted = 0.0;
+    float inside = 0.0;
+    for (int y = -RegionRadiusBlocks; y <= RegionRadiusBlocks; y++)
+        for (int x = -RegionRadiusBlocks; x <= RegionRadiusBlocks; x++)
+        {
+            ivec2 tap = block + ivec2(x, y);
+            if (!tapInsideImages(tap))
+                continue;
+            vec2 light = imageLoad(blockLight, tap).rg;
+            inside += 1.0;
+            sum += light.r * light.g;
+            counted += light.g;
+        }
+    bool valid = counted > 0.0 && 2.0 * counted >= inside;
+    return RegionDraw(valid ? sum / counted : 0.0, valid ? min(validDrawsBefore + 1.0, float(RegionRingDraws)) : 0.0);
+}
+
+// Whether the region's light moved at `block`, from this draw `now` and the ring's draws before it: whether the mean of
+// the newer window (this draw and the W − 1 before it) differs from the mean of the older window (the W draws before
+// those) by more than DriftSigmas standard deviations of the older window's spread, times sqrt(2 / W), the spread of a
+// difference of two means of W draws. False until 2 W valid draws in a row exist. The older window's spread is a
+// measured quantity: a step inside the newer window does not raise it.
+bool regionLightMoved(ivec2 block, RegionDraw now)
+{
+    if (now.validDraws < float(RegionRingDraws))
+        return false;
+    float newer = now.light;
+    for (uint back = 1u; back < RegionWindowDraws; back++)
+        newer += imageLoad(regionRing, ivec3(block, int((parameters.regionSlot + RegionRingDraws - back) % RegionRingDraws))).r;
+    float older[RegionWindowDraws];
+    float olderSum = 0.0;
+    for (uint back = 0u; back < RegionWindowDraws; back++)
+    {
+        uint slot = (parameters.regionSlot + RegionWindowDraws - back) % RegionRingDraws;
+        older[back] = imageLoad(regionRing, ivec3(block, int(slot))).r;
+        olderSum += older[back];
+    }
+    float window = float(RegionWindowDraws);
+    float olderMean = olderSum / window;
+    float squares = 0.0;
+    for (uint back = 0u; back < RegionWindowDraws; back++)
+        squares += (older[back] - olderMean) * (older[back] - olderMean);
+    float olderSpread = sqrt(squares / (window - 1.0));
+    return abs(newer / window - olderMean) > DriftSigmas * olderSpread * sqrt(2.0 / window);
+}
+
+void main()
+{
+    ivec2 block = ivec2(gl_GlobalInvocationID.xy);
+    if (!insideImages(8 * block))
+        return;
+    float before = parameters.reset != 0u
+        ? 0.0
+        : imageLoad(regionRing, ivec3(block, int((parameters.regionSlot + RegionRingDraws - 1u) % RegionRingDraws))).g;
+    RegionDraw now = regionDrawOf(block, before);
+    bool moved = regionLightMoved(block, now);
+    imageStore(regionRing, ivec3(block, int(parameters.regionSlot)), vec4(now.light, now.validDraws, 0.0, 0.0));
+    imageStore(regionEvidence, block, uvec4(moved ? 1u : 0u));
+}
