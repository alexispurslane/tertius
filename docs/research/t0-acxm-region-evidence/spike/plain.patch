+++ b/src/Tertius.Rendering/Shaders/region_drift.glsl
@@ -0,0 +1,55 @@
+// The region's drift (docs/plans/bounce-light-confidence.md, section 8.6; ticket t0-acxm): the second source of a block's
+// light evidence. The temporal dispatch stores one tap per block of 8 × 8 pixels, the region drift pass keeps each block's
+// ring of its region's light and tests whether that light moved, and the spatial dispatch reads the test. The three images
+// are a signal's with a light age (TemporalSignal), at block resolution. Needs accumulate.glsl.
+#ifndef TERTIUS_REGION_DRIFT_GLSL
+#define TERTIUS_REGION_DRIFT_GLSL
+
+// The draws of each of the test's two windows, W: the jitter's 18 phases under FSR at the render scale 1.5, so that a
+// cycle of the jitter cancels in each window.
+const uint RegionWindowDraws = 18u;
+
+// The draws that a block's ring keeps: the newer and the older window.
+const uint RegionRingDraws = 2u * RegionWindowDraws;
+
+// The region of a block: the blocks up to this far in x and in y, 17 × 17 blocks.
+const int RegionRadiusBlocks = 8;
+
+// The tolerance of the test, in standard deviations of the older window's spread of the region's light.
+const float DriftSigmas = 3.0;
+
+// The pixel of a block whose sample is the block's tap, in the block's own pixels.
+const ivec2 RegionTapPixel = ivec2(4);
+
+// Each block's tap of this draw (TemporalSignal.BlockLightFormat): r the luminance of the tap pixel's sample over the
+// draw's exposure scale, g 1 where the tap counts, else 0. A tap counts where its pixel shows a surface that does not move
+// on screen, and holds a finite sample.
+layout(set = 3, binding = 13, rg32f) uniform image2D blockLight;
+
+// Each block's ring (TemporalSignal.RegionRingFormat): layer k holds the draw whose regionSlot is k, r the region's light
+// of that draw, g the count of valid draws in a row up to it, at most RegionRingDraws, 0 for a draw that is not valid.
+layout(set = 3, binding = 14, rg32f) uniform image2DArray regionRing;
+
+// Each block's region evidence of this draw (TemporalSignal.RegionEvidenceFormat): 1 where its region's light moved, else
+// 0. The region drift pass writes it, and the spatial dispatch reads it.
+layout(set = 3, binding = 15, r32ui) uniform uimage2D regionEvidence;
+
+// The block of a pixel.
+ivec2 blockOf(ivec2 pixel)
+{
+    return pixel / 8;
+}
+
+// Whether a pixel is its block's tap.
+bool isRegionTap(ivec2 pixel)
+{
+    return all(equal(pixel & 7, RegionTapPixel));
+}
+
+// Whether the tap of `block` lies inside the images.
+bool tapInsideImages(ivec2 block)
+{
+    return insideImages(8 * block + RegionTapPixel);
+}
