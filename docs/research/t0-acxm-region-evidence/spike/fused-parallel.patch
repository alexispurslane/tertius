index 000000000..fb7212975
--- /dev/null
+++ b/src/Tertius.Rendering/Shaders/region_drift.glsl
@@ -0,0 +1,200 @@
+// The region's drift (docs/plans/bounce-light-confidence.md, section 8.6; ticket t0-acxm): the second source of a block's
+// light evidence. The temporal dispatch stores one tap per block of 8 × 8 pixels. The spatial dispatch, whose workgroup is
+// one block, sums its region's taps, keeps the block's ring of its region's light and tests whether that light moved
+// (regionLightMoved). The ring's layout and the test live only here: the spatial dispatch takes the answer. The two
+// images are a signal's with a light age (TemporalSignal), at block resolution. Needs accumulate.glsl.
+#ifndef TERTIUS_REGION_DRIFT_GLSL
+#define TERTIUS_REGION_DRIFT_GLSL
+
+// The draws of each of the test's two windows, W: the jitter's 18 phases under FSR at the render scale 1.5, so that a
+// cycle of the jitter cancels in each window.
+const uint RegionWindowDraws = 18u;
+
+// The draws that a block's ring keeps: the newer and the older window.
+const uint RegionRingDraws = 2u * RegionWindowDraws;
+
+// The region of a block: the blocks up to this far in x and in y, 17 × 17 blocks.
+const int RegionRadiusBlocks = 8;
+
+// The side of a region, in blocks.
+const int RegionSide = 2 * RegionRadiusBlocks + 1;
+
+// The tolerance of the test, in standard deviations of the older window's spread of the region's light.
+const float DriftSigmas = 3.0;
+
+// The pixel of a block whose sample is the block's tap, in the block's own pixels.
+const ivec2 RegionTapPixel = ivec2(4);
+
+// Each block's tap of this draw (TemporalSignal.BlockLightFormat): r the luminance of the tap pixel's sample over the
+// draw's exposure scale, g 1 where the tap counts, else 0. A tap counts where its pixel shows a surface that does not move
+// on screen, and holds a finite sample.
+layout(set = 3, binding = 13, rg32f) uniform image2D blockLight;
+
+// Each block's ring (TemporalSignal.RegionRingFormat): layer k holds the draw whose regionSlot is k, r the region's light
+// of that draw, g the count of valid draws in a row up to it, at most RegionRingDraws, 0 for a draw that is not valid.
+// Only the workgroup of the block reads and writes it.
+layout(set = 3, binding = 14, rg32f) uniform image2DArray regionRing;
+
+// The block of a pixel.
+ivec2 blockOf(ivec2 pixel)
+{
+    return pixel / 8;
+}
+
+// Whether a pixel is its block's tap.
+bool isRegionTap(ivec2 pixel)
+{
+    return all(equal(pixel & 7, RegionTapPixel));
+}
+
+// Whether the tap of `block` lies inside the images.
+bool tapInsideImages(ivec2 block)
+{
+    return insideImages(8 * block + RegionTapPixel);
+}
+
+#ifdef TERTIUS_REGION_DRIFT_TEST
+// One draw of a block's ring.
+struct RegionDraw
+{
+    float light;        // the region's light of the draw: the mean of its counted taps
+    float validDraws;   // the count of valid draws in a row up to the draw, at most RegionRingDraws, 0 if it is not valid
+};
+
+// The invocations that add a part of the sums in the second step of regionLightMoved, and the slots of the first step
+// that each adds.
+const uint RegionAdders = 8u;
+const uint RegionSlotsPerAdder = 64u / RegionAdders;
+
+// The ring's draws that one invocation adds in the second step: 3 of the older window's 18, or of the newer window's 17
+// draws before this one.
+const uint RegionDrawsPerAdder = 3u;
+const uint RegionWindowAdders = RegionWindowDraws / RegionDrawsPerAdder;
+
+// Each invocation's share of the region's sums in the first step: x the counted light, y the counted taps, z the taps
+// inside the images.
+shared vec3 regionShares[64];
+
+// The block's ring, layer by layer, as the draw before left it.
+shared vec2 regionRingBefore[RegionRingDraws];
+
+// The second step's parts: the region's sums, [0, RegionAdders), then the older window's sum and sum of squares of its
+// draws less its first draw, then the newer window's sum of its draws before this one, RegionWindowAdders of each.
+shared vec3 regionParts[RegionAdders];
+shared vec2 regionOlderParts[RegionWindowAdders];
+shared float regionNewerParts[RegionWindowAdders];
+
+// Whether the block's region light moved in this draw, which invocation 0 decides.
+shared bool regionMoved;
+
+// The region's light of this draw from its `sums`: the mean of its counted taps. The draw is valid where at least half of
+// the region's taps inside the images count, so that the mean is of mostly the same surfaces from draw to draw: a camera
+// move makes every tap move, so the count restarts. `validDrawsBefore` is the count of the draw before.
+RegionDraw regionDrawOf(vec3 sums, float validDrawsBefore)
+{
+    bool valid = sums.y > 0.0 && 2.0 * sums.y >= sums.z;
+    return RegionDraw(valid ? sums.x / sums.y : 0.0, valid ? min(validDrawsBefore + 1.0, float(RegionRingDraws)) : 0.0);
+}
+
+// The ring's light of the draw `back` draws before this one, 1 to RegionRingDraws − 1.
+float regionLightBefore(uint back)
+{
+    return regionRingBefore[(parameters.regionSlot + RegionRingDraws - back) % RegionRingDraws].r;
+}
+
+// The older window's first draw, which its sums subtract from each of its draws, so that the spread keeps its precision
+// when it is small beside the light.
+float regionOlderFirst()
+{
+    return regionLightBefore(RegionRingDraws - 1u);
+}
+
+// Whether the region's light moved, from this draw `now` and the second step's parts: whether the mean of the newer window
+// (this draw and the W − 1 before it) differs from the mean of the older window (the W draws before those) by more than
+// DriftSigmas standard deviations of the older window's spread, times sqrt(2 / W), the spread of a difference of two
+// means of W draws. False until 2 W valid draws in a row exist. The older window's spread is a measured quantity: a step
+// inside the newer window does not raise it.
+bool regionTestOf(RegionDraw now)
+{
+    if (now.validDraws < float(RegionRingDraws))
+        return false;
+    float newer = now.light;
+    vec2 older = vec2(0.0);
+    for (uint part = 0u; part < RegionWindowAdders; part++)
+    {
+        newer += regionNewerParts[part];
+        older += regionOlderParts[part];
+    }
+    float window = float(RegionWindowDraws);
+    float olderMean = regionOlderFirst() + older.x / window;
+    float olderSpread = sqrt(max(older.y - older.x * older.x / window, 0.0) / (window - 1.0));
+    return abs(newer / window - olderMean) > DriftSigmas * olderSpread * sqrt(2.0 / window);
+}
+
+// Whether the region light of the workgroup's block moved in this draw. It also writes this draw into the block's ring.
+// Every invocation of the workgroup calls it from main before any branch, so its three barriers run in uniform control
+// flow. The sums run in three steps, each in a fixed order: each invocation sums its own taps of the 17 × 17 into its own
+// slot, 8 invocations each add 8 slots and 12 invocations each add 3 of the ring's draws, and invocation 0 adds those
+// parts. So one machine gives the same bits in every run.
+bool regionLightMoved()
+{
+    ivec2 block = ivec2(gl_WorkGroupID.xy);
+    uint index = gl_LocalInvocationIndex;
+    vec3 share = vec3(0.0);
+    for (uint tap = index; tap < uint(RegionSide * RegionSide); tap += 64u)
+    {
+        ivec2 other = block + ivec2(int(tap) % RegionSide, int(tap) / RegionSide) - RegionRadiusBlocks;
+        if (!tapInsideImages(other))
+            continue;
+        vec2 light = imageLoad(blockLight, other).rg;
+        share += vec3(light.r * light.g, light.g, 1.0);
+    }
+    regionShares[index] = share;
+    if (index < RegionRingDraws)
+        regionRingBefore[index] = imageLoad(regionRing, ivec3(block, int(index))).rg;
+    barrier();
+    if (index < RegionAdders)
+    {
+        vec3 part = vec3(0.0);
+        for (uint slot = index * RegionSlotsPerAdder; slot < (index + 1u) * RegionSlotsPerAdder; slot++)
+            part += regionShares[slot];
+        regionParts[index] = part;
+    }
+    else if (index < RegionAdders + RegionWindowAdders)
+    {
+        // Backs RegionWindowDraws to RegionRingDraws − 1: the older window.
+        uint first = RegionWindowDraws + (index - RegionAdders) * RegionDrawsPerAdder;
+        vec2 part = vec2(0.0);
+        for (uint back = first; back < first + RegionDrawsPerAdder; back++)
+        {
+            float apart = regionLightBefore(back) - regionOlderFirst();
+            part += vec2(apart, apart * apart);
+        }
+        regionOlderParts[index - RegionAdders] = part;
+    }
+    else if (index < RegionAdders + 2u * RegionWindowAdders)
+    {
+        // Backs 1 to RegionWindowDraws − 1: the newer window before this draw.
+        uint first = 1u + (index - RegionAdders - RegionWindowAdders) * RegionDrawsPerAdder;
+        float part = 0.0;
+        for (uint back = first; back < min(first + RegionDrawsPerAdder, RegionWindowDraws); back++)
+            part += regionLightBefore(back);
+        regionNewerParts[index - RegionAdders - RegionWindowAdders] = part;
+    }
+    barrier();
+    if (index == 0u)
+    {
+        vec3 sums = vec3(0.0);
+        for (uint part = 0u; part < RegionAdders; part++)
+            sums += regionParts[part];
+        float before = parameters.reset != 0u ? 0.0 : regionRingBefore[(parameters.regionSlot + RegionRingDraws - 1u) % RegionRingDraws].g;
+        RegionDraw now = regionDrawOf(sums, before);
+        regionMoved = regionTestOf(now);
+        imageStore(regionRing, ivec3(block, int(parameters.regionSlot)), vec4(now.light, now.validDraws, 0.0, 0.0));
+    }
+    barrier();
+    return regionMoved;
+}
+#endif
+
+#endif
