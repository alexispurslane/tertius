index 000000000..b652cb23f
--- /dev/null
+++ b/src/Tertius.Rendering/Shaders/region_drift.comp
@@ -0,0 +1,110 @@
+#version 460
+// The region drift pass of a signal with a light age (region_drift.glsl): one invocation per block of 8 × 8 pixels. It
+// takes the region's light of this draw from the taps that the temporal dispatch stored, writes it into the block's ring,
+// and tests the ring's newer window against its older one. The spatial dispatch reads the result
+// (docs/plans/bounce-light-confidence.md, section 8.6).
+#extension GL_GOOGLE_include_directive : require
+#include "accumulate.glsl"
+#include "region_drift.glsl"
+
+// One draw of a block's ring.
+struct RegionDraw
+{
+    float light;        // the region's light of the draw: the mean of its counted taps
+    float validDraws;   // the count of valid draws in a row up to the draw, at most RegionRingDraws, 0 if it is not valid
+};
+
+// The side of the tile of block taps that a workgroup of 8 × 8 blocks reads: its blocks and RegionRadiusBlocks around them.
+const int TileSide = 8 + 2 * RegionRadiusBlocks;
+
+// The workgroup's tile of taps, row by row: x the light times 1 where the tap counts, y 1 where it counts, z 1 where the
+// tap lies inside the images.
+shared vec3 tile[TileSide * TileSide];
+
+// The sums of each tile row over the 17 taps around each of the workgroup's 8 columns, [row * 8 + column].
+shared vec3 rowSums[TileSide * 8];
+
+// The sums of the taps of the 17 × 17 blocks around this invocation's block: x the counted light, y the counted taps, z the taps inside
+// the images. A box sum in two steps through shared memory: the workgroup loads its tile once, sums each row over 17
+// taps, then each column over 17 row sums. Every invocation of the workgroup calls it from main before any branch, so
+// its barriers run in uniform control flow.
+vec3 regionSumsOf()
+{
+    ivec2 first = ivec2(gl_WorkGroupID.xy) * 8 - RegionRadiusBlocks;
+    for (uint index = gl_LocalInvocationIndex; index < uint(TileSide * TileSide); index += 64u)
+    {
+        ivec2 tap = first + ivec2(int(index) % TileSide, int(index) / TileSide);
+        vec2 light = tapInsideImages(tap) ? imageLoad(blockLight, tap).rg : vec2(0.0);
+        tile[index] = vec3(light.r * light.g, light.g, tapInsideImages(tap) ? 1.0 : 0.0);
+    }
+    barrier();
+    for (uint index = gl_LocalInvocationIndex; index < uint(TileSide * 8); index += 64u)
+    {
+        int row = int(index) / 8;
+        int column = int(index) % 8;
+        vec3 sum = vec3(0.0);
+        for (int x = 0; x <= 2 * RegionRadiusBlocks; x++)
+            sum += tile[row * TileSide + column + x];
+        rowSums[index] = sum;
+    }
+    barrier();
+    ivec2 local = ivec2(gl_LocalInvocationID.xy);
+    vec3 sums = vec3(0.0);
+    for (int y = 0; y <= 2 * RegionRadiusBlocks; y++)
+        sums += rowSums[(local.y + y) * 8 + local.x];
+    return sums;
+}
+
+// The region's light of this draw at `block` from its `sums` (regionSumsOf): the mean of its counted taps. The draw is
+// valid where at least half of the region's taps inside the images count, so that the mean is of mostly the same
+// surfaces from draw to draw: a camera move makes every tap move, so the count restarts. `validDrawsBefore` is the count
+// of the draw before.
+RegionDraw regionDrawOf(vec3 sums, float validDrawsBefore)
+{
+    bool valid = sums.y > 0.0 && 2.0 * sums.y >= sums.z;
+    return RegionDraw(valid ? sums.x / sums.y : 0.0, valid ? min(validDrawsBefore + 1.0, float(RegionRingDraws)) : 0.0);
+}
+
+// Whether the region's light moved at `block`, from this draw `now` and the ring's draws before it: whether the mean of
+// the newer window (this draw and the W − 1 before it) differs from the mean of the older window (the W draws before
+// those) by more than DriftSigmas standard deviations of the older window's spread, times sqrt(2 / W), the spread of a
+// difference of two means of W draws. False until 2 W valid draws in a row exist. The older window's spread is a
+// measured quantity: a step inside the newer window does not raise it.
+bool regionLightMoved(ivec2 block, RegionDraw now)
+{
+    if (now.validDraws < float(RegionRingDraws))
+        return false;
+    float newer = now.light;
+    for (uint back = 1u; back < RegionWindowDraws; back++)
+        newer += imageLoad(regionRing, ivec3(block, int((parameters.regionSlot + RegionRingDraws - back) % RegionRingDraws))).r;
+    float older[RegionWindowDraws];
+    float olderSum = 0.0;
+    for (uint back = 0u; back < RegionWindowDraws; back++)
+    {
+        uint slot = (parameters.regionSlot + RegionWindowDraws - back) % RegionRingDraws;
+        older[back] = imageLoad(regionRing, ivec3(block, int(slot))).r;
+        olderSum += older[back];
+    }
+    float window = float(RegionWindowDraws);
+    float olderMean = olderSum / window;
+    float squares = 0.0;
+    for (uint back = 0u; back < RegionWindowDraws; back++)
+        squares += (older[back] - olderMean) * (older[back] - olderMean);
+    float olderSpread = sqrt(squares / (window - 1.0));
+    return abs(newer / window - olderMean) > DriftSigmas * olderSpread * sqrt(2.0 / window);
+}
+
+void main()
+{
+    ivec2 block = ivec2(gl_GlobalInvocationID.xy);
+    vec3 sums = regionSumsOf();
+    if (!insideImages(8 * block))
+        return;
+    float before = parameters.reset != 0u
+        ? 0.0
+        : imageLoad(regionRing, ivec3(block, int((parameters.regionSlot + RegionRingDraws - 1u) % RegionRingDraws))).g;
+    RegionDraw now = regionDrawOf(sums, before);
+    bool moved = regionLightMoved(block, now);
+    imageStore(regionRing, ivec3(block, int(parameters.regionSlot)), vec4(now.light, now.validDraws, 0.0, 0.0));
+    imageStore(regionEvidence, block, uvec4(moved ? 1u : 0u));
+}
diff --git a/src/Tertius.Rendering/Shaders/region_drift.glsl b/src/Tertius.Rendering/Shaders/region_drift.glsl
new file mode 100644
index 000000000..3b6afebed
--- /dev/null
+++ b/src/Tertius.Rendering/Shaders/region_drift.glsl
@@ -0,0 +1,55 @@
+// The region's drift (docs/plans/bounce-light-confidence.md, section 8.6; ticket t0-acxm): the second source of a block's
+// light evidence. The temporal dispatch stores one tap per block of 8 × 8 pixels, the region drift pass keeps each block's
+// ring of its region's light and tests whether that light moved, and the spatial dispatch reads the test. The three images
+// are a signal's with a light age (TemporalSignal), at block resolution. Needs accumulate.glsl.
+#ifndef TERTIUS_REGION_DRIFT_GLSL
+#define TERTIUS_REGION_DRIFT_GLSL
+
+// The draws of each of the test's two windows, W: the jitter's 18 phases under FSR at the render scale 1.5, so that a
+// cycle of the jitter cancels in each window.
+const uint RegionWindowDraws = 18u;
+
+// The draws that a block's ring keeps: the newer and the older window.
+const uint RegionRingDraws = 2u * RegionWindowDraws;
+
+// The region of a block: the blocks up to this far in x and in y, 17 × 17 blocks.
+const int RegionRadiusBlocks = 8;
+
+// The tolerance of the test, in standard deviations of the older window's spread of the region's light.
+const float DriftSigmas = 3.0;
+
+// The pixel of a block whose sample is the block's tap, in the block's own pixels.
+const ivec2 RegionTapPixel = ivec2(4);
+
+// Each block's tap of this draw (TemporalSignal.BlockLightFormat): r the luminance of the tap pixel's sample over the
+// draw's exposure scale, g 1 where the tap counts, else 0. A tap counts where its pixel shows a surface that does not move
+// on screen, and holds a finite sample.
+layout(set = 3, binding = 13, rg32f) uniform image2D blockLight;
+
+// Each block's ring (TemporalSignal.RegionRingFormat): layer k holds the draw whose regionSlot is k, r the region's light
+// of that draw, g the count of valid draws in a row up to it, at most RegionRingDraws, 0 for a draw that is not valid.
+layout(set = 3, binding = 14, rg32f) uniform image2DArray regionRing;
+
+// Each block's region evidence of this draw (TemporalSignal.RegionEvidenceFormat): 1 where its region's light moved, else
+// 0. The region drift pass writes it, and the spatial dispatch reads it.
+layout(set = 3, binding = 15, r32ui) uniform uimage2D regionEvidence;
+
+// The block of a pixel.
+ivec2 blockOf(ivec2 pixel)
+{
+    return pixel / 8;
+}
+
+// Whether a pixel is its block's tap.
+bool isRegionTap(ivec2 pixel)
+{
+    return all(equal(pixel & 7, RegionTapPixel));
+}
+
+// Whether the tap of `block` lies inside the images.
+bool tapInsideImages(ivec2 block)
+{
+    return insideImages(8 * block + RegionTapPixel);
+}
+
+#endif
