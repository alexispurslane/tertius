+vec3 probeIrregularSpread(ivec2 pixel, TracingPixel center, MaterialFactors factors, vec3 source)
+{
+    if (handOverOf(center) <= 0.0 || any(lessThan(factors.specular, vec3(LeastFactor))))
+        return source;
