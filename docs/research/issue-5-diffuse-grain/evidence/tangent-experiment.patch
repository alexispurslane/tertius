+            uint choice = blueNoiseBytesOf(noiseCell, 32u + uint(index)).r;
+            if (choice < 192u)
+                moved += probeExchange(pixel, neighbor, center, factors, outgoing, 1.0 / 48.0);
+        }
+    return (outgoing + moved) / factors.specular;
+}
