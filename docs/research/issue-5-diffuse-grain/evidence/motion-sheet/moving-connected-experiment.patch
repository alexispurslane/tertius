+            public void Handle(Self self, scoped ref EventList events, scoped ref Outbox outbox)
+            {
+                if (mode.Length == 0 || self.Tick < 87580)
+                    return;
+                double s;
+                if (mode == "move")
+                {
+                    if (self.Tick < 87581)
+                        return;
+                    s = Math.Clamp((self.Tick - 87581) / 95.0, 0.0, 1.0);
