+        if (!tracedSurface(cells[i]))
+            return false;
+        TracingPixel middle = tracingPixelAt(cells[i]);
+        if (!probeCompatible(first, middle) || !probeCompatible(second, middle))
+            return false;
+    }
+    return true;
