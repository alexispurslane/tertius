+        ivec2 cell = (pixel * (steps - i) + neighbor * i + ivec2(steps / 2)) / steps;
+        if (!tracedSurface(cell))
+            return false;
+        TracingPixel middle = tracingPixelAt(cell);
+        if (!probeCompatible(first, middle) || !probeCompatible(second, middle))
+            return false;
+    }
+    return true;
