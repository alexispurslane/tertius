+    }
+
+    private static void Add(double[][] s, int at, int pixel, int kind, double x)
+    {
+        s[at][pixel] += 1;
+        s[at + 1][pixel] += x;
+        s[at + 2][pixel] += x * x;
+        s[at + 3 + 3 * kind][pixel] += x;
+        s[at + 4 + 3 * kind][pixel] += x * x;
+        s[at + 5 + 3 * kind][pixel] += 1;
+    }
