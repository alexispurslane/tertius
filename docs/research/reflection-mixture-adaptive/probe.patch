diff -ruN -x bin -x obj -x *.orig a/src/Tertius.Rendering/Scene/ProbeLampSwitch.cs b/src/Tertius.Rendering/Scene/ProbeLampSwitch.cs
--- a/src/Tertius.Rendering/Scene/ProbeLampSwitch.cs	1969-12-31 19:00:00
+++ b/src/Tertius.Rendering/Scene/ProbeLampSwitch.cs	2026-11-23 04:45:54
@@ -0,0 +1,114 @@
+using System.Collections.Concurrent;
+using System.Numerics;
+
+namespace Tertius.Rendering;
+
+/// <summary>
+/// PROBE (tools/renderer-survey, never commit to src): the survey's lamp switch. TERTIUS_PROBE_LAMP_OFF="a-b,c-d" turns
+/// the selected lamps off in the draws a &lt;= draw &lt; b, counted from 0 over every draw of the run.
+/// TERTIUS_PROBE_LAMP_SEL = all, or x:lo:hi, y:lo:hi or z:lo:hi, selects the local lights whose camera-relative position
+/// lies in that range on that axis. A lamp is the entity of a selected light. Its light shines 0 on the GPU light rows.
+/// With TERTIUS_PROBE_LAMP_GLOW=off, the default, its instances also draw with a twin of their material that has no
+/// emission, in every view, so that its panel goes dark and comes back with its light, as a game can switch a lamp.
+/// TERTIUS_PROBE_LAMP_GLOW=stays keeps the panel's glow, the switch of the survey before 2026-11-22, which no game state
+/// makes. TERTIUS_PROBE_SUN=off turns off every light whose reach is at least 10^6 m. The batcher decides the lamps once
+/// per draw (<see cref="Decide"/>), and the light rows of the same draw take them (<see cref="Darken"/>).
+/// </summary>
+internal static class ProbeLampSwitch
+{
+    private static readonly (int From, int To)[] Ranges = (Environment.GetEnvironmentVariable("TERTIUS_PROBE_LAMP_OFF") ?? "")
+        .Split(',', StringSplitOptions.RemoveEmptyEntries)
+        .Select(r => r.Split('-'))
+        .Select(r => (int.Parse(r[0]), int.Parse(r[1])))
+        .ToArray();
+
+    private static readonly string[] Selection = (Environment.GetEnvironmentVariable("TERTIUS_PROBE_LAMP_SEL") ?? "all").Split(':');
+    private static readonly bool SunOff = Environment.GetEnvironmentVariable("TERTIUS_PROBE_SUN") == "off";
+
+    private static readonly string Glow = Environment.GetEnvironmentVariable("TERTIUS_PROBE_LAMP_GLOW") switch
+    {
+        null or "" or "off" => "off",
+        "stays" => "stays",
+        var other => throw new InvalidOperationException($"TERTIUS_PROBE_LAMP_GLOW: no case {other}"),
+    };
+
+    /// <summary>Whether the switch darkens the lamps' panels: some draws turn lamps off, and their glow goes off too.</summary>
+    public static bool DarkensGlow => Ranges.Length > 0 && Glow == "off";
+
+    // The twin slot of each material slot that glows, from VulkanRenderer.CreateMaterial, which other threads call.
+    private static readonly ConcurrentDictionary<uint, uint> Twins = new();
+
+    // The lamps of the draw that Decide decided last, and that draw.
+    private static readonly HashSet<Entity> Lamps = [];
+    private static int draw = -1;
+
+    /// <summary>Records <paramref name="twin"/>, the slot of the copy of the material in <paramref name="slot"/> that has no emission.</summary>
+    public static void AddTwin(uint slot, uint twin) => Twins[slot] = twin;
+
+    /// <summary>
+    /// Counts the next draw and decides its lamps from <paramref name="scene"/>'s lights. With the glow off, it gives each
+    /// placed and visible instance of a lamp the twin of its material, when the twin is among the
+    /// <paramref name="materialCount"/> slots on the GPU. The batcher calls it once per draw, after it collects the lights
+    /// and before any view takes the placed or the visible instances.
+    /// </summary>
+    public static void Decide(PreparedScene scene, int materialCount)
+    {
+        draw++;
+        Lamps.Clear();
+        bool off = false;
+        foreach ((int from, int to) in Ranges)
+            off |= draw >= from && draw < to;
+        if (!off)
+            return;
+        foreach (ref readonly PreparedLight light in scene.LightSpan)
+        {
+            Vector3 p = light.Position;
+            bool chosen = Selection[0] switch
+            {
+                "x" => p.X >= float.Parse(Selection[1]) && p.X <= float.Parse(Selection[2]),
+                "y" => p.Y >= float.Parse(Selection[1]) && p.Y <= float.Parse(Selection[2]),
+                "z" => p.Z >= float.Parse(Selection[1]) && p.Z <= float.Parse(Selection[2]),
+                _ => true,
+            };
+            if (chosen && light.Reach > 0 && light.Reach < 1e6f)
+                Lamps.Add(light.Entity);
+        }
+
+        int lights = 0;
+        foreach (ref readonly PreparedLight light in scene.LightSpan)
+            lights += Lamps.Contains(light.Entity) ? 1 : 0;
+        int panels = 0;
+        if (DarkensGlow)
+        {
+            for (int i = 0; i < scene.PlacedCount; i++)
+                panels += DarkenPanel(ref scene.Placed[i], materialCount) ? 1 : 0;
+            foreach (ref PreparedInstance visible in scene.VisibleSpan)
+                DarkenPanel(ref visible, materialCount);
+        }
+
+        if (Ranges.Any(r => r.From == draw))
+            Console.Error.WriteLine(
+                $"PROBE draw {draw}: {lights} of {scene.LightCount} lights off, {panels} of {scene.PlacedCount} placed instances dark (glow {Glow})"
+            );
+    }
+
+    /// <summary>Gives a lamp's instance the twin of its material. True when it took the twin.</summary>
+    private static bool DarkenPanel(ref PreparedInstance instance, int materialCount)
+    {
+        if (!Lamps.Contains(instance.Entity) || !Twins.TryGetValue(instance.Material, out uint twin) || twin >= materialCount)
+            return false;
+        instance.Material = twin;
+        return true;
+    }
+
+    /// <summary>
+    /// Turns off, in <paramref name="rows"/>, the GPU form of <paramref name="lights"/>, the lights of the lamps of the
+    /// draw that <see cref="Decide"/> decided last, and with TERTIUS_PROBE_SUN=off every light whose reach is at least 10^6 m.
+    /// </summary>
+    public static void Darken(ReadOnlySpan<PreparedLight> lights, Span<GpuLight> rows)
+    {
+        for (int i = 0; i < rows.Length; i++)
+            if ((SunOff && rows[i].PositionReach.W >= 1e6f) || Lamps.Contains(lights[i].Entity))
+                rows[i].IntensityKind = new Vector4(0, 0, 0, rows[i].IntensityKind.W);
+    }
+}
diff -ruN -x bin -x obj -x *.orig a/src/Tertius.Rendering/Scene/RayCensus.cs b/src/Tertius.Rendering/Scene/RayCensus.cs
--- a/src/Tertius.Rendering/Scene/RayCensus.cs	1969-12-31 19:00:00
+++ b/src/Tertius.Rendering/Scene/RayCensus.cs	2026-11-23 18:54:24
@@ -0,0 +1,270 @@
+using System.Globalization;
+
+namespace Tertius.Rendering;
+
+/// <summary>
+/// PROBE (ter-8pco, the ray census, never commit to src). With TERTIUS_PROBE_CENSUS=&lt;prefix&gt;, the renderer reads
+/// the diffuse sample image back after each draw whose index, counted from 0 over every draw of the run, lies in
+/// TERTIUS_PROBE_CENSUS_DRAWS="a-b" (a &lt;= draw &lt; b), and keeps running sums per render pixel in double. The resolve
+/// of the probe (screen_trace_resolve.comp) writes the sample's class into its alpha, which no pass reads for the
+/// diffuse signal: -1 for a pixel without a traced surface, else bin + log2(r) / 16. Bin 0 is a miss (the record's hit
+/// distance is 0); a hit at distance d takes bin clamp(floor(2 log2 d) + 21, 1, 63), so bins 1 to 22 lie below 2 m
+/// (class 1, a near hit) and bins 23 to 63 at or beyond it (class 2, a far hit); class 0 is a miss. r &gt;= 1 is the
+/// pre-cap sample's luminance over the sample's (log2 r capped at 15). X is the sample's luminance (Rec. 709 weights),
+/// as the accumulator receives it; Xpre = X * r is the sample before the caps of MostRayWeight and MaxRadiance.
+/// At draw b - 1 it writes &lt;prefix&gt;.sums (float64 arrays, each width * height, row by row from the top: n,
+/// sum X, sum X^2, then per class sum X_c, sum X_c * X, count; then the same for Xpre), &lt;prefix&gt;.json (sizes, the
+/// draws, the exposure stops per counted draw, and the luminance of the slow diffuse history at the last draw, a
+/// separate float32 file &lt;prefix&gt;.slow), and for each rectangle of TERTIUS_PROBE_CENSUS_KEEP
+/// ("x0,y0,x1,y1;..." in render pixels, x1 and y1 exclusive) every sample as float32 X, float32 Xpre, byte bin, then
+/// the pixel's reflection sample as float32 luminance and float32 hit distance (0 for a miss), in
+/// &lt;prefix&gt;.keep&lt;k&gt;, row by row and draw by draw; the json gives the samples per draw of each rectangle.
+/// </summary>
+internal static class RayCensus
+{
+    private static readonly string? Prefix =
+        Environment.GetEnvironmentVariable("TERTIUS_PROBE_CENSUS") is { Length: > 0 } prefix ? prefix : null;
+
+    private static readonly (int First, int End) Draws = ParseDraws(
+        Environment.GetEnvironmentVariable("TERTIUS_PROBE_CENSUS_DRAWS") ?? "240-640"
+    );
+
+    private static readonly (int X0, int Y0, int X1, int Y1)[] Keeps = ParseKeeps(
+        Environment.GetEnvironmentVariable("TERTIUS_PROBE_CENSUS_KEEP") ?? ""
+    );
+
+    private static readonly HashSet<int> DumpAt =
+    [
+        .. (Environment.GetEnvironmentVariable("TERTIUS_PROBE_CENSUS_DUMP_AT") ?? "")
+            .Split(',', StringSplitOptions.RemoveEmptyEntries)
+            .Select(v => int.Parse(v, CultureInfo.InvariantCulture)),
+    ];
+
+    private static readonly (int First, int End) TraceDump =
+        Environment.GetEnvironmentVariable("TERTIUS_PROBE_TRACE_DUMP") is { Length: > 0 } probeRange
+            ? (int.Parse(probeRange.Split('-')[0], CultureInfo.InvariantCulture),
+                int.Parse(probeRange.Split('-')[1], CultureInfo.InvariantCulture))
+            : (0, 0);
+
+    private static int draw;
+    private static int width;
+    private static int height;
+    private static double[][]? sums; // 12 arrays for X, then 12 for Xpre
+    private static readonly List<float> Stops = [];
+    private static BinaryWriter[]? keepWriters;
+    private static uint[] viewport = [];
+    private static readonly List<int> KeepCounts = [];
+
+    public static bool On => Prefix is not null;
+
+    private static (int, int) ParseDraws(string text)
+    {
+        string[] parts = text.Split('-');
+        return (int.Parse(parts[0], CultureInfo.InvariantCulture), int.Parse(parts[1], CultureInfo.InvariantCulture));
+    }
+
+    private static (int, int, int, int)[] ParseKeeps(string text) =>
+        [
+            .. text.Split(';', StringSplitOptions.RemoveEmptyEntries)
+                .Select(rect => rect.Split(',').Select(v => int.Parse(v, CultureInfo.InvariantCulture)).ToArray())
+                .Select(v => (v[0], v[1], v[2], v[3])),
+        ];
+
+    private static readonly string? ShareDumpPrefix =
+        Environment.GetEnvironmentVariable("TERTIUS_PROBE_SHARE_DUMP") is { Length: > 0 } sharePrefix ? sharePrefix : null;
+
+    private static readonly (int First, int End) ShareDumpDraws = ParseDraws(
+        Environment.GetEnvironmentVariable("TERTIUS_PROBE_SHARE_DUMP_DRAWS") ?? "0-1000000"
+    );
+
+    private static int shareDraw;
+    private static bool shareMetaWritten;
+
+    /// <summary>PROBE (ter-fe63, Design 1): appends the reflection tile share (channel R) per draw when TERTIUS_PROBE_SHARE_DUMP is set.</summary>
+    public static void ObserveShare(VulkanRenderer renderer)
+    {
+        if (ShareDumpPrefix is null)
+            return;
+        int index = shareDraw++;
+        if (index < ShareDumpDraws.First || index >= ShareDumpDraws.End)
+            return;
+        (float[] values, int w, int h) = renderer.CensusReadLevel(renderer.ScreenTraceImages.GuidedShare, 0, 0);
+        if (!shareMetaWritten)
+        {
+            File.WriteAllText($"{ShareDumpPrefix}.shares.meta", $"{w} {h} {ShareDumpDraws.First}\n");
+            if (File.Exists($"{ShareDumpPrefix}.shares.f32"))
+                File.Delete($"{ShareDumpPrefix}.shares.f32");
+            shareMetaWritten = true;
+        }
+        using var stream = new FileStream($"{ShareDumpPrefix}.shares.f32", FileMode.Append, FileAccess.Write);
+        using var writer = new BinaryWriter(stream);
+        int count = w * h;
+        for (int i = 0; i < count; i++)
+            writer.Write(values[2 * i]);
+    }
+
+    /// <summary>Called after each submitted draw.</summary>
+    public static void Observe(VulkanRenderer renderer, float? stops, uint renderWidth, uint renderHeight)
+    {
+        if (Prefix is null)
+            return;
+        int index = draw++;
+        // PROBE (ter-fe63): TERTIUS_PROBE_TRACE_DUMP=<first>-<end> writes, for each draw in the range, layers 3 (the
+        // fast history's luminance in z) and 6 (the clamp's move, lag, in w) of the specular signal's accumulation trace,
+        // which needs TERTIUS_REFLECTION_HISTORY_AGREEMENT=control-trace, as <prefix>.t<draw>.trace-<layer>.f32.
+        if (TraceDump.First <= index && index < TraceDump.End
