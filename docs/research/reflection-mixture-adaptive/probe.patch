@@ -0,0 +1,46 @@
+#version 460
+// PROBE (ter-fe63, Design 1): updates the per-tile reflection guided share from this draw's block ray slope and moment
+// sums, in a fixed deterministic row-major cell order. One invocation per 8 x 8 block tile (16 x 16 render pixels).
+// Component R holds the reflection share; component G stays 0 (reserved for diffuse later).
+#extension GL_GOOGLE_include_directive : require
+#include "screen_trace.glsl"
+
+layout(local_size_x = 8, local_size_y = 8) in;
+
+void main()
+{
+    ivec2 tile = ivec2(gl_GlobalInvocationID.xy);
+    ivec2 blocks = (ivec2(frame.viewport.xy) + 1) / 2;
+    ivec2 tiles = (blocks + 7) / 8;
+    if (any(greaterThanEqual(tile, tiles)))
+        return;
+    float ceiling = trace.probeReflectionShare;
+    float share = trace.probeShareReset != 0u ? ceiling : imageLoad(guidedShareImage, tile).r;
+    if (guideTotal() > 0.0 && ceiling > 0.0)
+    {
+        float slopeSum = 0.0;
+        float momentSum = 0.0;
+        ivec2 base = tile * 8;
+        for (int dy = 0; dy < 8; dy++)
+        {
+            int by = base.y + dy;
+            if (by >= blocks.y)
+                break;
