# SCRATCH patch of t0-xwdz (v2, the patch of the logs in logs/v2-*), never commit to src. It applies on c768e1ed8 after
# tools/renderer-survey/probe.patch and t0-gumm's scratch-first-filmed.patch and scratch-frozen.patch. With
# TERTIUS_X_TAIL_LOG=<folder> and TERTIUS_REFLECTION_HISTORY_AGREEMENT=control-trace it logs, per draw, the reflections'
# history lengths before and after the anti-lag, why a reprojected length falls under 8, and the own-ray counts.
--- a/src/Tertius.Rendering/VulkanRenderer.cs
+++ b/src/Tertius.Rendering/VulkanRenderer.cs
@@ -659,6 +659,78 @@
         MatchTargetsTo(image);
 
         FrameHistory.PendingFrame pending = BeginDraw(snapshot: snapshot, step: step, draw: draw);
+        // SCRATCH (t0-xwdz, never commit to src): with TERTIUS_X_TAIL_LOG=<folder> and the control trace
+        // (TERTIUS_REFLECTION_HISTORY_AGREEMENT=control-trace), each draw first reads what the draw before it left in the
+        // specular accumulation trace (TemporalSignal.TraceLayers: layer 0 x = the length the last draw accepted at the
+        // pixel's own texel, "own"; y = the length after the reprojection, "reprojected"; w = flags, bit 9 "shows a
+        // surface"; layer 3 x = the least length of the taps that hold weight; layer 4 x and y = the length before and
+        // after the anti-lag; layer 5 w = 1 where the clamp ran) and in the reflections' own-ray list, over the render size
+        // of that draw. It appends to <folder>/tail.txt one line: "<frame> <draw index> <width> <height>", then the counts
+        // of surface pixels: all; reprojected under 8; before the anti-lag under 8; after it under 8; the clamp ran;
+        // shortened (after below before by more than 1e-3); shortened from under 8; shortened to the fast cap 4 or less;
+        // after under draw index + 1 - 0.01 ("behind"); reprojected under 8 with own 8 or more and every weighted tap 8 or
+        // more ("rounding"); reprojected under 8 with own 8 or more and a weighted tap under 8 ("neighbor"); reprojected
+        // under 8 with own under 8 ("own short"); then the own reflection rays: all; of them reprojected 8 or more,
+        // rounding, neighbor, own short; then the own diffuse rays. <folder>/hist.txt gets "<frame> <draw index>" and the
+        // count of surface pixels whose length after the anti-lag lies in [k, k + 1) for k = 0 to 31, then 32 or more.
+        // The reads wait for the device.
+        if (Environment.GetEnvironmentVariable("TERTIUS_X_TAIL_LOG") is { Length: > 0 } probeTailFolder
+            && FrameNumber > 0
+            && ScreenTraceSignals.Specular.AccumulationTrace(0) is { } probeTrace)
+        {
+            Extent2D probeSize = pending.PreviousRenderSize;
+            (float[] probeT0, int probeWidth, _) = ReadLevel(image: probeTrace, layer: 0, mip: 0);
+            float[] probeT3 = ReadLevel(image: probeTrace, layer: 3, mip: 0).Values;
+            float[] probeT4 = ReadLevel(image: probeTrace, layer: 4, mip: 0).Values;
+            float[] probeT5 = ReadLevel(image: probeTrace, layer: 5, mip: 0).Values;
+            long[] probeCounts = new long[17];
+            long[] probeHist = new long[33];
+            int ProbeClass(int probeP) =>
+                probeT0[4 * probeP + 1] >= 8 ? 0
+                : probeT0[4 * probeP] < 8 ? 3
+                : probeT3[4 * probeP] >= 8 ? 1
+                : 2;
+            for (int probeY = 0; probeY < probeSize.Height; probeY++)
+                for (int probeX = 0; probeX < probeSize.Width; probeX++)
+                {
+                    int probeP = probeY * probeWidth + probeX;
+                    if ((((int)probeT0[4 * probeP + 3]) & (1 << 9)) == 0)
+                        continue;
+                    float probeReprojected = probeT0[4 * probeP + 1];
+                    float probeBefore = probeT4[4 * probeP];
+                    float probeAfter = probeT4[4 * probeP + 1];
+                    bool probeShortened = probeAfter < probeBefore - 1e-3f;
+                    probeCounts[0]++;
+                    probeCounts[1] += probeReprojected < 8 ? 1 : 0;
+                    probeCounts[2] += probeBefore < 8 ? 1 : 0;
+                    probeCounts[3] += probeAfter < 8 ? 1 : 0;
+                    probeCounts[4] += probeT5[4 * probeP + 3] == 1f ? 1 : 0;
+                    probeCounts[5] += probeShortened ? 1 : 0;
+                    probeCounts[6] += probeShortened && probeBefore < 8 ? 1 : 0;
+                    probeCounts[7] += probeShortened && probeAfter <= 4.001f ? 1 : 0;
+                    probeCounts[8] += probeAfter < probeTailLastDrawIndex + 1 - 0.01f ? 1 : 0;
+                    int probeClass = ProbeClass(probeP);
+                    if (probeClass > 0)
+                        probeCounts[8 + probeClass]++;
+                    probeHist[Math.Clamp((int)MathF.Floor(probeAfter), 0, 32)]++;
+                }
+            GpuBuffer[] probeLists = ScreenTraceImages.OwnRays;
+            (int X, int Y)[] probeOwn = OwnRayList.Pixels(ReadBufferWords(probeLists[0]));
+            probeCounts[12] = probeOwn.Length;
+            foreach ((int probeX, int probeY) in probeOwn)
+                probeCounts[13 + ProbeClass(probeY * probeWidth + probeX)]++;
+            int probeDiffuse = OwnRayList.Pixels(ReadBufferWords(probeLists[1])).Length;
+            string probeDir = System.IO.Directory.CreateDirectory(probeTailFolder).FullName;
+            System.IO.File.AppendAllText(
+                System.IO.Path.Combine(probeDir, "tail.txt"),
+                $"{FrameNumber - 1} {probeTailLastDrawIndex} {probeSize.Width} {probeSize.Height} {string.Join(' ', probeCounts)} {probeDiffuse}\n"
+            );
+            System.IO.File.AppendAllText(
+                System.IO.Path.Combine(probeDir, "hist.txt"),
+                $"{FrameNumber - 1} {probeTailLastDrawIndex} {string.Join(' ', probeHist)}\n"
+            );
+        }
+        probeTailLastDrawIndex = pending.DrawIndex;
         ICaptureSink? sink = takeCapture ? Interlocked.Exchange(ref pendingCapture, null) : null;
         GpuBuffer? capture = sink != null ? CaptureBuffer(slot: frame.Index, extent: image.Extent) : null;
         // After the output gave the frame an image, so a skipped frame leaves the map's frame as it is, and before
@@ -1412,6 +1484,9 @@
 
