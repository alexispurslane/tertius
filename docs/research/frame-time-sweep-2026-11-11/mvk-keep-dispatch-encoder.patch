+// MVK_SWEEP_CONCURRENT_DISPATCH in the environment makes the compute encoder of dispatches concurrent: dispatches with
+// no barrier between them can overlap, as Vulkan allows, and a barrier that keeps the encoder becomes a memory barrier.
+static bool sweepConcurrentDispatch() {
+	static const bool concurrent = getenv("MVK_SWEEP_CONCURRENT_DISPATCH") != nullptr;
+	return concurrent;
+}
+
+bool mvkSweepLogs() {
+	static const bool logs = getenv("MVK_SWEEP_LOG") != nullptr;
+	return logs;
+}
+
+const char* MVKCommandEncoder::openEncoderKind() {
+	if (_mtlRenderEncoder) return "render";
+	if (_mtlComputeEncoder) return _mtlComputeEncoderUse == kMVKCommandUseDispatch ? "dispatch" : "compute-other";
+	if (_mtlBlitEncoder) return "blit";
+	return "none";
+}
+
+bool MVKCommandEncoder::hasOpenDispatchEncoder() {
+	return _mtlComputeEncoder && _mtlComputeEncoderUse == kMVKCommandUseDispatch && _timestampStageCounterQueries.empty();
+}
+
+// A serial compute encoder runs its dispatches in their order, so a barrier between two of its dispatches needs no new
+// encoder. Three rules keep the order that the barrier asks for:
+// - The open encoder waits for the latest fence of each source stage. Metal can apply such a wait at the start of the
+//   encoder, which orders the dispatches before the barrier too, and that is harmless.
+// - The open encoder holds compute work from before the barrier, and it updates its compute fence only when it ends.
+//   So each destination stage waits for that fence: a later encoder then runs after the whole open encoder.
+// - For every other source stage, the destination stages wait for the stage's latest fence, as setBarrier does.
+void MVKCommandEncoder::setBarrierInDispatchEncoder(uint64_t sourceStageMask, uint64_t destStageMask) {
+	auto &fenceSlots = _pEncodingContext->fenceSlots;
+	for (int i = 0; i < kMVKBarrierStageCount; ++i) {
+		if (!mvkIsAnyFlagEnabled(sourceStageMask, 1ull << i)) continue;
+
+		[_mtlComputeEncoder waitForFence: _device->getFence((MVKBarrierStage)i, fenceSlots.update[i])];
+		if (i == kMVKBarrierStageCompute) {
+			// Settles the fence that the open encoder updates when it ends: fenceSlots.update holds it from here on.
+			getBarrierStageFence(kMVKBarrierStageCompute);
+		}
+		for (int j = 0; j < kMVKBarrierStageCount; ++j) {
+			if (!mvkIsAnyFlagEnabled(destStageMask, 1ull << j)) continue;
+
+			fenceSlots.wait[j][i] = fenceSlots.update[i];
+		}
+		fenceSlots.wait[i][i] = fenceSlots.update[i];
+		if (i != kMVKBarrierStageCompute) { mvkEnableFlags(fenceSlots.updateDirtyBits, 1 << i); }
+	}
+	if (sweepConcurrentDispatch()) {
+		[_mtlComputeEncoder memoryBarrierWithScope: (MTLBarrierScopeBuffers | MTLBarrierScopeTextures)];
+	}
+}
