diff --git a/src/Tertius.Rendering/Shaders/bloom_up.comp b/src/Tertius.Rendering/Shaders/bloom_up.comp
new file mode 100644
index 000000000..f717d3c62
--- /dev/null
+++ b/src/Tertius.Rendering/Shaders/bloom_up.comp
@@ -0,0 +1,16 @@
+#version 460
+#extension GL_GOOGLE_include_directive : require
+#define BLOOM_TARGET
+#include "bloom.glsl"
+#include "tent.glsl"
+
+// An upsample from one bloom level into the larger one before it, which the step adds to. Level i then holds itself
+// plus every smaller level. The level's alpha stays as it was.
+void main()
+{
+    ivec2 pixel;
+    if (!targetPixel(pixel))
+        return;
+    vec4 held = imageLoad(target, pixel);
+    imageStore(target, pixel, vec4(held.rgb + tent(source, linearClamp, centerOf(pixel)), held.a));
+}
