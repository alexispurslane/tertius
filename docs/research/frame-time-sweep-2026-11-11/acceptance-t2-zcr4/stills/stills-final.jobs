# The image test of the final commit of the face that lights each texel once (t2-zcr4): face6 is commit 3dae7207b with
# the exposure switch of edits/base.py. Its stills must equal those of face3 (stills-one.jobs and stills-skip.jobs), the
# tree that takes 18 and 19 timed, byte for byte: the last edits and the merges of main change no image.
one() { # one <script path> <name> <stops>
  SWEEP_EXPOSURE=$3 run face6 $1 zo-$2-face6
}
one capscripts/station.json station -8.85
one capscripts/demo-surface.json demo-surface -8.95
one capscripts/mirror-balls.json mirror-balls -6.4
one capscripts/doorway.json doorway -9.695
one capscripts/cabin-light.json cabin-light -8.36
one capscripts/rigs.json rigs -9.3555
one capscripts/demo-shuttle.json demo-shuttle -9.346
