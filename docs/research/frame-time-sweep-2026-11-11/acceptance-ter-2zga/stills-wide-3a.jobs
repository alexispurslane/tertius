# The wide frame check of the patched MoltenVK on the branch after the second merge of main (ter-2zga), part a. Each capture
# script runs under the patched driver (the shell's default) and under the stock driver. The binary merged3 is the
# merged branch's Release build without an edit. The low view and three scripts also run under Metal's API validation.
echo "default driver: $VK_ICD_FILENAMES"
echo "stock driver:   $TERTIUS_STOCK_MOLTENVK_ICD"
run merged3 views2.json drv3-low-keep
VK_ICD_FILENAMES=$TERTIUS_STOCK_MOLTENVK_ICD run merged3 views2.json drv3-low-stock
MTL_DEBUG_LAYER=1 run merged3 views2.json drv3-low-validate
for s in airlock bounce-red-wall cabin-light deep-yard demo-meshes demo-shuttle demo-surface doorway mars-air mirror-balls pbr-spheres reflections-stills; do
  run merged3 capscripts/$s.json drv3-$s-keep
  VK_ICD_FILENAMES=$TERTIUS_STOCK_MOLTENVK_ICD run merged3 capscripts/$s.json drv3-$s-stock
done
MTL_DEBUG_LAYER=1 run merged3 capscripts/doorway.json drv3-doorway-validate
MTL_DEBUG_LAYER=1 run merged3 capscripts/demo-surface.json drv3-demo-surface-validate
run br3 deck.json drv3-deck-keep
VK_ICD_FILENAMES=$TERTIUS_STOCK_MOLTENVK_ICD run br3 deck.json drv3-deck-stock
MTL_DEBUG_LAYER=1 run br3 deck.json drv3-deck-validate
