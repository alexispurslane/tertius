# Take 6f: the patched driver against stock MoltenVK on the branch after the third merge of main (5330c7411, with the
# hit light image), without the pass time stamps. The binary br4 is that code's Release build with the deck's fixed
# exposure.
NS="--pass-timestamps off"
VK_ICD_FILENAMES=$TERTIUS_STOCK_MOLTENVK_ICD trace deck-acc-o-stock br4 $D $NS
trace deck-acc-o-keep br4 $D $NS
TRACE_EXTRA_ENV="TERTIUS_MOLTENVK_STOCK_BARRIERS=1" trace deck-acc-o-switch br4 $D $NS
VK_ICD_FILENAMES=$TERTIUS_STOCK_MOLTENVK_ICD trace deck-acc-o-stock-b br4 $D $NS
trace deck-acc-o-keep-b br4 $D $NS
