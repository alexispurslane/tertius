# Take 6e: the patched driver against stock MoltenVK on the branch after the second merge of main (75ecde376, with
# FSR's clear step in one dispatch), without the pass time stamps. The binary br3 is that code's Release build with the
# deck's fixed exposure.
NS="--pass-timestamps off"
VK_ICD_FILENAMES=$TERTIUS_STOCK_MOLTENVK_ICD trace deck-acc-n-stock br3 $D $NS
trace deck-acc-n-keep br3 $D $NS
TRACE_EXTRA_ENV="TERTIUS_MOLTENVK_STOCK_BARRIERS=1" trace deck-acc-n-switch br3 $D $NS
VK_ICD_FILENAMES=$TERTIUS_STOCK_MOLTENVK_ICD trace deck-acc-n-stock-b br3 $D $NS
trace deck-acc-n-keep-b br3 $D $NS
