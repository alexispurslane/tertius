+namespace Tertius.Rendering;
+
+/// <summary>
+/// Probe code of t1-3er4 (docs/research/cut-grid-probe): the stencil of the short-history fix, step 3 of
+/// accumulate_spatial.comp. TERTIUS_PROBE_FIX_STENCIL selects it: baseline (unset), off (no fix), a (one of four
+/// orientations of the 3 × 3 square per block of 8 × 8 pixels) or b (one of eight orientations per pixel, from the
+/// blue-noise mask). TERTIUS_PROBE_FIX_LIGHT limits it to one signal: all (unset), diffuse or specular.
+/// </summary>
+internal static class FixStencilProbe
+{
+    /// <summary>The tests' choice, which wins over the variables when it is set.</summary>
+    public static uint? Override { get; set; }
+
+    private static readonly uint FromEnvironment = Environment.GetEnvironmentVariable("TERTIUS_PROBE_FIX_STENCIL") switch
+    {
+        null or "" or "baseline" => 0u,
+        "off" => 1u,
+        "a" => 2u,
+        "b" => 3u,
+        var value => throw new ArgumentException($"Unknown TERTIUS_PROBE_FIX_STENCIL value '{value}'."),
+    };
+
+    private static readonly string Light = Environment.GetEnvironmentVariable("TERTIUS_PROBE_FIX_LIGHT") ?? "all";
+
+    /// <summary>The stencil mode of the signal whose light is <paramref name="light"/>: 0 baseline, 1 off, 2 A, 3 B.</summary>
+    public static uint ModeFor(SignalLight light)
+    {
+        if (Override is { } chosen)
+            return chosen;
+        bool applies = Light switch
+        {
+            "all" or "" => true,
+            "diffuse" => light == SignalLight.Diffuse,
+            "specular" => light == SignalLight.Specular,
+            _ => throw new ArgumentException($"Unknown TERTIUS_PROBE_FIX_LIGHT value '{Light}'."),
+        };
+        return applies ? FromEnvironment : 0u;
+    }
+}
