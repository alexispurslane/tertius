+// Probe code of t1-3er4: the fix's stencils. Each row holds the four representatives d of the pairs ±d of one orientation
+// of the 3 × 3 square: u, v, u + v and u − v, with u = spacing × (cos θ, sin θ) and v = u turned by 90 degrees, each
+// rounded to whole pixels. The first row of each table is today's axis-aligned square. Spacing 4: θ = 0, 11.25, 22.5,
+// 33.75, 45, 56.25, 67.5 and 78.75 degrees. Spacing 2: θ = 0, 26.57, 45 and −26.57 degrees. Spacing 1 keeps the square.
+const ivec2 Spacing4Stencils[32] = ivec2[](
+    ivec2(4, 0), ivec2(0, 4), ivec2(4, 4), ivec2(4, -4),
+    ivec2(4, 1), ivec2(-1, 4), ivec2(3, 5), ivec2(5, -3),
+    ivec2(4, 2), ivec2(-2, 4), ivec2(2, 5), ivec2(5, -2),
+    ivec2(3, 2), ivec2(-2, 3), ivec2(1, 6), ivec2(6, -1),
+    ivec2(3, 3), ivec2(-3, 3), ivec2(0, 6), ivec2(6, 0),
+    ivec2(2, 3), ivec2(-3, 2), ivec2(-1, 6), ivec2(6, 1),
+    ivec2(2, 4), ivec2(-4, 2), ivec2(-2, 5), ivec2(5, 2),
+    ivec2(1, 4), ivec2(-4, 1), ivec2(-3, 5), ivec2(5, 3));
+const ivec2 Spacing2Stencils[16] = ivec2[](
+    ivec2(2, 0), ivec2(0, 2), ivec2(2, 2), ivec2(2, -2),
+    ivec2(2, 1), ivec2(-1, 2), ivec2(1, 3), ivec2(3, -1),
+    ivec2(1, 1), ivec2(-1, 1), ivec2(0, 3), ivec2(3, 0),
+    ivec2(2, -1), ivec2(1, 2), ivec2(3, 1), ivec2(1, -3));
+const uint ProbeBaseline = 0u;
+const uint ProbeOff = 1u;
+const uint ProbeStencilA = 2u;
+const uint ProbeStencilB = 3u;
+
+// The row of the stencil table that `pixel` takes at `spacing` under the probe's mode: row 0 for the baseline and at
+// spacing 1. Stencil A takes one of the rows 0, 2, 4, 6 at spacing 4 (0, 22.5, 45, 67.5 degrees) and one of the four
+// rows at spacing 2, the same for every pixel of a block of 8 × 8, from a hash of the block and the draw. Stencil B takes
+// one of the eight rows at spacing 4 or of the four at spacing 2 per pixel, from the mask's radial byte at the pixel and
+// the draw.
+int probeStencilRow(ivec2 pixel, int spacing)
+{
+    if (spacing == 1 || parameters.probeFixStencil == ProbeBaseline)
+        return 0;
+    if (parameters.probeFixStencil == ProbeStencilA)
+    {
+        uint pick = pcg3d(uvec3(uvec2(pixel) >> 3u, parameters.probeDrawIndex ^ 0x41u)).x >> 30u;
+        return spacing == 4 ? int(pick * 2u) : int(pick);
+    }
+    uint byte = blueNoiseBytesOf(pixel, parameters.probeDrawIndex).r;
+    return spacing == 4 ? int(byte >> 5u) : int(byte >> 6u);
+}
+
+// The neighbor offset of the square's tap (x, y), x and y in −1 to 1, in row `row` at `spacing`: (±1, 0) takes ±u, (0, ±1)
+// takes ±v, (1, 1) and (−1, −1) take ±(u + v), and (1, −1) and (−1, 1) take ±(u − v). Row 0 gives spacing × (x, y), so
+// the baseline reads the same taps in the same order as main.
+ivec2 probeTapOffset(int row, int x, int y, int spacing)
+{
+    int base = row * 4;
+    ivec2 u, v, sum, difference;
+    if (spacing == 4)
+    {
+        u = Spacing4Stencils[base]; v = Spacing4Stencils[base + 1];
+        sum = Spacing4Stencils[base + 2]; difference = Spacing4Stencils[base + 3];
+    }
+    else if (spacing == 2)
+    {
+        u = Spacing2Stencils[base]; v = Spacing2Stencils[base + 1];
+        sum = Spacing2Stencils[base + 2]; difference = Spacing2Stencils[base + 3];
+    }
+    else
+        return spacing * ivec2(x, y);
+    if (y == 0)
+        return x * u;
+    if (x == 0)
+        return y * v;
+    return x == y ? x * sum : x * difference;
+}
