diff --git a/tests/Tertius.Rendering.Tests/CutGridProbeTests.cs b/tests/Tertius.Rendering.Tests/CutGridProbeTests.cs
new file mode 100644
index 000000000..3733b4d46
--- /dev/null
+++ b/tests/Tertius.Rendering.Tests/CutGridProbeTests.cs
@@ -0,0 +1,101 @@
+using System.Numerics;
+using Tertius.Testing;
+
+namespace Tertius.Rendering.Tests;
+
+/// <summary>
+/// Probe code of t1-3er4 (docs/research/cut-grid-probe): the impulse response of the short-history fix, step 3 of
+/// accumulate_spatial.comp, under each stencil mode. A wall fills the view of 256 × 128 pixels. The test signal's samples
+/// are 0 except for 50 single bright samples of light 81, one in each cell of 24 × 24 pixels, at a place in the cell that
+/// moves against the blocks of 8 × 8. The dump holds the slow history of part 0, RGBA as float32, row by row.
+/// TERTIUS_PROBE_DUMP names the folder of the dumps. Without it the test does nothing.
+/// </summary>
+[Collection(GpuCollection.Name)]
+public sealed class CutGridProbeTests
+{
+    private const int Width = 256,
+        Height = 128,
+        Cell = 24;
+
+    private const float Bright = 81f;
+
+    private static readonly SignalParameters Parameters = SignalParameters.Diffuse with { Cap = 16, SmoothCap = 16 };
+
+    /// <summary>Whether (column, row) holds one of the bright samples.</summary>
+    public static bool IsImpulse(int column, int row)
+    {
+        int i = column / Cell,
+            j = row / Cell;
+        if (i >= Width / Cell || j >= Height / Cell)
+            return false;
+        int jitter = (i * 3 + j * 5) % 8;
+        return column == i * Cell + 8 + jitter && row == j * Cell + 8 + (i * 5 + j * 3) % 8;
+    }
+
+    [Fact]
+    public void DumpsTheImpulseResponses()
+    {
+        string? folder = Environment.GetEnvironmentVariable("TERTIUS_PROBE_DUMP");
+        if (folder is null)
+            return;
+        Directory.CreateDirectory(folder);
+        try
+        {
+            foreach ((string name, uint mode) in new[] { ("baseline", 0u), ("a", 2u), ("b", 3u), ("off", 1u) })
+            {
+                FixStencilProbe.Override = mode;
+                // The impulse in draw n alone, after n draws of zeros: spacing 4, 2 and 1.
+                for (int n = 0; n < 3; n++)
+                    Run(folder: folder, tag: $"{name}-stage{n}", impulseDraw: n, draws: n + 1);
+                // The impulse in draw 0 and zeros after it, read after each of draws 0 to 5.
+                Run(folder: folder, tag: $"{name}-evolution", impulseDraw: 0, draws: 6);
+            }
+        }
+        finally
+        {
+            FixStencilProbe.Override = null;
+        }
+    }
+
+    private static void Run(string folder, string tag, int impulseDraw, int draws)
+    {
+        VulkanRenderer renderer = Gpu.Headless(width: Width, height: Height);
+        try
+        {
+            MeshId cube = renderer.CreateMesh(Primitives.Box(new(0.5f)));
+            MaterialId white = renderer.CreateMaterial(MaterialDesc.Color(Vector4.One, roughness: 0.5f));
+            RenderSnapshot scene = Gpu.Snapshot(new(0.3f, 1f, 0.4f));
+            scene.Instances.Add(
+                Gpu.Instance(
+                    mesh: cube,
+                    material: white,
+                    position: new(0, 0, -20),
+                    scale: new(80, 60, 1),
+                    chainDepth: TestChains.CamerasFrame,
+                    entity: 1
+                )
+            );
+            var sample = new SamplePass(renderer.CreateSignal(parameters: Parameters, name: "probe", parts: 2), renderer.Allocator);
+            renderer.Graph.Add(FrameGraph.Stage.DirectLight, sample);
+            renderer.Graph.Add(FrameGraph.Stage.DirectLight, new AccumulatePass(sample.Signal));
+            for (int draw = 0; draw < draws; draw++)
+            {
+                bool impulses = draw == impulseDraw;
+                sample.Samples = (column, row) =>
+                    new Vector4(new Vector3(impulses && IsImpulse(column, row) ? Bright : 0f), 1f);
+                scene.Time += 1.0 / 60.0;
+                renderer.Render(scene, 1f);
+                if (draws > impulseDraw + 1 || draw == draws - 1)
+                {
+                    float[] history = renderer.ReadImage(sample.Signal.Slow(0));
+                    using var file = File.Create(Path.Combine(folder, $"{tag}-draw{draw}.f32"));
+                    file.Write(System.Runtime.InteropServices.MemoryMarshal.AsBytes(history.AsSpan()));
+                }
+            }
+        }
+        finally
+        {
+            Gpu.DisposeAndAssertClean(renderer);
+        }
+    }
+}
