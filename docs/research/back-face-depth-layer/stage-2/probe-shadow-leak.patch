diff --git a/src/Tertius.Rendering/ShadowProbe.cs b/src/Tertius.Rendering/ShadowProbe.cs
new file mode 100644
index 000000000..06c3213f0
--- /dev/null
+++ b/src/Tertius.Rendering/ShadowProbe.cs
@@ -0,0 +1,75 @@
+using System.Globalization;
+using System.Numerics;
+using System.Text.Json;
+
+namespace Tertius.Rendering;
+
+/// <summary>
+/// THROWAWAY (t1-3j2j): the switches of the diagnosis of the sun's shadow leak, and a dump of the cascades.
+/// <c>TERTIUS_SHADOW_SLOPE</c> sets the cascades' slope-scaled bias (2.5), <c>TERTIUS_SHADOW_CONSTANT</c> their constant
+/// bias in texels (0.5), <c>TERTIUS_SHADOW_NORMAL</c> the normal offset in texels (1). <c>TERTIUS_SHADOW_FILTER</c> picks
+/// the cascades' filter: 0 the 4 × 4 taps, 1 one bilinear tap at the lookup, 2 the 4 × 4 taps with their reach scaled to
+/// the sun's penumbra from a blocker search. <c>TERTIUS_SHADOW_MAP_SIZE</c> sets the cascades' side in texels (2048). Under <c>TERTIUS_SHADOW_DUMP=&lt;folder&gt;</c>, the capture of index
+/// <c>TERTIUS_SHADOW_DUMP_AT</c> (239) writes the four cascades of set 0 and their fit.
+/// </summary>
+internal static class ShadowProbe
+{
+    private static float Read(string name, float fallback) =>
+        float.TryParse(Environment.GetEnvironmentVariable(name), NumberStyles.Float, CultureInfo.InvariantCulture, out float v)
+            ? v
+            : fallback;
+
+    public static readonly float SlopeBias = Read("TERTIUS_SHADOW_SLOPE", ShadowBias.SlopeBias);
+    public static readonly float ConstantBiasTexels = Read("TERTIUS_SHADOW_CONSTANT", ShadowBias.ConstantBiasTexels);
+    public static readonly float NormalOffsetTexels = Read("TERTIUS_SHADOW_NORMAL", ShadowBias.NormalOffsetTexels);
+    public static readonly float Filter = Read("TERTIUS_SHADOW_FILTER", 0f);
+    public static readonly int MapSize = (int)Read("TERTIUS_SHADOW_MAP_SIZE", ShadowMap.DefaultSize);
+
+    private static readonly string? Folder =
+        Environment.GetEnvironmentVariable("TERTIUS_SHADOW_DUMP") is { Length: > 0 } folder ? folder : null;
+    private static readonly int At = (int)Read("TERTIUS_SHADOW_DUMP_AT", 239f);
+    private static int captures;
+
+    public static void Captured(VulkanRenderer renderer, PreparedScene scene)
+    {
+        if (Folder is null || captures++ != At || scene.CascadeSetCount == 0)
+            return;
+        Directory.CreateDirectory(Folder);
+        using (var stream = File.Create(Path.Combine(Folder, "cascades.json")))
+        using (var json = new Utf8JsonWriter(stream, new() { Indented = true }))
+        {
+            json.WriteStartObject();
+            json.WriteNumber("capture", At);
+            json.WriteNumber("mapSize", renderer.ShadowMap.Size);
+            json.WriteNumber("slopeBias", SlopeBias);
+            json.WriteNumber("constantBiasTexels", ConstantBiasTexels);
+            json.WriteNumber("normalOffsetTexels", NormalOffsetTexels);
+            json.WriteNumber("filter", Filter);
+            json.WriteStartArray("cascades");
+            for (int c = 0; c < ShadowCascades.Count; c++)
+            {
+                ShadowCascade cascade = scene.CascadeSets[0][c];
+                json.WriteStartObject();
+                Matrix4x4 m = cascade.ViewProjection;
+                json.WriteStartArray("viewProjectionRows");
+                foreach (float v in new[] { m.M11, m.M12, m.M13, m.M14, m.M21, m.M22, m.M23, m.M24, m.M31, m.M32, m.M33, m.M34, m.M41, m.M42, m.M43, m.M44 })
+                    json.WriteNumberValue(v);
+                json.WriteEndArray();
+                json.WriteNumber("texel", cascade.TexelSize);
+                json.WriteNumber("halfExtent", cascade.HalfExtent);
+                json.WriteNumber("depthHalfRange", cascade.DepthHalfRange);
+                json.WriteNumber("nearDepth", cascade.NearDepth);
+                json.WriteNumber("farDepth", cascade.FarDepth);
+                json.WriteNumber("split", ShadowCascades.Split(c));
+                json.WriteNumber("blendStart", ShadowCascades.BlendStart(c));
+                json.WriteEndObject();
+                File.WriteAllBytes(
+                    Path.Combine(Folder, $"cascade-{c}.f32"),
+                    System.Runtime.InteropServices.MemoryMarshal.AsBytes<float>(renderer.ReadShadowCascade(0, c)).ToArray()
+                );
+            }
+            json.WriteEndArray();
+            json.WriteEndObject();
+        }
+    }
+}
