diff --git a/src/Tertius.Rendering/Shaders/back_face_clipped.vert b/src/Tertius.Rendering/Shaders/back_face_clipped.vert
new file mode 100644
index 000000000..ece008bc9
--- /dev/null
+++ b/src/Tertius.Rendering/Shaders/back_face_clipped.vert
@@ -0,0 +1,22 @@
+#version 460
+#extension GL_GOOGLE_include_directive : require
+#include "frame.glsl"
+#include "draw.glsl"
+
+// THROWAWAY (t1-kiaw): back_face.vert with every vertex right of the clip volume, under TERTIUS_BACK_FACE_SPLIT=clipped.
+// The vertex stage does the same work, and clipping rejects every triangle before the rasterizer: the pass's vertex
+// work alone.
+layout(location = 0) in vec3 inPosition;
+
+layout(location = 0) out vec3 outPosition;
+
+void main()
+{
+    GpuInstance instance = instances[gl_InstanceIndex];
+    vec4 p = vec4(inPosition, 1.0);
+    vec3 world = vec3(dot(instance.modelRow0, p), dot(instance.modelRow1, p), dot(instance.modelRow2, p));
+    outPosition = world;
+    vec4 clip = draw.viewProj * vec4(world, 1.0);
+    // x > |w| for every vertex, so each triangle lies wholly outside the plane x = w.
+    gl_Position = vec4(abs(clip.x) + 2.0 * abs(clip.w) + 1.0, clip.yzw);
+}
diff --git a/src/Tertius.Rendering/Shaders/back_face_pulled.vert b/src/Tertius.Rendering/Shaders/back_face_pulled.vert
new file mode 100644
index 000000000..d4cdfbd56
--- /dev/null
+++ b/src/Tertius.Rendering/Shaders/back_face_pulled.vert
@@ -0,0 +1,37 @@
+#version 460
+#extension GL_GOOGLE_include_directive : require
+#include "frame.glsl"
+#include "draw.glsl"
+
+// THROWAWAY (t1-kiaw): back_face.vert with the position read from storage buffers instead of the vertex input, under
+// TERTIUS_BACK_FACE_FETCH=pulled or packed. A static vertex reads the three position words of its 13-word GpuVertex in
+// the global vertex buffer. Under packed, a vertex of the deform region reads its three floats in this frame's kept
+// positions (KeptPositions.cs), which deform.comp wrote with the same bits as the copy's position.
+layout(constant_id = 16) const uint ProbeRegionBase = 0u;
+layout(constant_id = 17) const bool ProbePacked = false;
+
+layout(set = 3, binding = 0, std430) readonly buffer ProbeVertexWords { float vertexWords[]; };
+layout(set = 3, binding = 1, std430) readonly buffer ProbeKeptNow { float keptNow[]; };
+
+layout(location = 0) out vec3 outPosition;
+
+void main()
+{
+    GpuInstance instance = instances[gl_InstanceIndex];
+    uint v = uint(gl_VertexIndex);
+    vec3 position;
+    if (ProbePacked && v >= ProbeRegionBase)
+    {
+        uint k = 3u * (v - ProbeRegionBase);
+        position = vec3(keptNow[k], keptNow[k + 1u], keptNow[k + 2u]);
+    }
+    else
+    {
+        uint k = 13u * v;
+        position = vec3(vertexWords[k], vertexWords[k + 1u], vertexWords[k + 2u]);
+    }
+    vec4 p = vec4(position, 1.0);
+    vec3 world = vec3(dot(instance.modelRow0, p), dot(instance.modelRow1, p), dot(instance.modelRow2, p));
+    outPosition = world;
+    gl_Position = draw.viewProj * vec4(world, 1.0);
+}
