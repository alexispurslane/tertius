diff --git a/src/Tertius.Rendering/SceneExport.cs b/src/Tertius.Rendering/SceneExport.cs
new file mode 100644
index 000000000..0673cf9cd
--- /dev/null
+++ b/src/Tertius.Rendering/SceneExport.cs
@@ -0,0 +1,207 @@
+using System.Numerics;
+using System.Text.Json;
+
+namespace Tertius.Rendering;
+
+/// <summary>
+/// THROWAWAY (ter-kh4g, stage 2, t1-g4p1): writes the geometry, the materials, the lights and the camera of one drawn frame,
+/// so that an offline path tracer (Blender's Cycles) can render a reference of the same view. Under
+/// <c>TERTIUS_SCENE_EXPORT=&lt;folder&gt;</c> the stores keep a CPU copy of every mesh and material that they upload, and
+/// the capture of index <c>TERTIUS_SCENE_EXPORT_AT</c> (0 for the first) writes <c>scene.json</c> and one
+/// <c>mesh-&lt;id&gt;.bin</c> per mesh that a placed instance draws. Every position is camera-relative, in the renderer's
+/// world axes, in m.
+/// </summary>
+internal static class SceneExport
+{
+    public static readonly string? Folder =
+        Environment.GetEnvironmentVariable("TERTIUS_SCENE_EXPORT") is { Length: > 0 } folder ? folder : null;
+
+    private static readonly int At = int.TryParse(Environment.GetEnvironmentVariable("TERTIUS_SCENE_EXPORT_AT"), out int at)
+        ? at
+        : 0;
+
+    private static readonly List<(Vector3[] Positions, Vector3[] Normals, uint[] Indices, bool Deforms)> meshes = [];
+    private static readonly List<GpuMaterial> materials = [];
+    private static int captures;
+
+    public static void KeepMesh(GpuVertex[] vertices, uint[] indices, bool deforms)
+    {
+        if (Folder is null)
+            return;
+        var positions = new Vector3[vertices.Length];
+        var normals = new Vector3[vertices.Length];
+        for (int i = 0; i < vertices.Length; i++)
+        {
+            positions[i] = vertices[i].Position;
+            normals[i] = vertices[i].Normal;
+        }
+        meshes.Add((positions, normals, (uint[])indices.Clone(), deforms));
+    }
+
+    public static void KeepMaterial(in GpuMaterial material)
+    {
+        if (Folder is not null)
+            materials.Add(material);
+    }
+
+    /// <summary>Counts a capture and writes the scene at the chosen one.</summary>
+    public static void Captured(PreparedScene scene, ReadOnlySpan<MaterialInfo> infos)
+    {
+        if (Folder is null)
+            return;
+        if (captures++ != At)
+            return;
+        Directory.CreateDirectory(Folder);
+        using var stream = File.Create(Path.Combine(Folder, "scene.json"));
+        using var json = new Utf8JsonWriter(stream, new() { Indented = true });
+        json.WriteStartObject();
+        json.WriteNumber("capture", At);
+        CameraView camera = scene.Camera;
+        json.WriteStartObject("camera");
+        Vec(json, "right", camera.Right);
+        Vec(json, "up", camera.Up);
+        Vec(json, "forward", camera.Forward);
+        json.WriteNumber("verticalFov", camera.VerticalFov);
+        json.WriteNumber("tanHalfX", camera.TanHalfX);
+        json.WriteNumber("tanHalfY", camera.TanHalfY);
+        json.WriteNumber("width", camera.Width);
+        json.WriteNumber("height", camera.Height);
+        json.WriteEndObject();
+        json.WriteString(
+            "ambient",
+            scene.Ambient.TryGetValue(out HemisphereAmbient hemisphere)
+                ? $"hemisphere sky {hemisphere.Light.SkyColor} ground {hemisphere.Light.GroundColor} x {hemisphere.Light.Intensity}"
+                : "map"
+        );
+        json.WriteString("atmosphere", $"center {scene.Atmosphere.CenterRadius} sky {scene.Atmosphere.Sky} haze {scene.Atmosphere.Haze} sun {scene.Atmosphere.Sun}");
+        json.WriteNumber("airSunLight", scene.AirSunLight ?? -1);
+        var used = new SortedSet<int>();
+        json.WriteStartArray("instances");
+        foreach (ref readonly PreparedInstance instance in scene.PlacedSpan)
+        {
+            json.WriteStartObject();
+            json.WriteNumber("mesh", instance.Mesh);
+            json.WriteNumber("material", instance.Material);
+            Vec(json, "position", instance.Position);
+            json.WriteStartArray("rotation");
+            json.WriteNumberValue(instance.Rotation.X);
+            json.WriteNumberValue(instance.Rotation.Y);
+            json.WriteNumberValue(instance.Rotation.Z);
+            json.WriteNumberValue(instance.Rotation.W);
+            json.WriteEndArray();
+            Vec(json, "scale", instance.Scale);
+            json.WriteNumber("radius", instance.Radius);
+            json.WriteNumber("flags", (uint)instance.Flags);
+            json.WriteString("alpha", instance.Alpha.ToString());
+            json.WriteBoolean("twoSided", instance.TwoSided);
+            json.WriteBoolean("holdsLight", instance.HoldsLight);
+            json.WriteEndObject();
+            used.Add(instance.Mesh);
+        }
+        json.WriteEndArray();
+        json.WriteStartArray("materials");
+        for (int slot = 0; slot < materials.Count; slot++)
+        {
+            GpuMaterial m = materials[slot];
+            json.WriteStartObject();
+            json.WriteNumber("slot", slot);
+            json.WriteStartArray("baseColor");
+            json.WriteNumberValue(m.BaseColor.X);
+            json.WriteNumberValue(m.BaseColor.Y);
+            json.WriteNumberValue(m.BaseColor.Z);
+            json.WriteNumberValue(m.BaseColor.W);
+            json.WriteEndArray();
+            Vec(json, "emissive", m.Emissive);
+            json.WriteNumber("metallic", m.Metallic);
+            json.WriteNumber("roughness", m.Roughness);
+            json.WriteNumber("reflectance", m.Reflectance);
+            json.WriteNumber("baseColorMap", m.BaseColorMap);
+            json.WriteNumber("normalMap", m.NormalMap);
+            json.WriteNumber("metallicRoughnessMap", m.MetallicRoughnessMap);
+            json.WriteNumber("shading", m.Shading);
+            json.WriteString("alpha", slot < infos.Length ? infos[slot].Alpha.ToString() : "?");
+            json.WriteEndObject();
+        }
+        json.WriteEndArray();
+        json.WriteStartArray("lights");
+        for (int i = 0; i < scene.LightCount; i++)
+        {
+            ref readonly PreparedLight light = ref scene.Lights[i];
+            json.WriteStartObject();
+            Vec(json, "position", light.Position);
+            Vec(json, "intensity", light.RadiantIntensity);
+            json.WriteNumber("radius", light.Radius);
+            json.WriteNumber("reach", light.Reach);
+            json.WriteNumber("distance", light.Distance);
+            json.WriteBoolean("castsShadow", light.CastsShadow);
+            json.WriteBoolean("inMainView", light.InMainView);
+            switch (light.Spread)
+            {
+                case EveryDirection(var halfSegment):
+                    json.WriteString("kind", halfSegment == Vector3.Zero ? "point" : "tube");
+                    Vec(json, "halfSegment", halfSegment);
+                    break;
+                case Cone(var axis, var cosInner, var cosOuter, var outerAngle):
+                    json.WriteString("kind", "spot");
+                    Vec(json, "axis", axis);
+                    json.WriteNumber("cosInner", cosInner);
+                    json.WriteNumber("cosOuter", cosOuter);
+                    json.WriteNumber("outerAngle", outerAngle);
+                    break;
+                case RectFace(var halfWidth, var halfHeight):
+                    json.WriteString("kind", "rect");
+                    Vec(json, "halfWidth", halfWidth);
+                    Vec(json, "halfHeight", halfHeight);
+                    break;
+            }
+            json.WriteEndObject();
+        }
+        json.WriteEndArray();
+        json.WriteStartArray("meshes");
+        foreach (int mesh in used)
+        {
+            json.WriteStartObject();
+            json.WriteNumber("id", mesh);
+            if (mesh < meshes.Count)
+            {
+                (Vector3[] positions, Vector3[] normals, uint[] indices, bool deforms) = meshes[mesh];
+                json.WriteNumber("vertices", positions.Length);
+                json.WriteNumber("indices", indices.Length);
+                json.WriteBoolean("deforms", deforms);
+                using var file = File.Create(Path.Combine(Folder, $"mesh-{mesh}.bin"));
+                using var writer = new BinaryWriter(file);
+                writer.Write(positions.Length);
+                writer.Write(indices.Length);
+                foreach (Vector3 p in positions)
+                {
+                    writer.Write(p.X);
+                    writer.Write(p.Y);
+                    writer.Write(p.Z);
+                }
+                foreach (Vector3 n in normals)
+                {
+                    writer.Write(n.X);
+                    writer.Write(n.Y);
+                    writer.Write(n.Z);
+                }
+                foreach (uint index in indices)
+                    writer.Write(index);
+            }
+            else
+                json.WriteString("missing", "a frame mesh past the static meshes");
+            json.WriteEndObject();
+        }
+        json.WriteEndArray();
+        json.WriteEndObject();
+        Console.WriteLine($"scene export: capture {At}, {scene.PlacedCount} instances, {scene.LightCount} lights, into {Folder}");
+    }
+
+    private static void Vec(Utf8JsonWriter json, string name, Vector3 value)
+    {
+        json.WriteStartArray(name);
+        json.WriteNumberValue(value.X);
+        json.WriteNumberValue(value.Y);
+        json.WriteNumberValue(value.Z);
+        json.WriteEndArray();
+    }
+}
