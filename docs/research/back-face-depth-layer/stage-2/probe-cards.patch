@@ -0,0 +1,33 @@
+// THROWAWAY (t1-yy2f): the fragment rule of the back-face pass as Design 1 has it. A closed one-sided mesh draws its back
+// faces only, and a back face counts only behind the pixel's front surface. A two-sided or open mesh draws both faces,
+// and a fragment at the front's own distance counts: the pixel's own fragment ends its slab with a share of 1.
+#ifndef TERTIUS_BACK_FACE_CARDS_GLSL
+#define TERTIUS_BACK_FACE_CARDS_GLSL
+
+layout(location = 0) out float outDistance;
+
+// The share of the front surface's distance by which a fragment counts as the front's own: a back face must lie behind
+// it by more, and a fragment of a mesh that draws both faces must not lie in front of it by more.
+const float BehindShare = 1e-4;
+
+// Writes the back share of a fragment at camera-relative `position`, or discards it. `backFacesOnly` is
+// GpuInstance.probeBackFacesOnly.
+void writeBackShare(vec3 position, uint backFacesOnly)
+{
+    float back = length(position - draw.eye.xyz);
+    float front = texelFetch(gbufferDistance, ivec2(gl_FragCoord.xy), 0).r;
+    if (front <= 0.0)
+        discard;
+    if (backFacesOnly != 0u)
+    {
+        if (gl_FrontFacing || back <= front * (1.0 + BehindShare))
+            discard;
+        outDistance = front / back;
+        return;
+    }
+    if (back < front * (1.0 - BehindShare))
+        discard;
+    outDistance = back <= front * (1.0 + BehindShare) ? 1.0 : front / back;
+}
+
+#endif
