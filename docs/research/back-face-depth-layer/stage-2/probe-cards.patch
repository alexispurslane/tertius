diff --git a/src/Tertius.Demo/ProbeMeshCensus.cs b/src/Tertius.Demo/ProbeMeshCensus.cs
new file mode 100644
index 000000000..53c58f4c5
--- /dev/null
+++ b/src/Tertius.Demo/ProbeMeshCensus.cs
@@ -0,0 +1,143 @@
+using System.Globalization;
+using System.Numerics;
+using System.Text;
+using Tertius.Host;
+using Tertius.Host.Scripting;
+using Tertius.Physics;
+using Tertius.Rendering;
+using Tertius.Simulation;
+
+namespace Tertius.Demo;
+
+/// <summary>
+/// THROWAWAY (t1-yy2f, never merges): the census of open meshes of part 1. <c>--probe-meshes &lt;scripts folder&gt;
+/// &lt;report&gt;</c> first checks <see cref="MeshClosure"/> on four small meshes. Then it builds the scene of every
+/// script in the folder with no renderer, and lists each drawn entity whose material is one-sided and opaque and whose
+/// mesh is open (<see cref="MeshClosure.IsClosed"/>). Entities that a scene spawns after its build are not counted.
+/// </summary>
+internal static class ProbeMeshCensus
+{
+    public static int Run(string[] args, TextWriter output)
+    {
+        var report = new StringBuilder();
+        CheckClosure(report);
+        var scenes = Directory
+            .GetFiles(args[1], "*.json")
+            .Order(StringComparer.Ordinal)
+            .Select(path => (Script: Path.GetFileNameWithoutExtension(path), Scene: Script.Load(path).Scene))
+            .ToList();
+        foreach (var group in scenes.GroupBy(s => s.Scene).OrderBy(g => g.Key, StringComparer.Ordinal))
+            CensusOf(group.Key, group.Select(s => s.Script).ToList(), report);
+        File.WriteAllText(args[2], report.ToString());
+        output.Write(report.ToString());
+        return 0;
+    }
+
+    /// <summary>The closed-mesh test on a box, a single quad, a box with one face removed, and a UV sphere.</summary>
+    private static void CheckClosure(StringBuilder report)
+    {
+        MeshData box = Primitives.Box(new(1, 2, 3));
+        MeshData quad = Primitives.Plane(1);
+        // The box's first face: its first six indices.
+        MeshData openBox = box with { Indices = box.Indices[6..] };
+        MeshData sphere = Primitives.Sphere(1);
+        foreach (var (name, mesh) in new[] { ("box", box), ("quad", quad), ("box less one face", openBox), ("sphere", sphere) })
+        {
+            var counts = MeshClosure.Count(mesh.Indices, mesh.Vertices.Select(v => v.Position).ToArray());
+            report.Append(
+                CultureInfo.InvariantCulture,
+                $"check {name}: closed {counts.Closed}, vertices {mesh.Vertices.Length}, welded positions {counts.Positions}, triangles {counts.Triangles} of {mesh.Indices.Length / 3}, unpaired edges {counts.Unpaired}, repeated edges {counts.Repeated}\n"
+            );
+        }
+    }
+
+    private static void CensusOf(string sceneName, List<string> scripts, StringBuilder report)
+    {
+        Scene? scene = DemoScenes.All.SingleOrDefault(s => s.Name == sceneName);
+        if (scene is null)
+        {
+            report.Append(CultureInfo.InvariantCulture, $"scene {sceneName} ({string.Join(", ", scripts)}): not found\n");
+            return;
+        }
+        var resources = new RecordingResources();
+        using var world = new World(new() { DisposePhysics = true }, new JoltPhysicsBackend(JoltBackendOptions.Unpaced));
+        SceneInstance instance = scene.Build(world, resources);
+        var entities = new List<Entity>();
+        world.CopyLiveEntities(entities);
+        int drawn = 0,
+            oneSided = 0;
+        var open = new List<string>();
+        var meshesSeen = new HashSet<int>();
+        var openMeshes = new HashSet<int>();
+        foreach (Entity entity in entities)
+        {
+            RenderData render = world.GetRender(entity);
+            if (render.Mesh.IsNone || (render.Flags & RenderFlags.Visible) == 0)
+                continue;
+            drawn++;
+            meshesSeen.Add(render.Mesh.Value);
+            MaterialDesc? material = render.Material.IsNone ? null : resources.Materials[render.Material.Value];
+            bool twoSided = material is { } m && m.Model switch
+            {
+                HairShading => true,
+                StandardShading or SkinShading => false,
+            };
+            string alpha = material is { } a ? a.Alpha switch
+            {
+                OpaqueAlpha => "opaque",
+                CutoutAlpha => "cutout",
+                FringedAlpha => "fringed",
+                GlassAlpha => "glass",
+            } : "opaque";
+            if (twoSided || alpha == "glass")
+                continue;
+            oneSided++;
+            MeshData mesh = resources.Meshes[render.Mesh.Value];
+            var counts = MeshClosure.Count(mesh.Indices, mesh.Vertices.Select(v => v.Position).ToArray());
+            if (counts.Closed && counts.Repeated > 0)
+                open.Add(
+                    string.Create(
+                        CultureInfo.InvariantCulture,
+                        $"  {instance.IdOf(entity)}: mesh {render.Mesh.Value}, {alpha}, closed only by the pairing rule: {counts.Repeated} directed edges of more than one triangle, {counts.Triangles} triangles"
+                    )
+                );
+            if (counts.Closed)
+                continue;
+            openMeshes.Add(render.Mesh.Value);
+            open.Add(
+                string.Create(
+                    CultureInfo.InvariantCulture,
+                    $"  {instance.IdOf(entity)}: mesh {render.Mesh.Value}, {alpha}, {counts.Triangles} triangles, {counts.Unpaired} unpaired and {counts.Repeated} repeated directed edges, radius {render.BoundingRadius:0.###} m"
+                )
+            );
+        }
+        report.Append(
+            CultureInfo.InvariantCulture,
+            $"scene {sceneName} ({string.Join(", ", scripts)}): drawn entities {drawn}, one-sided opaque {oneSided}, of open meshes {openMeshes.Count} distinct meshes of {meshesSeen.Count}\n"
+        );
+        foreach (string line in open.Order(StringComparer.Ordinal))
+            report.Append(line).Append('\n');
+    }
+
+    /// <summary>Resources that keep what a scene creates, by id, and draw nothing.</summary>
+    private sealed class RecordingResources : IRenderResources
+    {
+        public List<MeshData> Meshes { get; } = [];
+        public List<MaterialDesc> Materials { get; } = [];
+        private int textures;
+
+        public MeshId CreateMesh(MeshData mesh)
+        {
+            Meshes.Add(mesh);
+            return new MeshId(Meshes.Count - 1);
+        }
+
+        public TextureId CreateTexture(TextureData texture) => new(textures++);
+
+        public MaterialId CreateMaterial(MaterialDesc material)
+        {
+            Materials.Add(material);
+            return new MaterialId(Materials.Count - 1);
+        }
+    }
+}
