diff --git a/src/Tertius.Rendering/Resources/MeshClosure.cs b/src/Tertius.Rendering/Resources/MeshClosure.cs
new file mode 100644
index 000000000..d72c0dd1a
--- /dev/null
+++ b/src/Tertius.Rendering/Resources/MeshClosure.cs
@@ -0,0 +1,69 @@
+using System.Numerics;
+
+namespace Tertius.Rendering;
+
+/// <summary>
+/// THROWAWAY (t1-yy2f, never merges): whether a mesh is closed, for the back-face pass of the probe. The real test comes
+/// with the build of the back-face depth layer, with tests.
+/// </summary>
+public static class MeshClosure
+{
+    /// <summary>Whether every edge of the mesh belongs to exactly two triangles with opposite winding (see the remarks
+    /// for an edge of more than two).</summary>
+    /// <remarks>
+    /// Two vertices at the same position count as one, because a hard edge splits its vertices. The same position means
+    /// within 2^−20 of the mesh's largest coordinate: the south pole of <see cref="Primitives.Sphere"/> holds positions
+    /// that differ by about 10^−7 of its radius. A triangle with fewer than three distinct positions covers no area and
+    /// does not count. A mesh with no such triangle is open. An edge that 2k triangles share, k in each direction, also
+    /// counts as closed: such a mesh is a union of closed parts that touch along the edge, as the station's spokes.
+    /// </remarks>
+    public static bool IsClosed(ReadOnlySpan<uint> indices, ReadOnlySpan<Vector3> positions) =>
+        Count(indices, positions).Closed;
+
+    /// <summary>The counts behind <see cref="IsClosed"/>: the triangles that count, the welded positions, the
+    /// directed edges that as many opposite edges do not pair, and the directed edges that more than one triangle holds.
+    /// Repeated edges do not make a mesh open.</summary>
+    public static (bool Closed, int Triangles, int Positions, int Unpaired, int Repeated) Count(
+        ReadOnlySpan<uint> indices,
+        ReadOnlySpan<Vector3> positions
+    )
+    {
+        float extent = 0;
+        foreach (Vector3 p in positions)
+            extent = MathF.Max(extent, MathF.Max(MathF.Abs(p.X), MathF.Max(MathF.Abs(p.Y), MathF.Abs(p.Z))));
+        double quantum = extent > 0 ? extent * Math.Pow(2, -20) : 1;
+        var weld = new Dictionary<(long, long, long), int>();
+        var welded = new int[positions.Length];
+        for (int i = 0; i < positions.Length; i++)
+        {
+            Vector3 p = positions[i];
+            var key = ((long)Math.Round(p.X / quantum), (long)Math.Round(p.Y / quantum), (long)Math.Round(p.Z / quantum));
+            if (!weld.TryGetValue(key, out int id))
+                weld[key] = id = weld.Count;
+            welded[i] = id;
+        }
+        var edges = new Dictionary<(int From, int To), int>();
+        int triangles = 0;
+        for (int t = 0; t + 2 < indices.Length; t += 3)
+        {
+            int a = welded[indices[t]],
+                b = welded[indices[t + 1]],
+                c = welded[indices[t + 2]];
+            if (a == b || b == c || a == c)
+                continue;
+            triangles++;
+            foreach ((int From, int To) edge in (ReadOnlySpan<(int, int)>)[(a, b), (b, c), (c, a)])
+                edges[edge] = edges.GetValueOrDefault(edge) + 1;
+        }
+        int unpaired = 0,
+            repeated = 0;
+        foreach (((int from, int to), int count) in edges)
+        {
+            if (count > 1)
+                repeated++;
+            if (edges.GetValueOrDefault((to, from)) != count)
+                unpaired++;
+        }
+        return (triangles > 0 && unpaired == 0, triangles, weld.Count, unpaired, repeated);
+    }
+}
