@@ -0,0 +1,111 @@
+using System.Numerics;
+
+using Tertius.Host;
+using Tertius.Simulation;
+
+namespace Tertius.Demo;
+
+// THROWAWAY (t1-yy2f, never merges): the view of part 2 of the experiment of the borrowed back face.
+public static partial class DemoScenes
+{
+    /// <summary>
+    /// THROWAWAY (t1-yy2f): a curtain of hair cards with a glowing box behind it, over a glossy floor.
+    /// <list type="bullet">
+    /// <item>The curtain, <c>curtain-0</c> and on: the wall of hair of <c>lamp-hall-16-hair</c>, 4 rows of 24 cutout cards,
+    /// facing +Z, with its middle 0.75 m above the floor, so that its lowest cards end 0.24 m above it.</item>
+    /// <item>The <c>glow</c>: a white glowing box 1 m wide and 0.7 m tall, 1.2 m behind the curtain, standing on the
+    /// floor.</item>
+    /// <item>The <c>mirror</c>: a dark glossy plate on the floor, 8 m square and 2 cm thick, of roughness 0.05.</item>
+    /// <item>The view <c>curtain-camera</c> looks at the curtain's lower half from 2.2 m along +Z and 0.55 m up. It sees
+    /// the cards, the glow through their gaps, and the mirror's reflection of both.</item>
+    /// </list>
+    /// </summary>
+    private static SceneInstance CardsGlow(World world, IRenderResources resources)
+    {
+        var scene = new SceneInstance();
+        FrameHandle surface = EarthSurface(
+            world: world,
+            resources: resources,
+            scene: scene,
+            floorHalfExtents: new(10, 0.5f, 10)
+        );
+        ReviewSky(world);
+        world.VerticalFov = 40 * MathF.PI / 180;
+        var mirrorHalf = new Vector3(4, 0.01f, 4);
+        scene.Add(
+            "mirror",
+            world.Spawn(
+                DrawnAt(
+                    frame: surface,
+                    position: new(0, EarthRadius + mirrorHalf.Y, 0),
+                    render: Shaded(
+                        mesh: resources.CreateMesh(Primitives.Box(mirrorHalf)),
+                        material: resources.CreateMaterial(
+                            MaterialDesc.Color(new(x: 0.04f, y: 0.04f, z: 0.045f, w: 1), roughness: 0.05f)
+                        ),
+                        boundingRadius: mirrorHalf.Length()
+                    )
+                )
+            )
+        );
+        double floor = EarthRadius + 2 * mirrorHalf.Y;
+        TextureId strands = resources.CreateTexture(StrandImage());
+        MeshId card = resources.CreateMesh(StrandCard());
+        StrandFan fan = StrandFans.Single(f => f.Alpha is CutoutAlpha);
+        MaterialId[] materials =
+        [
+            .. new[] { DarkBrownHair, LightBrownHair }.Select(color =>
+                resources.CreateMaterial(
+                    new(BaseColor: color, Roughness: 0.35f, BaseColorMap: strands, Model: fan.Model, Alpha: fan.Alpha)
+                )
+            ),
+        ];
+        var middle = new Double3(0, floor + 0.75, 0);
+        for (int row = 0; row < HairWallRows; row++)
+        for (int column = 0; column < HairWallColumns; column++)
+        {
+            int i = row * HairWallColumns + column;
+            double twist = (i % 2 == 0 ? 20 : -20) * Math.PI / 180;
+            var offset = new Double3(
+                (column - (HairWallColumns - 1) / 2.0) * 0.06,
+                (row - (HairWallRows - 1) / 2.0) * StrandCardLength * 0.8,
+                0.01 * (column % 3)
+            );
+            scene.Add(
+                $"curtain-{i}",
+                world.Spawn(
+                    new()
+                    {
+                        Frame = surface,
+                        Pose = new(middle + offset, DQuaternion.FromAxisAngle(Double3.UnitY, twist)),
+                        Render = new RenderData
+                        {
+                            Mesh = card,
+                            Material = materials[i % materials.Length],
+                            BoundingRadius = StrandCardBoundingRadius,
+                            Flags = RenderFlags.Visible | RenderFlags.CastsShadow | RenderFlags.NoImpostor,
+                        },
+                    }
+                )
+            );
+        }
+
+        scene.Add(
+            "glow",
+            world.Spawn(
+                GlowingBox(
+                    surface: surface,
+                    resources: resources,
+                    standsOn: new(0, floor, -1.2),
+                    halfExtents: new(0.5f, 0.35f, 0.05f)
+                )
+            )
+        );
+        Entity camera = world.Spawn(ViewIn(surface, LookingAt(new(0, floor + 0.55, 2.2), new(0, floor + 0.45, 0))));
+        scene.Add("curtain-camera", camera);
+        Star(world: world, scene: scene, frame: surface, center: new(0, EarthRadius, 0), direction: new(0.3, 0.6, 1));
+        scene.AddView("curtain-camera");
+        world.Camera = camera;
+        return scene;
+    }
+}
