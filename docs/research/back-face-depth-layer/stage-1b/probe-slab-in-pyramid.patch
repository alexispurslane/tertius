+float slabBack(float w, float share)
+{
+    // The walk's old constant, so that the 10 % rule rounds as main's walk rounded it: glslc folds it in double.
+    const float backShare = 1.0 / (1.0 + ThicknessShare);
+    if (slabRule == SlabTenPercent)
+        return w * backShare;
+    if (slabRule == SlabTrimmed)
+        return max(w * backShare, w * share);
+    if (share > 0.0)
+        return w * share;
+    if (noBackRule == NoBackTenPercent)
+        return w * backShare;
+    if (noBackRule == NoBackSolid)
+        return 0.0;
+    return w;
+}
