diff -ruN s1/visibility.comp s1-d1/visibility.comp
--- s1/visibility.comp	1969-12-31 19:00:00
+++ s1-d1/visibility.comp	2026-11-23 17:07:42
@@ -0,0 +1,31 @@
+#version 460
+// SCRATCH t0-t2oq, design 1: the visibility pass. One invocation per pixel; layer n of the image holds the visibility of
+// the n-th shadowed light of the main view.
+#extension GL_GOOGLE_include_directive : require
+#define VISIBILITY_FIRST
+#define VISIBILITY_IMAGE
+#define VISIBILITY_COMPUTE
+#include "frame.glsl"
+#include "gbuffer_surface.glsl"
+#include "lighting.glsl"
+
+layout(local_size_x = 8, local_size_y = 8) in;
+layout(set = 3, binding = 1, r8) uniform writeonly image2DArray visibilityOut;
+
+void main()
+{
+    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
+    if (any(greaterThanEqual(pixel, ivec2(frame.viewport.xy))))
+        return;
+    if (texelFetch(gbufferDistance, pixel, 0).r <= 0.0 || texelFetch(gbufferBaseColor, pixel, 0).a == 0.0)
+        return;
+    ShadingInput s = materialAt(pixel);
+    uint n = 0u;
+    for (uint i = 0u; i < frame.counts.x; i++)
+    {
+        if (!viewKeeps(MainView, lights[i]) || lights[i].shadow.x == NoSlot)
+            continue;
+        imageStore(visibilityOut, ivec3(pixel, int(n)), vec4(visibilityOf(lights[i], s.position, s.geometricNormal)));
+        n++;
+    }
+}
