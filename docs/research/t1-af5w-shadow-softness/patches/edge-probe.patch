+        float a = length(light.directionCosOuter.xyz), b = length(light.halfHeight.xyz);
+        vec2 widths = kind == RectKind ? vec2(2.0 * max(a, b), 2.0 * min(a, b))
+            : kind == TubeKind ? vec2(2.0 * (a + r), 2.0 * r) : vec2(2.0 * r);
+        probeEdgeA = vec4(p.d - caster, p.d - nearest, rendered, float(index) + 1.0);
+        probeEdgeB = vec4(lit, caster, widths);
+        return;
+    }
+    uint count = frame.counts.z;
+    if (count == 0u)
+        return;
+    float depth = dot(position, frame.cameraForward.xyz);
+    uint cascade = 0u;
+    while (cascade < count && depth >= frame.shadowSplits[cascade])
+        cascade++;
+    if (cascade == count)
+        return;
