+                RenderScaleController.CostGroup probeGroup = RenderScaleController.CostGroupOf(probePass.Stage);
+                probeReached |= probeGroup == RenderScaleController.CostGroup.Output;
+                if (probeReached)
+                    probeOutput += probePass.Milliseconds;
+                else
+                {
+                    probeBefore += probePass.Milliseconds;
