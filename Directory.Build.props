<Project>
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <!-- C# 15 preview features: union types. -->
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- The compiler checks doc comments only when it writes the XML documentation file. DocFX reads that file too. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591, a public member without a doc comment, stays off until the doc comment rewrite (ter-9yg8). -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!--
      Switches over closed sets (docs/plans/code-quality-tooling.md, decision 14). CS8524 reports an enum switch expression
      that names every member but not unnamed values such as (E)7. Off, so such a switch needs no discard arm, and the
      compiler reports a missing member with CS8509. An unnamed value throws SwitchExpressionException. The build runs the
      IDE analyzers for IDE0010 only. AnalysisModeStyle=None turns off the style rules that latest-recommended turns on,
      and .editorconfig sets every other IDE rule to suggestion, which a build does not report.
    -->
    <NoWarn>$(NoWarn);CS8524</NoWarn>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisModeStyle>None</AnalysisModeStyle>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TieredPGO>true</TieredPGO>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <RootNamespace>$(MSBuildProjectName)</RootNamespace>
    <!-- Checked is Release's optimized code with Debug's contracts, for the test runs (Directory.Build.targets). -->
    <Configurations>Debug;Checked;Release</Configurations>
  </PropertyGroup>
  <!--
    Complexity and length reports. CA1502 (cyclomatic complexity, limit in CodeMetricsConfig.txt) and Meziantou's MA0051
    (method length) report at suggestion level, so they never fail a build. The pre-commit hook prints the ones in the
    methods that a commit changes. MeziantouAnalysisMode=None turns off every Meziantou rule, and .editorconfig turns
    MA0051 back on.
  -->
  <PropertyGroup>
    <MeziantouAnalysisMode>None</MeziantouAnalysisMode>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Meziantou.Analyzer" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)analyzers/CodeMetricsConfig.txt" />
  </ItemGroup>
  <!-- The union generator writes the members of every [GeneratedUnion] struct (docs/plans/union-tooling.md). -->
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'Tertius.Unions'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)analyzers/Tertius.Unions/Tertius.Unions.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
