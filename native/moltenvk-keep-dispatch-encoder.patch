+#include <cstdlib>
+#include <cstring>
 #include "MVKCommandBuffer.h"
 #include "MVKFramebuffer.h"
 #include "MVKCommandPool.h"
@@ -718,6 +720,51 @@
 
 		fenceSlots.wait[i][i] = fenceSlots.update[i];
 		mvkEnableFlags(fenceSlots.updateDirtyBits, 1 << i);
+	}
+}
+
+// Tertius: whether the environment asks for the stock behavior, in which every pipeline barrier ends the encoder.
+static bool tertiusStockBarriers() {
+	static const bool stock = [] {
+		const char* value = getenv("TERTIUS_MOLTENVK_STOCK_BARRIERS");
+		return value && value[0] && strcmp(value, "0") != 0;
+	}();
+	return stock;
+}
+
+bool MVKCommandEncoder::canKeepDispatchEncoderAtBarrier() {
+	return !tertiusStockBarriers()
+		&& _mtlComputeEncoder
+		&& _mtlComputeEncoderUse == kMVKCommandUseDispatch
+		&& _mtlComputeEncoderStages == (1u << kMVKBarrierStageCompute)
+		&& _timestampStageCounterQueries.empty();
+}
+
+// Tertius: a serial compute encoder runs its dispatches in their order, so a barrier between two of its dispatches
+// needs no new encoder. The open encoder holds compute work alone (canKeepDispatchEncoderAtBarrier). Three rules keep
+// the order that the barrier asks for:
+// 1. The open encoder waits for the latest fence of each source stage. Metal can apply such a wait at the start of the
+//    encoder, which orders the dispatches before the barrier too, and that is harmless.
+// 2. The open encoder holds compute work from before the barrier, and it updates its compute fence only when it ends.
+//    So each destination stage waits for that fence: a later encoder then runs after the whole open encoder.
+// 3. For every other source stage, the destination stages wait for the stage's latest fence, as setBarrier does.
+void MVKCommandEncoder::setBarrierInDispatchEncoder(uint64_t sourceStageMask, uint64_t destStageMask) {
+	auto &fenceSlots = _pEncodingContext->fenceSlots;
+	for (int i = 0; i < kMVKBarrierStageCount; ++i) {
+		if (!mvkIsAnyFlagEnabled(sourceStageMask, 1ull << i)) continue;
+
+		[_mtlComputeEncoder waitForFence: _device->getFence((MVKBarrierStage)i, fenceSlots.update[i])];
+		if (i == kMVKBarrierStageCompute) {
+			// Settles the fence that the open encoder updates when it ends: fenceSlots.update holds it from here on.
+			getBarrierStageFence(kMVKBarrierStageCompute);
+		}
+		for (int j = 0; j < kMVKBarrierStageCount; ++j) {
+			if (!mvkIsAnyFlagEnabled(destStageMask, 1ull << j)) continue;
+
+			fenceSlots.wait[j][i] = fenceSlots.update[i];
+		}
+		fenceSlots.wait[i][i] = fenceSlots.update[i];
+		if (i != kMVKBarrierStageCompute) { mvkEnableFlags(fenceSlots.updateDirtyBits, 1 << i); }
 	}
 }
 
