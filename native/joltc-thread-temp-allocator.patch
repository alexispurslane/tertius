@@ -675,7 +675,18 @@
 
 // 10 MB was not enough for large simulation, let's use TempAllocatorMalloc
 static bool s_initialized = false;
-static TempAllocator* s_TempAllocator = nullptr;
+// Tertius patch: one temp allocator per calling thread instead of one per process, so that two physics systems can
+// step at the same time on different threads. Jolt frees the temp allocations of an update or a character move
+// before the call returns, and its jobs use the allocator that the calling thread passed in.
+static TempAllocator* ThreadTempAllocator()
+{
+#if defined(__SANITIZE_THREAD__) || defined(ENABLE_SANITIZER)
+	thread_local TempAllocatorMalloc allocator;
+#else
+	thread_local TempAllocatorImplWithMallocFallback allocator(8 * 1024 * 1024);
+#endif
+	return &allocator;
+}
 
